ch.FacetUtil.changeSelection(event);''\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009type="checkbox"\u000a\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009<span class="custom-control-label term-name ${(customRangeBucketDisplayContext.isSelected())?then(''facet-term-selected'', ''facet-term-unselected'')}">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span class="custom-control-label-text">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if customRangeBucketDisplayContext.isSelected()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<strong><@liferay_ui["message"] key="${htmlUtil.escape(customRangeBucketDisplayContext.getBucketText())}" /></strong>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#else>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_ui["message"] key="${htmlUtil.escape(customRangeBucketDisplayContext.getBucketText())}" />\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009<#if customRangeBucketDisplayContext.isSelected()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<small class="term-count">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009(${customRangeBucketDisplayContext.getFrequency()})\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</small>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u0009\u0009\u0009\u0009\u0009</label>\u000a\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009</li>\u000a\u000a\u0009\u0009\u0009<div class="${(!dateFacetCalendarDisplayContext.isSelected())?then("hide", "")} date-custom-range" id="${namespace}customRange">\u000a\u0009\u0009\u0009\u0009<div class="col-md-6" id="${namespace}customRangeFrom">\u000a\u0009\u0009\u0009\u0009\u0009<@liferay_aui["field-wrapper"] label="from">\u000a\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_ui["input-date"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009cssClass="date-facet-custom-range-input-date-from"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009dayParam="fromDay"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009dayValue=dateFacetCalendarDisplayContext.getFromDayValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009disabled=false\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009firstDayOfWeek=dateFacetCalendarDisplayContext.getFromFirstDayOfWeek()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009monthParam="fromMonth"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009monthValue=dateFacetCalendarDisplayContext.getFromMonthValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="fromInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009yearParam="fromYear"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009yearValue=dateFacetCalendarDisplayContext.getFromYearValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009\u0009</@>\u000a\u0009\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u0009<div class="col-md-6" id="${namespace}customRangeTo">\u000a\u0009\u0009\u0009\u0009\u0009<@liferay_aui["field-wrapper"] label="to">\u000a\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_ui["input-date"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009cssClass="date-facet-custom-range-input-date-to"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009dayParam="toDay"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009dayValue=dateFacetCalendarDisplayContext.getToDayValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009disabled=false\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009firstDayOfWeek=dateFacetCalendarDisplayContext.getToFirstDayOfWeek()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009monthParam="toMonth"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009monthValue=dateFacetCalendarDisplayContext.getToMonthValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="toInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009yearParam="toYear"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009yearValue=dateFacetCalendarDisplayContext.getToYearValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009\u0009</@>\u000a\u0009\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u0009<@clay["button"]\u000a\u0009\u0009\u0009\u0009\u0009cssClass="date-facet-custom-range-filter-button"\u000a\u0009\u0009\u0009\u0009\u0009disabled=dateFacetCalendarDisplayContext.isRangeBackwards()\u000a\u0009\u0009\u0009\u0009\u0009displayType="secondary"\u000a\u0009\u0009\u0009\u0009\u0009id="${namespace + ''searchCustomRangeButton''}"\u000a\u0009\u0009\u0009\u0009\u0009label="search"\u000a\u0009\u0009\u0009\u0009\u0009name="${namespace + ''searchCustomRangeButton''}"\u000a\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009</div>\u000a\u0009\u0009</ul>\u000a\u0009</@>\u000a</@>',0,20095,NULL,'2024-05-13 14:37:48.972000')
INSERT INTO DDMTEMPLATEVERSION VALUES(0,0,43535,20119,16796623585306,20095,NULL,'2024-05-13 14:37:48.977000',31642,0,31649,'1.1','<?xml version=''1.0'' encoding=''UTF-8''?><root available-locales="en_US,sv_SE,pt_BR,ja_JP,fr_FR,hu_HU,de_DE,ca_ES,ar_SA,fi_FI,zh_CN,es_ES,nl_NL" default-locale="en_US"><Name language-id="en_US">Radio Button Layout (Single Select)</Name><Name language-id="ar_SA">\u062a\u062e\u0637\u064a\u0637 \u0632\u0631 \u062a\u0628\u0627\u062f\u0644\u064a (\u062a\u062d\u062f\u064a\u062f \u0641\u0631\u062f\u064a)</Name><Name language-id="ca_ES">Disposici\u00f3 del bot\u00f3 de r\u00e0dio (selecci\u00f3 \u00fanica)</Name><Name language-id="zh_CN">\u5355\u9009\u6309\u94ae\u5e03\u5c40\uff08\u5355\u9009\uff09</Name><Name language-id="nl_NL">Lay-out keuzerondjes (enkelvoudige selectie)</Name><Name language-id="fi_FI">Valintanapin asettelu (yksitt\u00e4inen valinta)</Name><Name language-id="fr_FR">Disposition des boutons radio (s\u00e9lection unique)</Name><Name language-id="de_DE">Optionsfeldlayout (Einzelauswahl)</Name><Name language-id="hu_HU">R\u00e1di\u00f3gombok elrendez\u00e9se (egyv\u00e1laszt\u00f3s)</Name><Name language-id="ja_JP">\u30e9\u30b8\u30aa\u30dc\u30bf\u30f3\u306e\u30ec\u30a4\u30a2\u30a6\u30c8 (\u5358\u4e00\u9078\u629e)</Name><Name language-id="pt_BR">Layout do bot\u00e3o de r\u00e1dio (Sele\u00e7\u00e3o \u00fanica)</Name><Name language-id="es_ES">Dise\u00f1o del bot\u00f3n de radio (selecci\u00f3n \u00fanica)</Name><Name language-id="sv_SE">Layout f\u00f6r radioknapp (ett val)</Name></root>','<?xml version=''1.0'' encoding=''UTF-8''?><root available-locales="en_US,sv_SE,pt_BR,ja_JP,fr_FR,hu_HU,de_DE,ca_ES,ar_SA,fi_FI,zh_CN,es_ES,nl_NL" default-locale="en_US"><Description language-id="en_US">Display terms with radio buttons.</Description><Description language-id="ar_SA">\u0639\u0631\u0636 \u0627\u0644\u0645\u0635\u0637\u0644\u062d\u0627\u062a \u0628\u0623\u0632\u0631\u0627\u0631 \u0627\u062e\u062a\u064a\u0627\u0631.</Description><Descriptio