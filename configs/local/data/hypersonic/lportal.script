INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2215,16796623585306,1712,45066,NULL,'en_US','<ul data-sourcepos="21:1-28:0">\u000a\u0009<li data-sourcepos="21:1-21:83">Bachelor''s degree in Optical Engineering, Physics, or a related field (required).</li>\u000a\u0009<li data-sourcepos="22:1-22:145">2-4 years of experience in applied optics or a related field, with demonstrable experience using optical design software (e.g., Zemax, Code V).</li>\u000a\u0009<li data-sourcepos="23:1-23:154">Strong understanding of optical design principles and theories (e.g., geometrical optics, physical optics) and their application to real-world problems.</li>\u000a\u0009<li data-sourcepos="24:1-24:99">Proven ability to analyze data, identify trends, and translate findings into actionable insights.</li>\u000a\u0009<li data-sourcepos="25:1-25:169">Excellent communication, collaboration, and interpersonal skills, with the ability to work effectively in a team environment and present technical information clearly.</li>\u000a\u0009<li data-sourcepos="26:1-26:79">A meticulous eye for detail and a commitment to delivering high-quality work.</li>\u000a\u0009<li data-sourcepos="27:1-28:0">A passion for learning and a desire to continuously develop your skills within the field of optical engineering.</li>\u000a</ul>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2216,16796623585306,1713,45079,'availableLanguageIds',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2217,16796623585306,1713,45079,'defaultLanguageId',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2218,16796623585306,1714,45079,NULL,'en_US','<p><strong>See the world of web development in focus!</strong> Clarity, a leading global manufacturer of innovative eyewear, seeks a talented Associate Web Developer to join our growing team. In this exciting role, you''ll gain valuable experience working alongside industry professionals, contributing to the development and maintenance of our web properties. You''ll help us craft user-friendly and visually appealing web experiences that showcase our brand and connect with our customers.</p>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2219,16796623585306,1715,45079,NULL,'en_US','<ul data-sourcepos="11:1-19:0">\u000a\u0009<li data-sourcepos="11:1-11:126">Collaborate with designers and web developers to translate design concepts into functional and visually appealing web pages.</li>\u000a\u0009<li data-sourcepos="12:1-12:145">Develop and implement well-structured, maintainable, and efficient code using front-end web development technologies (HTML5, CSS3, JavaScript).</li>\u000a\u0009<li data-sourcepos="13:1-13:131">Contribute to the development and maintenance of reusable UI components for a consistent brand identity across our web platforms.</li>\u000a\u0009<li data-sourcepos="14:1-14:113">Assist with website optimization for speed and responsiveness across various devices (desktop, mobile, tablet).</li>\u000a\u0009<li data-sourcepos="15:1-15:121">Conduct thorough testing and debugging to ensure website functionality and identify and resolve basic technical issues.</li>\u000a\u0009<li data-sourcepos="16:1-16:136">Stay up-to-date on the latest web development trends and technologies, actively seeking opportunities to learn and grow your skillset.</li>\u000a\u0009<li data-sourcepos="17:1-17:98">Maintain clear and concise code documentation to ensure smooth collaboration and future updates.</li>\u000a\u0009<li data-sourcepos="18:1-19:0">Assist with content management tasks to keep website content fresh and engaging.</li>\u000a</ul>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2220,16796623585306,1716,45079,NULL,'en_US','<ul data-sourcepos="22:1-30:0">\u000a\u0009<li data-sourcepos="22:1-22:96">Bachelor''s degree in Computer Science, Information Technology, or a related field (preferred).</li>\u000a\u0009<li data-sourcepos="23:1-23:90">1-2 years of experience in web development or a strong portfolio showcasing your skills.</li>\u000a\u0009<li data-sourcepos="24:1-24:68">Solid understanding of HTML5, CSS3, and basic JavaScript concepts.</li>\u000a\u0009<li data-sourcepos="25:1-25:88">Experience with a front-end web development framework (e.g., React, Angular) (a plus).</li>\u000a\u0009<li data-sourcepos="26:1-26:86">A strong eye for design and a keen understanding of user experience (UX) principles.</li>\u000a\u0009<li data-sourcepos="27:1-27:106">Excellent communication and collaboration skills, with the ability to learn from experienced developers.</li>\u000a\u0009<li data-sourcepos="28:1-28:71">A problem-solving mindset and a willingness to tackle new challenges.</li>\u000a\u0009<li data-sourcepos="29:1-30:0">A passion for learning and a desire to grow your web development skills.</li>\u000a</ul>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2221,16796623585306,1717,45092,'availableLanguageIds',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2222,16796623585306,1717,45092,'defaultLanguageId',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2223,16796623585306,1718,45092,NULL,'en_US','<p><strong>See quality through every lens!</strong> Clarity, a leading global manufacturer of innovative eyewear, seeks a detail-oriented Associate of Product Quality to join our growing team. In this vital role, you''ll play a key role in ensuring the quality and consistency of our eyewear products, from raw materials to finished goods. You''ll conduct inspections, analyze data, and collaborate with colleagues to maintain Clarity''s reputation for exceptional craftsmanship.</p>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2224,16796623585306,1719,45092,NULL,'en_US','<ul data-sourcepos="11:1-20:0">\u000a\u0009<li data-sourcepos="11:1-11:124">Conduct visual inspections of eyewear components and finished products according to established quality control standards.</li>\u000a\u0009<li data-sourcepos="12:1-12:85">Utilize measuring tools and gauges to verify product dimensions and specifications.</li>\u000a\u0009<li data-sourcepos="13:1-13:94">Perform basic quality control tests to identify and document any defects or inconsistencies.</li>\u000a\u0009<li data-sourcepos="14:1-14:83">Analyze inspection data and identify trends to pinpoint potential quality issues.</li>\u000a\u0009<li data-sourcepos="15:1-15:114">Participate in root cause analysis to determine the source of quality problems and recommend corrective actions.</li>\u000a\u0009<li data-sourcepos="16:1-16:68">Assist with maintaining and calibrating quality control equipment.</li>\u000a\u0009<li data-sourcepos="17:1-17:65">Maintain accurate and up-to-date quality control documentation.</li>\u000a\u0009<li data-sourcepos="18:1-18:110">Collaborate with production teams to ensure adherence to quality standards and implement corrective actions.</li>\u000a\u0009<li data-sourcepos="19:1-20:0">Stay up-to-date on quality control procedures and industry best practices.</li>\u000a</ul>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2225,16796623585306,1720,45092,NULL,'en_US','<ul data-sourcepos="23:1-31:0">\u000a\u0009<li data-sourcepos="23:1-23:48">High school diploma or equivalent (preferred).</li>\u000a\u0009<li data-sourcepos="24:1-24:69">A strong attention to detail and a commitment to quality assurance.</li>\u000a\u0009<li data-sourcepos="25:1-25:79">Basic understanding of quality control principles and methodologies (a plus).</li>\u000a\u0009<li data-sourcepos="26:1-26:79">Ability to work independently and as part of a team to achieve quality goals.</li>\u000a\u0009<li data-sourcepos="27:1-27:134">Excellent communication and interpersonal skills, with the ability to effectively document findings and collaborate with colleagues.</li>\u000a\u0009<li data-sourcepos="28:1-28:45">Proficient in basic math and data analysis.</li>\u000a\u0009<li data-sourcepos="29:1-29:86">Ability to follow instructions and adhere to established quality control procedures.</li>\u000a\u0009<li data-sourcepos="30:1-31:0">A strong work ethic and a commitment to continuous improvement.</li>\u000a</ul>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2226,16796623585306,1721,45105,'availableLanguageIds',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2227,16796623585306,1721,45105,'defaultLanguageId',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2228,16796623585306,1722,45105,NULL,'en_US','<p><strong>Shape the future of vision technology!</strong> Clarity, a leading global innovator in the eyewear industry, seeks a visionary and strategic Director of Technology to lead our growing tech team. In this dynamic role, you''ll be responsible for driving innovation across all aspects of our technology landscape, from information systems and data analytics to e-commerce platforms and automation solutions. You''ll be a champion for technological advancement, ensuring Clarity remains at the forefront of the industry and delivers exceptional experiences for our customers and partners.</p>\u000a\u000a<p><button _ngcontent-ng-c19849592="" aria-label="Modify selected text" data-test-id="tunable-modify-selection-button" jslog="198403;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_29efed76cf1e2c51&quot;,&quot;c_e82403b70e939350&quot;,null,&quot;rc_cc3669c4a7868b4a&quot;,null,null,&quot;en&quot;,null,1,null,null,1,0]];mutable:true" mat-mini-fab="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mattooltip="Modify selected text">pen_spark</button></p>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2229,16796623585306,1723,45105,NULL,'en_US','<ul data-sourcepos="11:1-21:0">\u000a\u0009<li data-sourcepos="11:1-11:119">Develop and execute a comprehensive technology vision and roadmap aligned with Clarity''s overall business objectives.</li>\u000a\u0009<li data-sourcepos="12:1-12:132">Lead and mentor a talented team of IT professionals, fostering a culture of innovation, collaboration, and continuous improvement.</li>\u000a\u0009<li data-sourcepos="13:1-13:109">Oversee all aspects of IT infrastructure and operations, ensuring system uptime, security, and scalability.</li>\u000a\u0009<li data-sourcepos="14:1-14:164">Champion the adoption of emerging technologies (e.g., AI, cloud computing, AR/VR) to enhance product development, customer experience, and operational efficiency.</li>\u000a\u0009<li data-sourcepos="15:1-15:99">Manage IT budgets and resources effectively, prioritizing investments that drive strategic goals.</li>\u000a\u0009<li data-sourcepos="16:1-16:157">Partner with cross-functional teams (e.g., marketing, R&amp;D, sales) to understand business needs and translate them into innovative technology solutions.</li>\u000a\u0009<li data-sourcepos="17:1-17:115">Develop and implement a robust data analytics strategy to gain insights from customer behavior and market trends.</li>\u000a\u0009<li data-sourcepos="18:1-18:115">Lead the development and execution of a comprehensive IT security strategy to safeguard company data and systems.</li>\u000a\u0009<li data-sourcepos="19:1-19:109">Stay abreast of the latest technological advancements and identify opportunities for competitive advantage.</li>\u000a\u0009<li data-sourcepos="20:1-21:0">Represent the IT department at leadership meetings and effectively communicate technology strategies to stakeholders.</li>\u000a</ul>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2230,16796623585306,1724,45105,NULL,'en_US','<ul data-sourcepos="24:1-33:0">\u000a\u0009<li data-sourcepos="24:1-24:94">Master''s degree in Computer Science, Information Technology, or a related field (preferred).</li>\u000a\u0009<li data-sourcepos="25:1-25:88">Minimum 10-15 years of experience in a leadership role within the technology industry.</li>\u000a\u0009<li data-sourcepos="26:1-26:97">Proven track record of success in developing and implementing strategic technology initiatives.</li>\u000a\u0009<li data-sourcepos="27:1-27:85">Strong understanding of IT infrastructure, operations, and security best practices.</li>\u000a\u0009<li data-sourcepos="28:1-28:84">Experience with emerging technologies (e.g., AI, cloud computing, AR/VR) (a plus).</li>\u000a\u0009<li data-sourcepos="29:1-29:111">Excellent communication, collaboration, and interpersonal skills with the ability to lead and inspire a team.</li>\u000a\u0009<li data-sourcepos="30:1-30:94">Strong analytical and problem-solving skills with a data-driven approach to decision making.</li>\u000a\u0009<li data-sourcepos="31:1-31:99">Ability to think strategically and translate business needs into actionable technology solutions.</li>\u000a\u0009<li data-sourcepos="32:1-33:0">A visionary leader with a passion for innovation and a commitment to continuous improvement.</li>\u000a</ul>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2231,16796623585306,1725,45118,'availableLanguageIds',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2232,16796623585306,1725,45118,'defaultLanguageId',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2233,16796623585306,1726,45118,NULL,'en_US','<p><strong>See the connections that keep Clarity clear!</strong> Clarity, a leading global manufacturer of innovative eyewear, seeks a skilled Network Engineer to join our dynamic IT team. In this critical role, you''ll play a vital role in ensuring the stability, security, and performance of our global network infrastructure. You''ll be responsible for designing, implementing, maintaining, and troubleshooting our network systems, ensuring seamless communication and data flow across all our locations.</p>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2234,16796623585306,1727,45118,NULL,'en_US','<ul data-sourcepos="11:1-19:0">\u000a\u0009<li data-sourcepos="11:1-11:136">Design, configure, and manage our internal network infrastructure, including routers, switches, firewalls, and wireless access points.</li>\u000a\u0009<li data-sourcepos="12:1-12:91">Implement and maintain network security measures to safeguard company data and resources.</li>\u000a\u0009<li data-sourcepos="13:1-13:104">Monitor network performance, identify potential issues, and troubleshoot network problems proactively.</li>\u000a\u0009<li data-sourcepos="14:1-14:102">Perform network capacity planning and implement upgrades as needed to meet growing business demands.</li>\u000a\u0009<li data-sourcepos="15:1-15:94">Document network configurations and procedures for clear communication and future reference.</li>\u000a\u0009<li data-sourcepos="16:1-16:110">Collaborate with other IT professionals to ensure network integration with various applications and systems.</li>\u000a\u0009<li data-sourcepos="17:1-17:75">Stay up-to-date on the latest networking technologies and best practices.</li>\u000a\u0009<li data-sourcepos="18:1-19:0">Assist with the implementation and management of new network technologies.</li>\u000a</ul>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2235,16796623585306,1728,45118,NULL,'en_US','<ul data-sourcepos="22:1-30:0">\u000a\u0009<li data-sourcepos="22:1-22:96">Bachelor''s degree in Computer Science, Information Technology, or a related field (preferred).</li>\u000a\u0009<li data-sourcepos="23:1-23:75">Minimum 3-5 years of experience in network engineering or a related role.</li>\u000a\u0009<li data-sourcepos="24:1-24:115">Strong understanding of networking concepts, protocols, and technologies (TCP/IP, routing, switching, firewalls).</li>\u000a\u0009<li data-sourcepos="25:1-25:91">Proven experience with network configuration and management tools (e.g., Cisco, Juniper).</li>\u000a\u0009<li data-sourcepos="26:1-26:107">Excellent problem-solving and analytical skills, with the ability to troubleshoot complex network issues.</li>\u000a\u0009<li data-sourcepos="27:1-27:98">Strong communication and collaboration skills, with the ability to work effectively with a team.</li>\u000a\u0009<li data-sourcepos="28:1-28:98">A meticulous attention to detail and a commitment to maintaining accurate network documentation.</li>\u000a\u0009<li data-sourcepos="29:1-30:0">A proactive and results-oriented individual with a strong work ethic.</li>\u000a</ul>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2236,16796623585306,1729,45131,'availableLanguageIds',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2237,16796623585306,1729,45131,'defaultLanguageId',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2238,16796623585306,1730,45131,NULL,'en_US','<p><strong>Help people see the world clearly and stylishly!</strong> Clarity, a leading global manufacturer of innovative eyewear, seeks a passionate Retail Associate to join our dynamic team. In this customer-facing role, you''ll play a vital role in creating a welcoming and informative shopping experience for our customers. You''ll share your knowledge of eyewear, assist with product selection, and help people find the perfect pair of glasses to express their unique style and enhance their vision.</p>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2239,16796623585306,1731,45131,NULL,'en_US','<ul data-sourcepos="11:1-20:0">\u000a\u0009<li data-sourcepos="11:1-11:100">Welcome customers to the store, greet them with a smile, and provide exceptional customer service.</li>\u000a\u0009<li data-sourcepos="12:1-12:141">Assist customers in browsing the selection of eyewear, offering product knowledge and recommendations based on their needs and preferences.</li>\u000a\u0009<li data-sourcepos="13:1-13:73">Measure and fit glasses for customers, ensuring proper fit and comfort.</li>\u000a\u0009<li data-sourcepos="14:1-14:100">Process customer purchases efficiently and accurately, handling cash and credit card transactions.</li>\u000a\u0009<li data-sourcepos="15:1-15:114">Maintain a clean, organized, and visually appealing store environment, ensuring products are properly displayed.</li>\u000a\u0009<li data-sourcepos="16:1-16:73">Assist with restocking inventory and keeping the sales floor organized.</li>\u000a\u0009<li data-sourcepos="17:1-17:66">Stay up-to-date on current eyewear trends and product offerings.</li>\u000a\u0009<li data-sourcepos="18:1-18:59">Promote special offers and loyalty programs to customers.</li>\u000a\u0009<li data-sourcepos="19:1-20:0">Uphold company policies and procedures, ensuring a safe and secure shopping environment.</li>\u000a</ul>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2240,16796623585306,1732,45131,NULL,'en_US','<ul data-sourcepos="23:1-31:0">\u000a\u0009<li data-sourcepos="23:1-23:48">High school diploma or equivalent (preferred).</li>\u000a\u0009<li data-sourcepos="24:1-24:87">A passion for the eyewear industry and a genuine interest in helping people (a plus).</li>\u000a\u0009<li data-sourcepos="25:1-25:101">Excellent communication and interpersonal skills, with the ability to build rapport with customers.</li>\u000a\u0009<li data-sourcepos="26:1-26:90">Strong customer service orientation and a commitment to exceeding customer expectations.</li>\u000a\u0009<li data-sourcepos="27:1-27:76">A positive and enthusiastic attitude with a willingness to learn and grow.</li>\u000a\u0009<li data-sourcepos="28:1-28:89">Ability to work independently and as part of a team in a fast-paced retail environment.</li>\u000a\u0009<li data-sourcepos="29:1-29:70">Basic computer literacy and proficiency in cash handling procedures.</li>\u000a\u0009<li data-sourcepos="30:1-31:0">Strong attention to detail and a commitment to maintaining a clean and organized work environment.</li>\u000a</ul>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2241,16796623585306,1733,45144,'availableLanguageIds',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2242,16796623585306,1733,45144,'defaultLanguageId',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2243,16796623585306,1734,45144,NULL,'en_US','<p><strong>See the future of eyewear through code!</strong> Clarity, a leading global manufacturer of innovative eyewear, seeks a passionate Senior Web Developer to join our dynamic team. In this key role, you''ll play a vital role in crafting exceptional user experiences across our web platforms, from our e-commerce store to our brand storytelling website. You''ll leverage your web development expertise to build, maintain, and enhance our digital presence, ensuring a seamless and visually appealing experience for our customers.</p>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2244,16796623585306,1735,45144,NULL,'en_US','<ul data-sourcepos="11:1-20:0">\u000a\u0009<li data-sourcepos="11:1-11:146">Collaborate with designers, product managers, and marketing teams to translate concepts into user-friendly and visually stunning web interfaces.</li>\u000a\u0009<li data-sourcepos="12:1-12:160">Develop and implement clean, maintainable, and efficient code using industry-standard web development technologies (e.g., HTML5, CSS3, JavaScript frameworks).</li>\u000a\u0009<li data-sourcepos="13:1-13:93">Build reusable UI components and ensure consistent brand identity across all web platforms.</li>\u000a\u0009<li data-sourcepos="14:1-14:109">Optimize website performance for speed and responsiveness across various devices (desktop, mobile, tablet).</li>\u000a\u0009<li data-sourcepos="15:1-15:66">Implement best practices for website security and accessibility.</li>\u000a\u0009<li data-sourcepos="16:1-16:81">Utilize content management systems (CMS) to manage website content efficiently.</li>\u000a\u0009<li data-sourcepos="17:1-17:115">Conduct thorough testing and debugging to ensure website functionality and identify and resolve technical issues.</li>\u000a\u0009<li data-sourcepos="18:1-18:137">Stay up-to-date on the latest web development trends and technologies, and continuously seek opportunities to improve our web presence.</li>\u000a\u0009<li data-sourcepos="19:1-20:0">Document code effectively to ensure clear communication and maintainability.</li>\u000a</ul>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2245,16796623585306,1736,45144,NULL,'en_US','<ul data-sourcepos="23:1-32:0">\u000a\u0009<li data-sourcepos="23:1-23:96">Bachelor''s degree in Computer Science, Information Technology, or a related field (preferred).</li>\u000a\u0009<li data-sourcepos="24:1-24:97">Minimum 5+ years of experience as a web developer with a strong portfolio showcasing your work.</li>\u000a\u0009<li data-sourcepos="25:1-25:114">Proven experience with front-end and back-end web development technologies (HTML5, CSS3, JavaScript frameworks).</li>\u000a\u0009<li data-sourcepos="26:1-26:60">Experience with content management systems (CMS) (a plus).</li>\u000a\u0009<li data-sourcepos="27:1-27:91">Excellent understanding of web design principles and user experience (UX) best practices.</li>\u000a\u0009<li data-sourcepos="28:1-28:109">Strong problem-solving and analytical skills with the ability to identify and resolve technical challenges.</li>\u000a\u0009<li data-sourcepos="29:1-29:117">Excellent communication and collaboration skills, with the ability to work effectively with cross-functional teams.</li>\u000a\u0009<li data-sourcepos="30:1-30:78">A passion for building user-friendly and visually appealing web experiences.</li>\u000a\u0009<li data-sourcepos="31:1-32:0">A commitment to continuous learning and staying current with the latest web development trends.</li>\u000a</ul>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2246,16796623585306,1737,45157,'availableLanguageIds',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2247,16796623585306,1737,45157,'defaultLanguageId',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2248,16796623585306,1738,45157,NULL,'en_US','<p><strong>See the big picture of financial clarity!</strong> Clarity, a leading global manufacturer of innovative eyewear, seeks a visionary and strategic VP of Finance to lead our dynamic finance team. In this pivotal role, you''ll be responsible for overseeing all aspects of our financial operations, from financial planning and analysis to risk management and investor relations. You''ll be a key member of the leadership team, partnering with executives to drive strategic decision-making, ensure financial stability, and propel Clarity''s continued growth.</p>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2249,16796623585306,1739,45157,NULL,'en_US','<ul data-sourcepos="11:1-20:0">\u000a\u0009<li data-sourcepos="11:1-11:120">Lead and direct the entire finance team, fostering a culture of excellence, collaboration, and continuous improvement.</li>\u000a\u0009<li data-sourcepos="12:1-12:125">Develop and implement comprehensive financial strategies and policies aligned with Clarity''s long-term business objectives.</li>\u000a\u0009<li data-sourcepos="13:1-13:111">Oversee the financial planning and analysis process, including forecasting, budgeting, and variance analysis.</li>\u000a\u0009<li data-sourcepos="14:1-14:119">Manage all aspects of financial reporting, ensuring accuracy, transparency, and compliance with accounting standards.</li>\u000a\u0009<li data-sourcepos="15:1-15:110">Lead the development and implementation of effective risk management strategies to mitigate financial risks.</li>\u000a\u0009<li data-sourcepos="16:1-16:109">Build and maintain strong relationships with financial institutions and secure optimal financing solutions.</li>\u000a\u0009<li data-sourcepos="17:1-17:108">Manage investor relations, providing clear and concise financial information to analysts and shareholders.</li>\u000a\u0009<li data-sourcepos="18:1-18:171">Collaborate with cross-functional teams (e.g., R&amp;D, sales &amp; marketing, operations) to ensure financial considerations are integrated into all business decisions.</li>\u000a\u0009<li data-sourcepos="19:1-20:0">Stay up-to-date on industry trends and economic developments, identifying potential opportunities and challenges.\u000a\u0009<p><button _ngcontent-ng-c19849592="" aria-label="Modify selected text" data-test-id="tunable-modify-selection-button" jslog="198403;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_0b174020257f5787&quot;,&quot;c_e82403b70e939350&quot;,null,&quot;rc_3a725d0e3d9742d1&quot;,null,null,&quot;en&quot;,null,1,null,null,1,0]];mutable:true" mat-mini-fab="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-uninitialized="" mattooltip="Modify selected text">pen_spark</button></p>\u000a\u0009</li>\u000a</ul>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2250,16796623585306,1740,45157,NULL,'en_US','<ul data-sourcepos="23:1-32:0">\u000a\u0009<li data-sourcepos="23:1-23:92">Master''s degree in Business Administration (MBA), Finance, or a related field (preferred).</li>\u000a\u0009<li data-sourcepos="24:1-24:54">CPA or equivalent professional designation (a plus).</li>\u000a\u0009<li data-sourcepos="25:1-25:126">Minimum 10-15 years of experience in a senior financial leadership role within a global manufacturing or retail environment.</li>\u000a\u0009<li data-sourcepos="26:1-26:96">Proven track record of success in developing and implementing strategic financial initiatives.</li>\u000a\u0009<li data-sourcepos="27:1-27:74">Strong analytical and problem-solving skills with a keen eye for detail.</li>\u000a\u0009<li data-sourcepos="28:1-28:116">Excellent communication, presentation, and interpersonal skills, with the ability to influence and inspire a team.</li>\u000a\u0009<li data-sourcepos="29:1-29:120">Demonstrated leadership qualities and the ability to build strong relationships across all levels of the organization.</li>\u000a\u0009<li data-sourcepos="30:1-30:108">In-depth knowledge of financial accounting principles, tax regulations, and financial reporting standards.</li>\u000a\u0009<li data-sourcepos="31:1-32:0">A strategic mindset with a focus on long-term business growth and profitability.</li>\u000a</ul>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2251,16796623585306,1741,45170,'availableLanguageIds',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2252,16796623585306,1741,45170,'defaultLanguageId',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2253,16796623585306,1742,45170,NULL,'en_US','<p><strong>See your contribution in every shipment!</strong> Clarity, a leading global manufacturer of innovative eyewear, seeks a passionate Warehouse Associate to join our dynamic team. In this fast-paced role, you''ll play a vital role in keeping our warehouse running smoothly, ensuring timely order fulfillment, accurate inventory control, and efficient product distribution. You''ll be responsible for various tasks that contribute to Clarity''s success in delivering exceptional vision solutions to our customers worldwide.</p>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2254,16796623585306,1743,45170,NULL,'en_US','<ul data-sourcepos="11:1-18:0">\u000a\u0009<li data-sourcepos="11:1-11:107">Receive, unload, and inspect incoming shipments of eyewear products, verifying accuracy and completeness.</li>\u000a\u0009<li data-sourcepos="12:1-12:102">Organize, store, and maintain inventory according to designated locations and established protocols.</li>\u000a\u0009<li data-sourcepos="13:1-13:116">Carefully pick, pack, and ship orders according to customer specifications, ensuring accuracy and timely dispatch.</li>\u000a\u0009<li data-sourcepos="14:1-14:91">Conduct cycle counts and assist with regular inventory audits to maintain data integrity.</li>\u000a\u0009<li data-sourcepos="15:1-15:98">Operate warehouse equipment safely and efficiently (e.g., pallet jacks, forklifts if qualified).</li>\u000a\u0009<li data-sourcepos="16:1-16:105">Maintain a clean, organized, and safe work environment, adhering to all safety policies and procedures.</li>\u000a\u0009<li data-sourcepos="17:1-18:0">Collaborate effectively with other warehouse associates and support staff.</li>\u000a</ul>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2255,16796623585306,1744,45170,NULL,'en_US','<ul data-sourcepos="21:1-28:0">\u000a\u0009<li data-sourcepos="21:1-21:48">High school diploma or equivalent (preferred).</li>\u000a\u0009<li data-sourcepos="22:1-22:77">A strong work ethic, with a commitment to accuracy, efficiency, and safety.</li>\u000a\u0009<li data-sourcepos="23:1-23:63">Ability to lift and maneuver moderate weights (up to 50 lbs).</li>\u000a\u0009<li data-sourcepos="24:1-24:60">Excellent organizational skills and a keen eye for detail.</li>\u000a\u0009<li data-sourcepos="25:1-25:98">Basic computer literacy and the ability to learn new warehouse management systems (WMS) quickly.</li>\u000a\u0009<li data-sourcepos="26:1-26:89">Strong teamwork skills and the ability to work effectively in a fast-paced environment.</li>\u000a\u0009<li data-sourcepos="27:1-28:0">A positive attitude and a willingness to learn and grow.</li>\u000a</ul>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2256,16796623585306,1745,45201,'availableLanguageIds',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2257,16796623585306,1745,45201,'defaultLanguageId',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2258,16796623585306,1746,45201,NULL,'en_US','<p><strong>See the bigger picture in logistics!</strong> Clarity, a leading global manufacturer of innovative eyewear, seeks a passionate Warehouse Manager to join our dynamic team. In this pivotal role, you''ll be responsible for the smooth and efficient operation of our warehouse, ensuring timely order fulfillment, accurate inventory control, and a safe and organized work environment. You''ll play a key role in keeping our supply chain running smoothly and supporting Clarity''s continued growth.</p>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2259,16796623585306,1747,45201,NULL,'en_US','<ul data-sourcepos="11:1-20:0">\u000a\u0009<li data-sourcepos="11:1-11:128">Oversee all aspects of warehouse operations, including receiving, storing, picking, packing, and shipping of eyewear products.</li>\u000a\u0009<li data-sourcepos="12:1-12:103">Develop and implement efficient warehouse processes to optimize order fulfillment speed and accuracy.</li>\u000a\u0009<li data-sourcepos="13:1-13:98">Manage inventory levels effectively, ensuring stock availability while minimizing storage costs.</li>\u000a\u0009<li data-sourcepos="14:1-14:94">Conduct regular inventory audits to maintain data integrity and prevent stock discrepancies.</li>\u000a\u0009<li data-sourcepos="15:1-15:99">Supervise and motivate warehouse personnel, fostering a positive and productive work environment.</li>\u000a\u0009<li data-sourcepos="16:1-16:108">Ensure adherence to all safety regulations and procedures, prioritizing the well-being of warehouse staff.</li>\u000a\u0009<li data-sourcepos="17:1-17:71">Maintain accurate and up-to-date warehouse documentation and records.</li>\u000a\u0009<li data-sourcepos="18:1-18:135">Collaborate with other departments (e.g., production, sales) to ensure smooth coordination and communication within the supply chain.</li>\u000a\u0009<li data-sourcepos="19:1-20:0">Identify opportunities for continuous improvement and implement strategies to optimize warehouse efficiency.</li>\u000a</ul>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2260,16796623585306,1748,45201,NULL,'en_US','<ul data-sourcepos="23:1-31:0">\u000a\u0009<li data-sourcepos="23:1-23:130">Minimum 3-5 years of experience in warehouse management, preferably within a manufacturing or distribution environment (a plus).</li>\u000a\u0009<li data-sourcepos="24:1-24:77">Strong understanding of warehouse operations principles and best practices.</li>\u000a\u0009<li data-sourcepos="25:1-25:78">Proven ability to develop and implement efficient inventory control systems.</li>\u000a\u0009<li data-sourcepos="26:1-26:114">Excellent analytical and problem-solving skills, with the ability to identify and address logistical challenges.</li>\u000a\u0009<li data-sourcepos="27:1-27:119">Strong leadership, communication, and interpersonal skills, with the ability to motivate and collaborate with a team.</li>\u000a\u0009<li data-sourcepos="28:1-28:62">Proficiency in warehouse management software (WMS) (a plus).</li>\u000a\u0009<li data-sourcepos="29:1-29:91">Ability to work independently and manage multiple priorities in a fast-paced environment.</li>\u000a\u0009<li data-sourcepos="30:1-31:0">A strong focus on detail and accuracy, with a commitment to quality and safety.</li>\u000a</ul>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2261,16796623585306,1749,45217,'availableLanguageIds',NULL,'','en_US')
