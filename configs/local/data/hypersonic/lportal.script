INSERT INTO ASSETENTRY VALUES(2,0,37749,32106,16796623585306,20122,'Clarity Admin','2024-05-31 17:51:24.369000','2024-05-31 17:51:48.375000',29437,37745,'a8af346c-f554-5441-fbc5-c15eb09ab0f8',0,'1','1',NULL,NULL,'2024-05-31 17:50:00.000000',NULL,'text/html','Comparing Glass and Plastic Lens Materials','','When it comes to choosing lenses for your glasses, the material used is one of the key factors you should consider. Two common materials used are glass and plastic. Glass lenses were the first to be developed and have been in use for centuries. They offer excellent visual quality and are highly resistant to scratches. However, glass lenses are heavy and can break easily, which can be a potential safety hazard. On the other hand, plastic lenses were introduced in the 1940s as a lighter and...',NULL,NULL,0,0,0.0E0)
