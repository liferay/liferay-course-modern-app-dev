INSERT INTO FRAGMENTENTRYLINK VALUES(94,0,'6591c1f8-80cd-6944-aa27-eeff0f17bdc7',40856,32106,16796623585306,20122,'Clarity Admin','2024-06-04 02:29:32.395000','2025-11-06 19:44:24.798000',0,0,40836,20031,67,67,'.component-html img {\u000a\u0009max-width: 100%;\u000a}','<div class="component-html" data-lfr-editable-id="element-html" data-lfr-editable-type="html">\u000a\u0009<h1>HTML Example</h1>\u000a\u000a\u0009<p class="mb-0">\u000a\u0009\u0009A paragraph is a <strong>self-contained</strong> unit of a discourse in\u000a\u0009\u0009writing dealing with a particular point or <em>idea</em>. Paragraphs are\u000a\u0009\u0009usually an expected part of formal writing, used to organize longer\u000a\u0009\u0009prose.\u000a\u0009</p>\u000a</div>','','','0','{"com.liferay.fragment.entry.processor.editable.EditableFragmentEntryProcessor":{"element-html":{"config":{},"defaultValue":"\n\t<h1>HTML Example</h1>\n\n\t<p class=\"mb-0\">\n\t\tA paragraph is a <strong>self-contained</strong> unit of a discourse in\n\t\twriting dealing with a particular point or <em>idea</em>. Paragraphs are\n\t\tusually an expected part of formal writing, used to organize longer\n\t\tprose.\n\t</p>\n","mappedField":"DDMStructure_RichText20480119"}}}','vadg',3,'BASIC_COMPONENT-html',1,'2025-11-06 19:44:24.797000',NULL,'6591c1f8-80cd-6944-aa27-eeff0f17bdc7')
