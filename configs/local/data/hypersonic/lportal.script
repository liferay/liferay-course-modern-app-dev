INSERT INTO FRAGMENTENTRY VALUES(1,0,'01236085-af04-cad4-d916-d2a8cfbb6223',-802,'1',802,32106,16796623585306,20122,'Clarity Admin','2025-08-13 17:56:59.482000','2025-08-13 17:56:59.493000',32638,'country-selector','Country Selector','','[#assign\u000a\u0009readOnly = input.attributes.readOnly?? && input.attributes.readOnly\u000a]\u000a[#attempt]\u000a\u0009[#assign countries = restClient.get("/headless-admin-address/v1.0/countries?fields=a3,title_i18n&sort=name&pageSize=300").items![] /]\u000a[#recover]\u000a\u0009[#assign countries = [] /]\u000a[/#attempt]\u000a<div class="select-input">\u000a\u0009<div class="form-group [#if input.errorMessage?has_content]has-error[/#if] mb-0" id="${fragmentEntryLinkNamespace}-form-group">\u000a\u0009\u0009<label class="[#if !input.showLabel || !input.label?has_content]sr-only[/#if]" for="${fragmentEntryLinkNamespace}-select-input" id="${fragmentEntryLinkNamespace}-select-input-label">${htmlUtil.escape(input.label)} [#if readOnly](${languageUtil.get(locale, "read-only")})[#elseif input.required][@clay["icon"] className="reference-mark" symbol="asterisk" /][/#if]</label>\u000a\u0009\u0009<select\u000a\u0009\u0009\u0009aria-describedby="${fragmentEntryLinkNamespace}-select-input-help-text"\u000a\u0009\u0009\u0009aria-labelledby="${fragmentEntryLinkNamespace}-select-input-label [#if  input.errorMessage?has_content]${fragmentEntryLinkNamespace}-select-input-error-message[/#if]"\u000a\u0009\u0009\u0009class="form-control"\u000a\u0009\u0009\u0009id="${fragmentEntryLinkNamespace}-select-input"\u000a\u0009\u0009\u0009name="${input.name}"\u000a\u0009\u0009\u0009[#if readOnly]readonly[/#if]\u000a\u0009\u0009\u0009${input.required?then(''required'', '''')}\u000a\u0009\u0009>\u000a\u0009\u0009\u0009<option value="">${languageUtil.get(locale, "choose-an-option")}</option>\u000a\u0009\u0009\u0009[#list countries as country]\u000a\u0009\u0009\u0009\u0009<option value="${country.a3}">${country.title_i18n[locale]}</option>\u000a\u0009\u0009\u0009[/#list]\u000a\u0009\u0009</select>\u000a\u0009\u0009[#if input.errorMessage?has_content]\u000a\u0009\u0009\u0009<p class="font-weight-semi-bold mt-1 text-danger" id="${fragmentEntryLinkNamespace}-select-input-error-message">\u000a\u0009\u0009\u0009\u0009<svg class="lexicon-icon lexicon-icon-info-circle" focusable="false" role="presentation">\u000a\u0009\u0009\u0009\u0009\u0009<use xlink:href="${siteSpritemap}#info-circle" />\u000a\u0009\u0009\u0009\u0009</svg>\u000a\u0009\u0009\u0009\u0009<span>\u000a\u0009\u0009\u0009\u0009\u0009${input.errorMessage}\u000a\u0009\u0009\u0009\u0009</span>\u000a\u0009\u0009\u0009</p>\u000a\u0009\u0009[/#if]\u000a\u0009\u0009[#if input.showHelpText && input.helpText?has_content]\u000a\u0009\u0009\u0009<p class="mb-0 mt-1 text-secondary" id="${fragmentEntryLinkNamespace}-select-input-help-text">${htmlUtil.escape(input.helpText)}</p>\u000a\u0009\u0009[/#if]\u000a\u0009</div>\u000a</div>','const inputElement = document.getElementById(`${fragmentNamespace}-select-input`);\u000aif (layoutMode === ''edit'') {\u000a\u0009inputElement.setAttribute(''disabled'', true);\u000a}','0','{\u000a\u0009"fieldSets": [\u000a\u0009]\u000a}','forms',0,'0',3,'{"fieldTypes":["text"]}',NULL,0,20122,'Clarity Admin','2025-08-13 17:56:59.482000','01236085-af04-cad4-d916-d2a8cfbb6223')
INSERT INTO FRAGMENTENTRY VALUES(1,0,'b9b3681c-b206-e825-a379-de2e2a764e4a',-804,'1',804,32106,16796623585306,20122,'Clarity Admin','2025-08-13 17:57:08.711000','2025-08-13 17:57:08.715000',32638,'advanced-file-uploader','Advanced File Uploader','.file-upload-input {\u000a    border: none;\u000a    height: 1px;\u000a    left: 50%;\u000a    outline: none;\u000a    position: absolute;\u000a    top: 100%;\u000a    width: 1px;\u000a}','<div id="fileupload-${fragmentEntryLinkNamespace}-element" class="form-group bg-white mb-0">\u000a\u0009<label for="${fragmentEntryLinkNamespace}-text-input" id="${fragmentEntryLinkNamespace}-text-input-label">${htmlUtil.escape(input.label)}</label>\u000a\u000a\u0009<div id="fileupload-${fragmentEntryLinkNamespace}-box" class="d-flex rounded align-items-center">\u000a\u0009\u0009<div class="d-flex flex-column align-items-center c-gapy-3 bg-light p-3 rounded-lg w-100">\u000a\u0009\u0009\u0009<input type="hidden" name="file-upload-status" value="2">\u000a\u000a\u0009\u0009\u0009<div class="position-relative">\u000a\u0009\u0009\u0009\u0009<div class="d-flex flex-row align-items-center">\u000a\u0009\u0009\u0009\u0009\u0009<button class="btn btn-outline-primary text-nowrap" id="${fragmentEntryLinkNamespace}-file-upload-button" type="button">[@clay.icon className="text-primary" symbol="upload" /] ${configuration.buttonText}</button>\u000a\u000a<span class="form-control ml-1" id="${fragmentEntryLinkNamespace}-file-chosen" aria-live="polite">No file chosen</span>\u0009\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u0009<input id="${fragmentEntryLinkNamespace}-file-upload-input-hidden" name="file-upload-input-hidden" type="hidden" value="${input.value!}" />\u000a\u000a<input accept="${(input.attributes.allowedFileExtensions?has_content)?then(input.attributes.allowedFileExtensions, ''*'')}" aria-describedby="${fragmentEntryLinkNamespace}-file-upload-input" aria-labelledby="${fragmentEntryLinkNamespace}-file-upload-input-label" class="file-upload-input" formenctype="multipart/form-data" id="${fragmentEntryLinkNamespace}-file-upload-input" name="file-upload-input" ${input.required?then(''required'', '''' )} type="file" value="${input.value}" tabIndex="-1" aria-hidden="true"/>\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u000a[#if (input.showHelpText && input.helpText?has_content)]\u000a\u0009<p class="mb-0 text-secondary text-center" id="${fragmentEntryLinkNamespace}-file-upload-help-text">${input.helpText}</p>\u000a[/#if]\u000a\u0009\u0009</div>\u000a\u0009</div>\u000a</div>\u000a\u000a<template id="template-${fragmentEntryLinkNamespace}-loading">\u000a\u0009<div id="${fragmentEntryLinkNamespace}-loading" class="d-flex flex-column align-items-center c-gapy-3 text-center">\u000a\u0009\u0009<div class="loading-animation loading-animation-primary loading-animation-lg"></div>\u000a\u0009\u0009<h4 class="font-weight-normal mb-0">${configuration.loadingTitle}</h4>\u000a\u000a\u0009\u0009<p class="mb-0">${configuration.loadingHelpText}</p>\u000a\u0009</div>\u000a</template>','const fileInput = fragmentElement.querySelector(`#${fragmentNamespace}-file-upload-input`);\u000aconst hiddenFileInput = fragmentElement.querySelector(`#${fragmentNamespace}-file-upload-input-hidden`);\u000aconst selectButton = fragmentElement.querySelector(`#${fragmentNamespace}-file-upload-button`);\u000aconst fileChosen = fragmentElement.querySelector(`#${fragmentNamespace}-file-chosen`)\u000alet previousFiles = null;\u000afunction onInputChange() {\u000a    if (!fileInput.files.length && previousFiles) {\u000a        const dataTransfer = new DataTransfer();\u000a        dataTransfer.items.add(previousFiles);\u000a        fileInput.files = dataTransfer.files;\u000a    }\u000a    fileInput.setAttribute(''name'', input.name);\u000a    hiddenFileInput.setAttribute(''name'', '''');\u000a    hiddenFileInput.value = '''';\u000a    fileChosen.textContent = fileInput.files[0].name;\u000a    triggerLoadScreen();\u000a}\u000afunction onSelectFile(event) {\u000a    event.preventDefault();\u000a    Liferay.Util.openSelectionModal({\u000a        onSelect(selectedItem) {\u000a            const { fileEntryId, title } = JSON.parse(selectedItem.value);\u000a            fileInput.value = fileEntryId;\u000a            fileChosen.textContent = title;\u000a            triggerLoadScreen();\u000a        },\u000a        selectEventName: `${fragmentNamespace}selectFileEntry`,\u000a        url: input.attributes.selectFromDocumentLibraryURL,\u000a    });\u000a}\u000afunction triggerLoadScreen() {\u000a    const component = fragmentElement.querySelector(`#fileupload-${fragmentNamespace}-element`);\u000a    const formBox = fragmentElement.querySelector(`#fileupload-${fragmentNamespace}-box`);\u000a    const template = fragmentElement.querySelector(`#template-${fragmentNamespace}-loading`);\u000a    formBox.classList.add(''hide'');\u000a    component.appendChild(template.content.cloneNode(true));\u000a    setTimeout(() => {\u000a        component.removeChild(fragmentElement.querySelector(`#${fragmentNamespace}-loading`));\u000a        formBox.classList.remove(''hide'');\u000a    }, 1000);\u000a}\u000aif (layoutMode === ''edit'') {\u000a    selectButton.classList.add(''disabled'');\u000a}\u000aelse {\u000a    if (fileInput) {\u000a        fileInput.addEventListener(''change'', onInputChange);\u000a    }\u000a    if (selectButton) {\u000a        if (input.attributes.selectFromDocumentLibrary) {\u000a            selectButton.addEventListener(''click'', onSelectFile);\u000a        }\u000a        else {\u000a            selectButton.addEventListener(''click'', () => {\u000a                previousFiles = fileInput.files[0] || null;\u000a                fileInput.click();\u000a            });\u000a        }\u000a    }\u000a}','0','{\u000a    "fieldSets": [\u000a        {\u000a            "fields": [\u000a                {\u000a                    "defaultValue": "Browse File",\u000a                    "label": "button-text",\u000a                    "localizable": true,\u000a                    "name": "buttonText",\u000a                    "type": "text"\u000a                }\u000a            ],\u000a            "label": "Upload Options"\u000a        },\u000a        {\u000a            "fields": [\u000a                {\u000a                    "defaultValue": "Upload may take a few seconds",\u000a                    "label": "Loading Title",\u000a                    "localizable": true,\u000a                    "name": "loadingTitle",\u000a                    "type": "text"\u000a                },\u000a                {\u000a                    "defaultValue": "Please keep the window open",\u000a                    "label": "Loading Help Text",\u000a                    "localizable": true,\u000a                    "name": "loadingHelpText",\u000a                    "type": "text"\u000a                }\u000a            ],\u000a            "label": "Loading Options"\u000a        }\u000a    ]\u000a}','forms',0,'0',3,'{"fieldTypes":["file"]}',NULL,0,20122,'Clarity Admin','2025-08-13 17:57:08.711000','b9b3681c-b206-e825-a379-de2e2a764e4a')
INSERT INTO FRAGMENTENTRYLINK VALUES(119,0,'b7f1791f-0a51-9d24-8287-ef2117f38ca0',32017,20117,16796623585306,20122,'Clarity Admin','2024-05-13 14:38:37.407000','2025-11-06 19:44:23.299000',0,0,32004,20031,8,8,'.fragment-heading-text-colored a {\u000a\u0009color: inherit;\u000a}','<${configuration.headingLevel} class="component-heading mb-0 text-break" data-lfr-editable-id="element-text"\u000a\u0009data-lfr-editable-type="text">\u000a\u0009Heading Example\u000a</${configuration.headingLevel}>','','{\u000a\u0009"fieldSets": [\u000a\u0009\u0009{\u000a\u0009\u0009\u0009"fields": [\u000a\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009"dataType": "string",\u000a\u0009\u0009\u0009\u0009\u0009"defaultValue": "h1",\u000a\u0009\u0009\u0009\u0009\u0009"label": "heading-level",\u000a\u0009\u0009\u0009\u0009\u0009"name": "headingLevel",\u000a\u0009\u0009\u0009\u0009\u0009"type": "select",\u000a\u0009\u0009\u0009\u0009\u0009"typeOptions": {\u000a\u0009\u0009\u0009\u0009\u0009\u0009"validValues": [\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "h1"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "h2"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "h3"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "h4"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "h5"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "h6"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009\u0009\u0009]\u000a\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009],\u000a\u0009\u0009\u0009"label": "heading-options"\u000a\u0009\u0009}\u000a\u0009]\u000a}','0','{"com.liferay.fragment.entry.processor.editable.EditableFragmentEntryProcessor":{"element-text":{"en_US":"404","config":{"mapperType":"link"}}},"com.liferay.fragment.entry.processor.freemarker.FreeMarkerFragmentEntryProcessor":{"headingLevel":"h1"}}','mxei',0,'BASIC_COMPONENT-heading',1,'2025-11-06 19:44:23.299000',NULL,'b7f1791f-0a51-9d24-8287-ef2117f38ca0')
INSERT INTO FRAGMENTENTRYLINK VALUES(119,0,'8e417682-7af6-191f-8d6c-364730534163',32018,20117,16796623585306,20122,'Clarity Admin','2024-05-13 14:38:37.455000','2025-11-06 19:44:23.311000',0,0,32004,20031,8,8,'.component-paragraph img {\u000a\u0009max-width: 100%;\u000a}','<div class="clearfix component-paragraph text-break" data-lfr-editable-id="element-text" data-lfr-editable-type="rich-text">\u000a\u0009A paragraph is a self-contained unit of a discourse in writing dealing with\u000a\u0009a particular point or idea. Paragraphs are usually an expected part of\u000a\u0009formal writing, used to organize longer prose.\u000a</div>','','','0','{"com.liferay.fragment.entry.processor.editable.EditableFragmentEntryProcessor":{"element-text":{"defaultValue":"\n\tA paragraph is a self-contained unit of a discourse in writing dealing with\n\ta particular point or idea. Paragraphs are usually an expected part of\n\tformal writing, used to organize longer prose.\n","en_US":"Page Not Found","config":{"mapperType":"link"}}}}','msle',1,'BASIC_COMPONENT-paragraph',1,'2025-11-06 19:44:23.310000',NULL,'8e417682-7af6-191f-8d6c-364730534163')
INSERT INTO FRAGMENTENTRYLINK VALUES(119,0,'da8fa989-9ab6-7e2a-13d4-230b9d24d572',32019,20117,16796623585306,20122,'Clarity Admin','2024-05-13 14:38:37.459000','2025-11-06 19:44:23.332000',0,0,32004,20031,8,8,'','[#if configuration.type == "action"]\u000a\u0009<button class="btn btn-${configuration.buttonSize} btn-${configuration.buttonType}" data-lfr-editable-id="action" data-lfr-editable-type="action">\u000a\u0009\u0009Go Somewhere\u000a\u0009</button>\u000a\u000a\u0009[#else]\u000a\u0009\u0009<div class="component-button text-break">\u000a\u0009\u0009\u0009<a class="btn btn-${configuration.buttonSize} btn-${configuration.buttonType}" data-lfr-editable-id="link" data-lfr-editable-type="link" href="" id="fragment-${fragmentEntryLinkNamespace}-link">\u000a\u0009\u0009\u0009\u0009Go Somewhere\u000a\u0009\u0009\u0009</a>\u000a\u0009\u0009</div>\u000a[/#if]','','{\u000a\u0009"fieldSets": [\u000a\u0009\u0009{\u000a\u0009\u0009\u0009"fields": [\u000a\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009"dataType": "string",\u000a\u0009\u0009\u0009\u0009\u0009"defaultValue": "link",\u000a\u0009\u0009\u0009\u0009\u0009"label": "type",\u000a\u0009\u0009\u0009\u0009\u0009"name": "type",\u000a\u0009\u0009\u0009\u0009\u0009"type": "select",\u000a\u0009\u0009\u0009\u0009\u0009"typeOptions": {\u000a\u0009\u0009\u0009\u0009\u0009\u0009"validValues": [\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "link"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "action"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009\u0009\u0009]\u000a\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009"dataType": "string",\u000a\u0009\u0009\u0009\u0009\u0009"defaultValue": "primary",\u000a\u0009\u0009\u0009\u0009\u000