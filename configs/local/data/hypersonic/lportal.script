INSERT INTO FRAGMENTENTRYLINK VALUES(67,0,'fbe50b6b-df26-8b26-d00e-dcf72d306485',50084,32106,16796623585306,32252,'Walter Douglas','2024-08-28 19:41:07.874000','2025-11-06 19:44:25.485000',0,0,49955,20031,98,98,'.component-paragraph img {\u000a\u0009max-width: 100%;\u000a}','<div class="clearfix component-paragraph text-break" data-lfr-editable-id="element-text" data-lfr-editable-type="rich-text">\u000a\u0009A paragraph is a self-contained unit of a discourse in writing dealing with\u000a\u0009a particular point or idea. Paragraphs are usually an expected part of\u000a\u0009formal writing, used to organize longer prose.\u000a</div>','','','0','{"com.liferay.fragment.entry.processor.editable.EditableFragmentEntryProcessor":{"element-text":{"defaultValue":"\n\tA paragraph is a self-contained unit of a discourse in writing dealing with\n\ta particular point or idea. Paragraphs are usually an expected part of\n\tformal writing, used to organize longer prose.\n","en_US":"Our goal is to be your trusted partner in eye care, offering unparalleled support and collaboration to acheieve your vision. Elevate your brand with premium eyeglass frames and lenses.","config":{"mapperType":"link"}}}}','piqq',1,'BASIC_COMPONENT-paragraph',1,'2025-11-06 19:44:25.485000',NULL,'fbe50b6b-df26-8b26-d00e-dcf72d306485')
INSERT INTO FRAGMENTENTRYLINK VALUES(0,0,'7bcb85b0-bd35-5ac9-ff19-d668b16f8bc9',50085,32106,16796623585306,32252,'Walter Douglas','2024-08-28 19:41:07.879000','2024-08-28 19:41:07.879000',0,20,49955,20031,98,98,'.values{\u000a  display: flex;  \u000a}\u000a\u000a.value-card{\u000a  display: flex;\u000a  flex-direction: column;\u000a  justify-content: center;\u000a  align-items: center;\u000a\u0009padding: 32px;\u000a  width: 100%;\u000a  height: 148px;\u000a\u0009gap: 16px;\u000a  background: #F7EBD9;\u000a  border-radius: 12px;\u000a\u0009isolation: isolate;\u000a  overflow: hidden;\u000a  position: relative;\u000a}\u000a\u000a.value-card-circle{\u000a  position: absolute;\u000a\u0009background: linear-gradient(227.52deg, #F7EBD9 12.01%, #FBE0B9 85.9%);\u000a  box-shadow: 0px -2px 12px rgba(193, 137, 51, 0.2);\u000a  border-radius: 999px;\u000a\u0009opacity: 50%;\u000a}\u000a\u000a/* large watermark positions */\u000a\u000a.value-card-circle-lg{\u000a  width: 142px;\u000a  height: 142px;\u000a\u000a}\u000a\u000a.value-card-circle-lg-br{\u000a  bottom: -80px;\u000a  right: -85px;\u000a}\u000a\u000a.value-card-circle-lg-bl{\u000a  bottom: -80px;\u000a  left: -85px;\u000a}\u000a\u000a.value-card-circle-lg-tr{\u000a  top: -80px;\u000a  right: -60px;\u000a}\u000a\u000a.value-card-circle-lg-tl{\u000a  top: -80px;\u000a  left: -100px;\u000a}\u000a\u000a/* small watermark positions */\u000a\u000a.value-card-circle-sm{\u000a  width: 95px;\u000a  height: 95px;\u000a}\u000a\u000a.value-card-circle-sm-br{\u000a  bottom: -20px;\u000a  right: -60px;\u000a}\u000a\u000a.value-card-circle-sm-bl{\u000a  bottom: -20px;\u000a  left: -60px;\u000a}\u000a\u000a.value-card-circle-sm-tr{\u000a  bottom: -20px;\u000a  right: -60px;\u000a}\u000a\u000a.value-card-circle-sm-tl{\u000a  bottom: -20px;\u000a  left: -60px;\u000a}','<div class="values text-center">\u000a  <div class="value-card value-card-color">\u000a\u0009\u0009   <lfr-drop-zone></lfr-drop-zone>\u000a \u0009</div>\u000a\u0009\u000