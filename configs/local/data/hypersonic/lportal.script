INSERT INTO DDMTEMPLATEVERSION VALUES(0,0,31648,20119,16796623585306,20095,NULL,'2024-05-13 14:37:48.974000',31642,0,31646,'1.0','<?xml version=''1.0'' encoding=''UTF-8''?><root available-locales="en_US,sv_SE,pt_BR,ja_JP,fr_FR,hu_HU,de_DE,ca_ES,ar_SA,fi_FI,zh_CN,es_ES,nl_NL" default-locale="en_US"><Name language-id="sv_SE">Layout f\u00f6r hyperl\u00e4nk (ett val)</Name><Name language-id="pt_BR">Layout de Hiperlink (Sele\u00e7\u00e3o \u00fanica)</Name><Name language-id="ja_JP">\u30cf\u30a4\u30d1\u30fc\u30ea\u30f3\u30af\u306e\u30ec\u30a4\u30a2\u30a6\u30c8 (\u5358\u4e00\u9078\u629e)</Name><Name language-id="fr_FR">Disposition des liens hypertexte (s\u00e9lection unique)</Name><Name language-id="hu_HU">Hiperhivatkoz\u00e1s elrendez\u00e9se (egyv\u00e1laszt\u00f3s)</Name><Name language-id="de_DE">Hyperlinklayout (Einzelauswahl)</Name><Name language-id="ca_ES">Disposici\u00f3 de l''enlla\u00e7 (selecci\u00f3 \u00fanica)</Name><Name language-id="ar_SA">\u062a\u062e\u0637\u064a\u0637 \u0627\u0644\u0627\u0631\u062a\u0628\u0627\u0637 \u0627\u0644\u062a\u0634\u0639\u0628\u064a (\u062a\u062d\u062f\u064a\u062f \u0641\u0631\u062f\u064a)</Name><Name language-id="fi_FI">Hyperlinkin asettelu (yksitt\u00e4inen valinta)</Name><Name language-id="en_US">Hyperlink Layout (Single Select)</Name><Name language-id="zh_CN">\u8d85\u94fe\u63a5\u5e03\u5c40\uff08\u5355\u9009\uff09</Name><Name language-id="es_ES">Dise\u00f1o del hiperv\u00ednculo (selecci\u00f3n \u00fanica)</Name><Name language-id="nl_NL">Lay-out hyperlinks (enkelvoudige selectie)</Name></root>','<?xml version=''1.0'' encoding=''UTF-8''?><root available-locales="en_US,sv_SE,pt_BR,ja_JP,fr_FR,hu_HU,de_DE,ca_ES,ar_SA,fi_FI,zh_CN,es_ES,nl_NL" default-locale="en_US"><Description language-id="sv_SE">Visa villkoren som en lista med l\u00e4nkar.</Description><Description language-id="pt_BR">Exibir termos como uma lista de links.</Description><Description language-id="ja_JP">\u7528\u8a9e\u3092\u30ea\u30f3\u30af\u30ea\u30b9\u30c8\u3068\u30