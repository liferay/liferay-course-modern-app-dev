INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,3257,16796623585306,2620,51861,'url','en_US','','"\/documents\/d\/asset-library-32687\/screenshot-2024-05-20-at-17-30-41"')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,3258,16796623585306,2620,51861,'height','en_US','','""')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,3259,16796623585306,2621,51861,NULL,'en_US','','<p>2024 Eyewear Trends: What''s In and What''s Out</p>')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,3260,16796623585306,2622,51861,NULL,'en_US','<p>As we step into 2024, eyewear trends are evolving with new styles and designs. Oversized sunglasses are making a comeback, offering both fashion and UV protection. Clear frame glasses continue to be popular for a minimalist look, while bold colored frames are also gaining attention. Blue light blocking glasses are becoming a necessity in the digital age, protecting eyes from screen-induced strain. With sustainable fashion on the rise, eco-friendly eyewear materials like bamboo and recycled plastics are becoming more prevalent.</p>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,3261,16796623585306,2623,52053,'availableLanguageIds',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,3262,16796623585306,2623,52053,'defaultLanguageId',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,3263,16796623585306,2624,52053,NULL,'en_US','<p><strong>Elevate your vision for the future!</strong> Clarity, a world-renowned manufacturer of innovative eyewear, seeks a passionate Associate Optical Engineer (Level 2) to join our growing team. In this progressive role, you''ll leverage your developing expertise to contribute significantly to the design, analysis, and optimization of advanced optical components for our next-generation eyewear solutions. You''ll collaborate with industry experts, tackle challenging projects, and gain valuable experience that will propel your career forward.</p>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,3264,16796623585306,2625,52053,NULL,'en_US','<ul data-sourcepos="11:1-18:0">\u000a\u0009<li data-sourcepos="11:1-11:152">Collaborate with senior engineers on the design and analysis of optical components and systems using industry-standard software (e.g., Zemax, Code V).</li>\u000a\u0009<li data-sourcepos="12:1-12:146">Independently conduct optical simulations and analyses to evaluate performance metrics (e.g., image quality, light transmission, field of view).</li>\u000a\u0009<li data-sourcepos="13:1-13:207">Lead problem-solving efforts for assigned optical design challenges, proposing innovative solutions and collaborating with cross-functional teams (e.g., manufacturing, research) to achieve optimal results.</li>\u000a\u0009<li data-sourcepos="14:1-14:159">Actively participate in the development and testing of optical prototypes, ensuring functionality, manufacturability, and adherence to design specifications.</li>\u000a\u0009<li data-sourcepos="15:1-15:149">Create and maintain clear and comprehensive technical documentation for assigned projects, including optical designs, test procedures, and results.</li>\u000a\u0009<li data-sourcepos="16:1-16:148">Stay abreast of advancements in optical technology and materials, actively seeking opportunities to integrate new knowledge into ongoing projects.</li>\u000a\u0009<li data-sourcepos="17:1-18:0">Contribute to the continuous improvement of optical design processes and methodologies.</li>\u000a</ul>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,3265,16796623585306,2626,52053,NULL,'en_US','<ul data-sourcepos="21:1-28:0">\u000a\u0009<li data-sourcepos="21:1-21:83">Bachelor''s degree in Optical Engineering, Physics, or a related field (required).</li>\u000a\u0009<li data-sourcepos="22:1-22:145">2-4 years of experience in applied optics or a related field, with demonstrable experience using optical design software (e.g., Zemax, Code V).</li>\u000a\u0009<li data-sourcepos="23:1-23:154">Strong understanding of optical design principles and theories (e.g., geometrical optics, physical optics) and their application to real-world problems.</li>\u000a\u0009<li data-sourcepos="24:1-24:99">Proven ability to analyze data, identify trends, and translate findings into actionable insights.</li>\u000a\u0009<li data-sourcepos="25:1-25:169">Excellent communication, collaboration, and interpersonal skills, with the ability to work effectively in a team environment and present technical information clearly.</li>\u000a\u0009<li data-sourcepos="26:1-26:79">A meticulous eye for detail and a commitment to delivering high-quality work.</li>\u000a\u0009<li data-sourcepos="27:1-28:0">A passion for learning and a desire to continuously develop your skills within the field of optical engineering.</li>\u000a</ul>',NULL)
