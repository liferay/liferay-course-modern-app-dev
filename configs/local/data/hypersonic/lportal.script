INSERT INTO ROLE_ VALUES(1,0,'4a344e87-815e-bb04-9386-62e047babd64',62403,16796623585306,20122,'Clarity Admin','2025-03-06 13:00:51.055000','2025-03-07 12:09:59.398000',20064,62403,'Business Development Specialist','<?xml version="1.0" ?><root available-locales="en_US" default-locale="en_US"><Title language-id="en_US">Business Development Specialist</Title></root>','<?xml version="1.0" ?><root available-locales="en_US" default-locale="en_US"><Description language-id="en_US">Business Development Specialists are responsible for identifying and assessing growth opportunities for Clarity. This includes evaluating distributor applications, filling out evaluations, and making recommendations based on whether the applicant aligns with the company''s goals and have the distribution capacity to further Clarity''s market penetration goals.</Description></root>',1,NULL,'Business Development Specialist')
