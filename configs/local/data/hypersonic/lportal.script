INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2364,16796623585306,1775,45247,'url','en_US','','"\/documents\/d\/asset-library-32679\/leader-daniel-lewis"')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2365,16796623585306,1775,45247,'height','en_US','','"306"')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2366,16796623585306,1776,45247,NULL,'en_US','','Daniel Lewis')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2367,16796623585306,1777,45247,NULL,'en_US','','Chief Creative Officer')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2368,16796623585306,1778,45247,NULL,'en_US','<p>Daniel Lewis is the Chief Creative Officer at Clarity Vision Solutions, a leading eyewear manufacturer known for its innovative and stylish designs. With over 18 years of experience in the creative industry, Daniel is a visionary leader who brings a unique blend of artistic talent and strategic thinking to his role.</p>\u000a\u000a<p>Since joining Clarity Vision Solutions in 2016, Daniel has been at the forefront of the company\u2019s creative direction, driving the design and development of groundbreaking eyewear collections. His keen eye for detail and deep understanding of fashion trends have helped Clarity Vision Solutions establish a distinct brand identity and a loyal customer base. Under his leadership, the design team has introduced several award-winning products, setting new standards in the eyewear industry.</p>\u000a\u000a<p>Before his tenure at Clarity Vision Solutions, Daniel held prominent creative roles at various prestigious fashion and accessory brands. He holds a Bachelor\u2019s degree in Fine Arts from the Rhode Island School of Design and a Master\u2019s degree in Industrial Design from the Pratt Institute.</p>\u000a\u000a<p>Daniel is celebrated for his innovative approach to design, his ability to inspire and lead creative teams, and his commitment to excellence. He is passionate about pushing the boundaries of traditional eyewear design, incorporating cutting-edge materials and technologies to create products that are both functional and aesthetically pleasing.</p>\u000a\u000a<p>In his free time, Daniel enjoys painting, traveling, and exploring new art forms. He is also an active participant in design conferences and workshops, sharing his knowledge and insights with the broader creative community.</p>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2369,16796623585306,1779,45253,'availableLanguageIds',NULL,'','en_US')
