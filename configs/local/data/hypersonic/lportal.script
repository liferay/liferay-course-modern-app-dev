INSERT INTO ASSETENTRY VALUES(1,0,37890,32106,16796623585306,20122,'Clarity Admin','2024-05-01 12:24:48.132000','2024-05-04 19:53:57.576000',29437,37888,'a6618e0d-601a-0a3a-2f55-9aa84dc31547',0,'1','1',NULL,NULL,'2024-05-01 12:24:00.000000',NULL,'text/html','Augmenting Reality with AR Eyewear','','Augmented Reality (AR) eyewear is revolutionizing the way we perceive the world. Unlike VR, which creates an entirely virtual world, AR overlays digital information onto the real world. The start of a revolution Augmented Reality (AR) eyewear is revolutionizing the way we perceive the world. Unlike VR, which creates an entirely virtual world, AR overlays digital information onto the real world. With AR glasses, you can receive directions, read emails, watch videos, play games, and much more,...',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,37919,32106,16796623585306,20122,'Clarity Admin','2024-05-01 12:25:13.423000','2024-05-01 12:25:13.430000',20009,37917,'4b925d19-bed9-aaf5-9c0c-d31f814788ba',0,'1','1',NULL,NULL,'2024-05-01 12:25:13.423000',NULL,'image/png','img1714566311255-4.jpg','','',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,37925,32106,16796623585306,20122,'Clarity Admin','2024-05-01 12:25:13.417000','2024-05-04 22:30:25.569000',29437,37923,'349dc422-e99d-4832-7b42-ebd6953f6442',0,'1','1',NULL,NULL,'2024-05-01 12:25:00.000000',NULL,'text/html','Transition Lenses: The Perfect Balance Between Glasses and Sunglasses','','Transition lenses, also known as photochromic lenses, adapt to changing light conditions, providing a comfortable and protective vision experience. When exposed to sunlight, these lenses darken, acting like sunglasses and reducing glare. Indoors, they clear up, functioning as regular glasses. Transition lenses offer the convenience of not having to switch between glasses and sunglasses, making them a popular choice for those constantly on the go. Plus, they offer 100% UV protection, keeping...',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,37947,32106,16796623585306,20122,'Clarity Admin','2024-05-01 12:25:40.513000','2024-05-01 12:25:40.520000',20009,37945,'911839d3-99e5-880a-db39-89ef9e902ca6',0,'1','1',NULL,NULL,'2024-05-01 12:25:40.513000',NULL,'image/png','img1714566338419-6.jpg','','',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,37953,32106,16796623585306,20122,'Clarity Admin','2024-05-01 12:25:40.508000','2024-05-04 22:25:55.163000',29437,37951,'f7deed6e-ee5c-df00-08eb-4e9bd5ac2928',0,'1','1',NULL,NULL,'2024-05-01 12:25:00.000000',NULL,'text/html','The Future of Eyewear: Smart Contact Lenses','','The future of eyewear might not be glasses at all, but smart contact lenses. These lenses offer an even more seamless, unobtrusive experience than smart glasses. They can provide augmented reality experiences, take pictures, and even monitor health metrics like glucose levels. While still in early development stages, the potential of smart contact lenses is vast. They promise a future where eyewear is not just a tool for improved vision, but an integrated part of our daily digital lives. What...',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,37961,32106,16796623585306,20122,'Clarity Admin','2024-05-01 13:00:02.865000','2024-05-01 13:00:02.873000',20009,37959,'2a583a44-0797-2dfc-756e-bba496aec71c',0,'1','1',NULL,NULL,'2024-05-01 13:00:02.865000',NULL,'image/png','img1714568400246-0.jpg','','',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,37967,32106,16796623585306,20122,'Clarity Admin','2024-05-01 13:00:02.855000','2024-05-04 22:15:11.948000',29437,37965,'082b1c72-67c7-4d8e-c103-7b8bb3c74967',0,'1','1',NULL,NULL,'2024-05-01 13:00:00.000000',NULL,'text/html','Eyewear vs. Lasik: A Comprehensive Comparison','','When it comes to correcting vision, you might be torn between sticking with your traditional eyewear or opting for Lasik surgery. Each option has its own set of advantages and potential disadvantages. Eyewear, including glasses and contact lenses, is non-invasive and can be easily updated as your prescription changes. However, they can also be inconvenient, requiring constant cleaning and care. On the other hand, Lasik surgery offers the promise of vision correction without the need for...',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,37974,32106,16796623585306,20122,'Clarity Admin','2024-05-01 13:00:16.063000','2024-05-01 13:00:16.075000',20009,37972,'75d31041-6950-0440-dbb3-bd7b763faac0',0,'1','1',NULL,NULL,'2024-05-01 13:00:16.063000',NULL,'image/png','img1714568413611-1.jpg','','',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,37980,32106,16796623585306,20122,'Clarity Admin','2024-05-01 13:00:16.055000','2024-05-04 22:24:23.658000',29437,37978,'e9332dac-10d2-e0c1-5a97-9aaee46d1bdd',0,'1','1',NULL,NULL,'2024-05-01 13:00:00.000000',NULL,'text/html','The Cost Analysis: Eyewear vs. Lasik','','Financial considerations play a major role when deciding between eyewear and Lasik surgery. The cost of eyewear can vary greatly depending on the type of frames, lenses, and your insurance coverage. Over time, the cost of replacing glasses or contacts can add up. Alternatively, Lasik surgery, while a significant upfront cost, could potentially save you money in the long run by eliminating or reducing your need for glasses or contacts. However, it''s important to remember that not all insurance...',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,37988,32106,16796623585306,20122,'Clarity Admin','2024-05-01 13:00:29.523000','2024-05-01 13:00:29.532000',20009,37986,'8b75ea4d-d27c-ecef-609f-e8e31eb0773e',0,'1','1',NULL,NULL,'2024-05-01 13:00:29.523000',NULL,'image/png','img1714568427379-2.jpg','','',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,37994,32106,16796623585306,20122,'Clarity Admin','2024-05-01 13:00:29.514000','2024-05-04 22:29:00.231000',29437,37992,'05575025-975a-6a96-f850-ad67db2b0d96',0,'1','1',NULL,NULL,'2024-05-01 13:00:00.000000',NULL,'text/html','The Long-Term Implications: Eyewear vs. Lasik','','The choice between eyewear and Lasik isn''t just about convenience or cost - it''s also about considering the long-term implications. Eyewear is a reversible solution and can be adjusted easily as your vision needs change. However, managing eyewear can be a lifelong routine of appointments for fittings and prescription updates. Lasik, on the other hand, can potentially provide a form of permanent vision correction. But it''s worth noting that Lasik can''t correct presbyopia, the age-related loss...',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,38001,32106,16796623585306,20122,'Clarity Admin','2024-05-01 14:09:04.631000','2024-05-01 14:09:04.638000',20009,37999,'c81f506a-efc0-c43d-ce4e-9697bc02562e',0,'1','1',NULL,NULL,'2024-05-01 14:09:04.631000',NULL,'image/png','img1714572542534-0.jpg','','',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,38007,32106,16796623585306,20122,'Clarity Admin','2024-05-01 14:09:04.625000','2024-05-04 22:28:01.710000',29437,38005,'e52afc81-9c2e-c3fb-329b-4762c0988cf9',0,'1','1',NULL,NULL,'2024-05-01 14:09:00.000000',NULL,'text/html','The Importance of Regular Eye Exams','','In our daily lives, we often neglect the importance of regular eye exams. However, they play a crucial role in maintaining our overall eye health. Regular eye exams not only check your visual acuity but also detect early signs of serious health conditions like glaucoma, diabetes, and high blood pressure. These conditions, if left unchecked, can lead to complete vision loss. Regular eye tests can help detect these issues at an early stage, allowing for timely treatment and management. So,...',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,38015,32106,16796623585306,20122,'Clarity Admin','2024-05-01 14:09:26.259000','2024-05-01 14:09:26.267000',20009,38013,'f849904d-f79b-02ae-19de-8c747fe22985',0,'1','1',NULL,NULL,'2024-05-01 14:09:26.259000',NULL,'image/png','img1714572564186-1.jpg','','',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,38021,32106,16796623585306,20122,'Clarity Admin','2024-05-01 14:09:26.250000','2024-05-04 22:16:19.285000',29437,38019,'a8367bb5-2801-24ca-980a-5bcabf113fcc',0,'1','1',NULL,NULL,'2024-05-01 14:09:00.000000',NULL,'text/html','How Diet Affects Eye Health','','The food we consume has a direct impact on our eye health. A diet deficient in essential nutrients can lead to serious eye conditions like macular degeneration and cataract. Nutrients like Vitamin A, C, E, and zinc are vital for maintaining good eye health. Foods rich in these nutrients like carrots, spinach, and fish can help prevent these conditions. Omega-3 fatty acids, found in fish, are essential for maintaining the health of the macula, the part of the eye responsible for central...',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,38028,32106,16796623585306,20122,'Clarity Admin','2024-05-01 14:09:39.691000','2024-05-01 14:09:39.698000',20009,38026,'dae811a5-7b2a-1542-34d6-c0f3e2608926',0,'1','1',NULL,NULL,'2024-05-01 14:09:39.691000',NULL,'image/png','img1714572577577-2.jpg','','',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(2,0,38034,32106,16796623585306,20122,'Clarity Admin','2024-05-01 14:09:39.686000','2024-05-31 18:00:09.139000',29437,38032,'53c2465c-97a5-5dc4-eaf2-c50aa9cfeed9',0,'1','1',NULL,NULL,'2024-05-01 14:09:00.000000',NULL,'text/html','Understanding Digital Eye Strain','','In the digital age, most of us spend a significant amount of time in front of screens, leading to a condition known as digital eye strain. Symptoms of this condition include blurred vision, dry eyes, headaches, and neck and shoulder pain. Simple practices like the 20-20-20 rule, where every 20 minutes, you take a 20-second break and look at something 20 feet away, can help manage this condition. Also, adjusting the brightness and contrast of your screen to a comfortable level can help reduce...',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,38041,32106,16796623585306,20122,'Clarity Admin','2024-05-01 14:09:51.758000','2024-05-01 14:09:51.767000',20009,38039,'f709b8cd-0ca5-3b88-3644-2fb6e9478477',0,'1','1',NULL,NULL,'2024-05-01 14:09:51.758000',NULL,'image/png','img1714572589534-3.jpg','','',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,38047,32106,16796623585306,20122,'Clarity Admin','2024-05-01 14:09:51.750000','2024-05-04 22:26:32.134000',29437,38045,'6369c96e-1b54-2cd0-8563-4bbcfb8235bf',0,'1','1',NULL,NULL,'2024-05-01 14:09:00.000000',NULL,'text/html','The Impact of Smoking on Eye Health','','Smoking is not only harmful to your lungs and heart, but it also poses a serious threat to your eyes. Cigarette smoke contains harmful toxins that can affect the eyes'' natural protection, leading to conditions like cataracts, macular degeneration, and dry eye syndrome. Additionally, smoking can lead to diabetes, which can in turn result in diabetic retinopathy, a condition that can cause blindness. Quitting smoking is essential to prevent these eye conditions and maintain good vision. Smoking...',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,38055,32106,16796623585306,20122,'Clarity Admin','2024-05-01 14:10:07.564000','2024-05-01 14:10:07.572000',20009,38053,'200d257a-cc77-c527-1cad-67bb169c57f5',0,'1','1',NULL,NULL,'2024-05-01 14:10:07.564000',NULL,'image/png','img1714572605408-4.jpg','','',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,38061,32106,16796623585306,20122,'Clarity Admin','2024-05-01 14:10:07.558000','2024-05-04 22:21:59.094000',29437,38059,'831c13f8-0db9-8554-fb02-0cc8add6bed6',0,'1','1',NULL,NULL,'2024-05-01 14:10:00.000000',NULL,'text/html','Protecting Your Eyes from the Sun','','Extended exposure to the sun''s UV rays can lead to serious eye conditions like cataracts and macular degeneration. It''s important to protect your eyes whenever you''re outside, even on cloudy days, as the UV rays can penetrate through the clouds. Wearing sunglasses that block out 99 to 100% of both UVA and UVB radiation can protect your eyes from these harmful rays. Additionally, wearing a wide-brimmed hat can provide extra protection. Remember, your eyes need as much protection from the sun...',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,38070,32106,16796623585306,20122,'Clarity Admin','2024-05-01 14:11:08.258000','2024-05-01 14:11:08.267000',20009,38068,'6117b620-0951-72ca-24df-d8feee788726',0,'1','1',NULL,NULL,'2024-05-01 14:11:08.258000',NULL,'image/png','img1714572666243-0.jpg','','',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,38076,32106,16796623585306,20122,'Clarity Admin','2024-05-01 14:11:08.250000','2024-05-04 22:09:04.635000',29437,38074,'4ec3ae89-c5b6-1d23-09fb-2a653c9ffa16',0,'1','1',NULL,NULL,'2024-05-01 14:11:00.000000',NULL,'text/html','Choosing the Right Eyewear for Outdoor Activities','','Whether you''re hiking up a mountain, cycling through the countryside, or just going for a jog in your local park, your eyewear is an essential piece of gear. It protects your eyes from harmful UV rays, helps you see clearly, and can even add a touch of style to your outfit. But with so many options available, how do you choose the right pair? It all depends on your specific needs. Are you looking for sunglasses that will stand up to rough and tumble activities? Or do you need prescription...',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,38083,32106,16796623585306,20122,'Clarity Admin','2024-05-01 14:11:20.540000','2024-05-01 14:11:20.548000',20009,38081,'ab0cc404-4adf-c344-7f21-9d56a346a0d2',0,'1','1',NULL,NULL,'2024-05-01 14:11:20.540000',NULL,'image/png','img1714572678416-1.jpg','','',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,38089,32106,16796623585306,20122,'Clarity Admin','2024-05-01 14:11:20.531000','2024-05-04 22:27:17.854000',29437,38087,'e02ebb3d-698c-9b59-e3b3-d653be93ec2f',0,'1','1',NULL,NULL,'2024-05-01 14:11:00.000000',NULL,'text/html','The Importance of Eyewear in Digital Activities','','In today\u2019s digital age, we spend a significant portion of our day staring at screens. Whether you''re working on a computer, checking messages on your smartphone, or playing video games, digital screen exposure can cause eyestrain, dryness, and blurred vision. That''s where digital eyewear comes in. These glasses are specially designed to block harmful blue light emitted by digital screens, helping to prevent digital eye strain and protect your vision. Furthermore, they can even improve your...',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,38114,32106,16796623585306,20122,'Clarity Admin','2024-05-01 14:12:48.383000','2024-05-01 14:12:48.391000',20009,38112,'a6e6a183-050d-e0e7-6cfb-3602ebb30928',0,'1','1',NULL,NULL,'2024-05-01 14:12:48.383000',NULL,'image/png','img1714572766378-1.jpg','','',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,38120,32106,16796623585306,20122,'Clarity Admin','2024-05-01 14:12:48.377000','2024-05-04 22:23:52.118000',29437,38118,'31f0a63d-2561-281d-0e72-2328308677cb',0,'1','1',NULL,NULL,'2024-05-01 14:12:00.000000',NULL,'text/html','Stars and Specs: Celebrity Eyewear Trends','','Celebrities have a knack for setting trends, and eyewear is no exception. From Kendall Jenner''s sleek aviators to Elton John''s flamboyant frames, there''s a celebrity eyewear inspiration for every style and taste. And it''s not just about sunglasses: prescription glasses are getting a moment in the spotlight, too. Celebrities like Ryan Gosling, Jennifer Aniston, and Zoe Kravitz have all been seen rocking stylish specs, proving that glasses can be just as fashionable as any other accessory. So,...',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,38127,32106,16796623585306,20122,'Clarity Admin','2024-05-01 14:13:00.854000','2024-05-01 14:13:00.862000',20009,38125,'0d693807-b61b-ff40-9ea3-51bdbc0f28a9',0,'1','1',NULL,NULL,'2024-05-01 14:13:00.854000',NULL,'image/png','img1714572778889-2.jpg','','',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,38133,32106,16796623585306,20122,'Clarity Admin','2024-05-01 14:13:00.844000','2024-05-04 22:12:58.643000',29437,38131,'1a2642b4-4d6e-3689-b1ff-09c698ac9b30',0,'1','1',NULL,NULL,'2024-05-01 14:13:00.000000',NULL,'text/html','Embrace Your Inner Star with Celebrity-Inspired Eyewear','','Celebrities are often at the forefront of fashion, and eyewear is no exception. From the red carpet to the street, stars are constantly showing us how to make a statement with a pair of glasses or sunglasses. Whether it''s Gigi Hadid''s trendy oversized frames or Johnny Depp''s quirky round glasses, there''s a celebrity eyewear inspiration for everyone. What''s more, these trends aren''t just for the rich and famous. With so many affordable and stylish options available, anyone can embrace their...',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,38140,32106,16796623585306,20122,'Clarity Admin','2024-05-01 14:14:03.968000','2024-05-01 14:14:03.975000',20009,38138,'5d638fae-ea50-bbf5-af59-cfd992283783',0,'1','1',NULL,NULL,'2024-05-01 14:14:03.968000',NULL,'image/png','img1714572841921-0.jpg','','',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,38146,32106,16796623585306,20122,'Clarity Admin','2024-05-01 14:14:03.963000','2024-05-04 22:10:46.727000',29437,38144,'0647513d-69fa-6559-5138-82ce2b90cf8d',0,'1','1',NULL,NULL,'2024-05-01 14:14:00.000000',NULL,'text/html','Choosing the Right Frame Shape for Your Face: A Guide to Understanding Face Shapes','','Choosing the appropriate frame shape for your face is an essential aspect of selecting eyewear. With the right frame shape, you can accentuate your features and enhance your overall appearance. It is crucial to understand different face shapes and how they correspond to different frame styles. This guide will walk you through the process of identifying your face shape and pairing it with the most flattering eyewear. The right shape for you Choosing the appropriate frame shape for your face is...',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,38153,32106,16796623585306,20122,'Clarity Admin','2024-05-01 14:14:18.997000','2024-05-01 14:14:19.003000',20009,38151,'2ae481d5-a3a7-af5d-79b0-96dabe5fde5c',0,'1','1',NULL,NULL,'2024-05-01 14:14:18.997000',NULL,'image/png','img1714572857150-1.jpg','','',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,38159,32106,16796623585306,20122,'Clarity Admin','2024-05-01 14:14:18.992000','2024-05-04 22:18:26.885000',29437,38157,'d43a3e7a-0025-94ca-07e9-07adc4417924',0,'1','1',NULL,NULL,'2024-05-01 14:14:00.000000',NULL,'text/html','How to Identify Your Face Shape','','Everyone''s face is unique, but they can be broadly categorized into six basic shapes: oval, round, square, heart, diamond, and rectangle. By examining your forehead, cheekbones, jawline, and face length, you can determine your face shape. Once you have this information, you can start exploring the world of eyewear and select the frames that complement your face shape the most. The many difference faces, so to speak Everyone''s face is unique, but they can be broadly categorized into six basic...',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,38166,32106,16796623585306,20122,'Clarity Admin','2024-05-01 14:14:30.279000','2024-05-01 14:14:30.289000',20009,38164,'95f29a9d-5858-b888-b203-a940bbf5a9df',0,'1','1',NULL,NULL,'2024-05-01 14:14:30.279000',NULL,'image/png','img1714572868381-2.jpg','','',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,38172,32106,16796623585306,20122,'Clarity Admin','2024-05-01 14:14:30.273000','2024-05-04 22:21:16.142000',29437,38170,'719c6bf7-dced-e23c-a48f-76a4b5a384b4',0,'1','1',NULL,NULL,'2024-05-01 14:14:00.000000',NULL,'text/html','Matching Frame Shapes to Your Face','','Not all frames are suitable for every face shape. For instance, round faces generally look best with rectangular or square frames, as they help to make the face appear longer and slimmer. Alternatively, square faces often benefit from round or oval eyeglasses that help soften the angularity. Understanding these complementary relationships will help you make informed choices. Not all frames are suitable for every face shape. For instance, round faces generally look best with rectangular or...',NULL,NULL,0,0,0.0E0)
