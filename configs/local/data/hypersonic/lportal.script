INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2322,16796623585306,1765,45235,'name','en_US','','"leader-chelsea-lane.png"')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2323,16796623585306,1765,45235,'width','en_US','','"290"')
