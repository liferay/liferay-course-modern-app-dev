INSERT INTO FRAGMENTENTRYLINK VALUES(5,0,'112c6e35-c9fa-954e-67e0-1975ae52aed3',34355,32106,16796623585306,20122,'Clarity Admin','2024-05-20 20:50:02.783000','2024-08-30 00:01:24.464000',34337,20,32486,20031,35,35,'.values{\u000a  display: flex;  \u000a}\u000a\u000a.value-card{\u000a  display: flex;\u000a  flex-direction: column;\u000a  justify-content: center;\u000a  align-items: center;\u000a\u0009padding: 32px;\u000a  width: 100%;\u000a  height: 148px;\u000a\u0009gap: 16px;\u000a  background: #F7EBD9;\u000a  border-radius: 12px;\u000a\u0009isolation: isolate;\u000a  overflow: hidden;\u000a  position: relative;\u000a}\u000a\u000a.value-card-circle{\u000a  position: absolute;\u000a\u0009background: linear-gradient(227.52deg, #F7EBD9 12.01%, #FBE0B9 85.9%);\u000a  box-shadow: 0px -2px 12px rgba(193, 137, 51, 0.2);\u000a  border-radius: 999px;\u000a\u0009opacity: 50%;\u000a}\u000a\u000a/* large watermark positions */\u000a\u000a.value-card-circle-lg{\u000a  width: 142px;\u000a  height: 142px;\u000a\u000a}\u000a\u000a.value-card-circle-lg-br{\u000a  bottom: -80px;\u000a  right: -85px;\u000a}\u000a\u000a.value-card-circle-lg-bl{\u000a  bottom: -80px;\u000a  left: -85px;\u000a}\u000a\u000a.value-card-circle-lg-tr{\u000a  top: -80px;\u000a  right: -60px;\u000a}\u000a\u000a.value-card-circle-lg-tl{\u000a  top: -80px;\u000a  left: -100px;\u000a}\u000a\u000a/* small watermark positions */\u000a\u000a.value-card-circle-sm{\u000a  width: 95px;\u000a  height: 95px;\u000a}\u000a\u000a.value-card-circle-sm-br{\u000a  bottom: -20px;\u000a  right: -60px;\u000a}\u000a\u000a.value-card-circle-sm-bl{\u000a  bottom: -20px;\u000a  left: -60px;\u000a}\u000a\u000a.value-card-circle-sm-tr{\u000a  bottom: -20px;\u000a  right: -60px;\u000a}\u000a\u000a.value-card-circle-sm-tl{\u000a  bottom: -20px;\u000a  left: -60px;\u000a}','<div class="values text-center">\u000a  <div class="value-card value-card-color">\u000a\u0009\u0009   <lfr-drop-zone></lfr-drop-zone>\u000a \u0009</div>\u000a\u0009\u0009[#if configuration.topRight]\u000a\u0009   <div \u000a\u0009\u0009\u0009\u0009\u0009class="value-card-circle \u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009 value-card-circle-${configuration.circleSize} \u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009 value-card-circle-lg-tr"\u000a\u0009\u0009\u0009>\u000a\u0009    </div> \u000a\u0009[/#if]\u000a\u0009\u000a\u0009[#if configuration.bottomRight]\u000a\u0009\u0009   <div \u000a\u0009\u0009\u0009\u0009\u0009class="value-card-circle \u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009 value-card-circle-${configuration.circleSize} \u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009 value-card-circle-lg-br"\u000a\u0009\u0009\u0009>\u000a\u0009\u0009  </div>\u000a\u0009[/#if]\u000a\u0009\u000a\u0009[#if configuration.bottomLeft]\u000a\u0009   <div \u000a\u0009\u0009\u0009\u0009\u0009class="value-card-circle \u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009 value-card-circle-${configuration.circleSize} \u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009 value-card-circle-lg-bl"\u000a\u0009\u0009\u0009>\u000a\u0009    </div>\u000a\u0009[/#if]\u000a\u0009\u000a\u0009[#if configuration.topLeft]\u000a\u0009   <div \u000a\u0009\u0009\u0009\u0009\u0009class="value-card-circle \u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009 value-card-circle-${configuration.circleSize} \u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009 value-card-circle-lg-tl"\u000a\u0009\u0009\u0009>\u000a\u0009    </div>\u0009\u0009\u0009 \u000a\u0009[/#if]\u0009\u000a</div>','','{\u000a    "fieldSets": [\u000a\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009 "fields": [\u000a                {\u000a                    "dataType": "string",\u000a                    "defaultValue": false,\u000a                    "description": "Size of watermark circle",\u000a                    "label": "Size",\u000a                    "typeOptions": {\u000a                        "validValues": [\u000a                            {\u000a 