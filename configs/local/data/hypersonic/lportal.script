INSERT INTO FRAGMENTENTRYLINK VALUES(6,0,'e368a290-5ac1-4575-087f-ca44a0678b8b',34521,32106,16796623585306,20122,'Clarity Admin','2024-05-20 20:56:56.453000','2024-08-22 21:18:21.447000',34511,6,32588,20031,45,45,'','<div class="component-button text-break">\u000a\u0009<a class="btn ${configuration.buttonSize} btn-style-${configuration.style} btn-${configuration.type} [#if configuration.inverted]btn-inverted[/#if] [#if configuration.uppercase]text-uppercase[/#if]" data-lfr-editable-id="link" data-lfr-editable-type="link" href="" id="fragment-${fragmentEntryLinkNamespace}-link">\u000a\u0009\u0009<span data-lfr-editable-id="text" data-lfr-editable-type="text" id="fragment-${fragmentEntryLinkNamespace}-label">Go Somewhere</span>\u000a\u0009\u0009<span id="fragment-${fragmentEntryLinkNamespace}-icon" class="ml-2">\u000a\u0009\u0009[@clay["icon"] symbol="${configuration.iconName}" /]\u000a\u0009</span>\u000a\u0009</a>\u0009\u000a</div>','/**\u000a * SPDX-FileCopyrightText: (c) 2000 Liferay, Inc. https://liferay.com\u000a * SPDX-License-Identifier: LGPL-2.1-or-later OR LicenseRef-Liferay-DXP-EULA-2.0.0-2023-06\u000a */','{\u000a\u0009"fieldSets": [\u000a\u0009\u0009{\u000a\u0009\u0009\u0009"fields": [\u000a\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009"dataType": "string",\u000a\u0009\u0009\u0009\u0009\u0009"defaultValue": "solid",\u000a\u0009\u0009\u0009\u0009\u0009"label": "type",\u000a\u0009\u0009\u0009\u0009\u0009"name": "type",\u000a\u0009\u0009\u0009\u0009\u0009"type": "select",\u000a\u0009\u0009\u0009\u0009\u0009"typeOptions": {\u000a\u0009\u0009\u0009\u0009\u0009\u0009"validValues": [\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"label": "solid",\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "solid"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"label": "ghost",\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "ghost"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"label": "borderless",\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "borderless"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"label": "rounded",\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "rounded"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009\u0009\u0009]\u000a\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009"dataType": "string",\u000a\u0009\u0009\u0009\u0009\u0009"defaultValue": "primary",\u000a\u0009\u0009\u0009\u0009\u0009"label": "style",\u000a\u0009\u0009\u0009\u0009\u0009"name": "style",\u000a\u0009\u0009\u0009\u0009\u0009"type": "select",\u000a\u0009\u0009\u0009\u0009\u0009"typeOptions": {\u000a\u0009\u0009\u0009\u0009\u0009\u0009"validValues": [\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "primary"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "secondary"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "neutral"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009\u0009\u0009]\u000a\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009"dataType": "string",\u000a\u0009\u0009\u0009\u0009\u0009"defaultValue": "",\u000a\u0009\u0009\u0009\u0009\u0009"label": "size",\u000a\u0009\u0009\u0009\u0009\u0009"name": "buttonSize",\u000a\u0009\u0009\u0009\u0009\u0009"type": "select",\u000a\u0009\u0009\u0009\u0009\u0009"typeOptions": {\u000a\u0009\u0009\u0009\u0009\u0009\u0009"validValues": [\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"label": "small",\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "btn-sm"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"label": "medium",\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": ""\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"label": "large",\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "btn-lg"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009\u0009\u0009]\u000a\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009"dataType": "string",\u000a\u0009\u0009\u0009\u0009\u0009"defaultValue": false,\u000a\u0009\u0009\u0009\u0009\u0009"label": "inverted",\u000a\u0009\u0009\u0009\u0009\u0009"name": "inverted",\u000a\u0009\u0009\u0009\u0009\u0009"type": "checkbox"\u000a\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009"dataType": "string",\u000a\u0009\u0009\u0009\u0009\u0009"defaultValue": false,\u000a\u0009\u0009\u0009\u0009\u0009"label": "uppercase",\u000a\u0009\u0009\u0009\u0009\u0009"name": "uppercase",\u000a\u0009\u0009\u0009\u0009\u0009"type": "checkbox"\u000a\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009"dataType": "string",\u000a\u0009\u0009\u0009\u0009\u0009"defaultValue": "share",\u000a\u0009\u0009\u0009\u0009\u0009"label": "Icon Name",\u000a\u0009\u0009\u0009\u0009\u0009"name": "iconName",\u000a\u0009\u0009\u0009\u0009\u0009"type": "text"\u000a\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009]\u000a\u0009\u0009}\u000a\u0009]\u000a}','0','{"com.liferay.fragment.entry.processor.editable.EditableFragmentEntryProcessor":{"link":{"defaultValue":"\n\t\t<span data-lfr-editable-id=\"text\" data-lfr-editable-type=\"text\" id=\"fragment--label\">Go Somewhere<\/span>\n\t\t<span id=\"fragment--icon\" class=\"ml-2\">\n<svg class=\"lexicon-icon lexicon-icon-\" role=\"presentation\" viewbox=\"0 0 512 512\"><use xlink:href=\"http://localhost:8080/o/classic-theme/images/clay/icons.svg#\" /><\/svg>\t<\/span>\n\t","en_US":"Back to Open Positions","config":{"mapperType":"link"}},"text":{"defaultValue":"Go Somewhere","config":{}}},"com.liferay.fragment.entry.processor.freemarker.FreeMarkerFragmentEntryProcessor":{"uppercase":false,"iconName":"","style":"primary","type":"ghost","inverted":false,"buttonSize":""}}','cwjh',0,'dialect-dialect-button',1,'2024-05-20 20:56:47.881000',NULL,'e368a290-5ac1-4575-087f-ca44a0678b8b')
