09\u0009\u0009\u0009\u0009\u0009\u0009"value": "ghost"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"label": "borderless",\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "borderless"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"label": "rounded",\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "rounded"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009\u0009\u0009]\u000a\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009"dataType": "string",\u000a\u0009\u0009\u0009\u0009\u0009"defaultValue": "primary",\u000a\u0009\u0009\u0009\u0009\u0009"label": "style",\u000a\u0009\u0009\u0009\u0009\u0009"name": "style",\u000a\u0009\u0009\u0009\u0009\u0009"type": "select",\u000a\u0009\u0009\u0009\u0009\u0009"typeOptions": {\u000a\u0009\u0009\u0009\u0009\u0009\u0009"validValues": [\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "primary"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "secondary"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "neutral"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009\u0009\u0009]\u000a\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009"dataType": "string",\u000a\u0009\u0009\u0009\u0009\u0009"defaultValue": "",\u000a\u0009\u0009\u0009\u0009\u0009"label": "size",\u000a\u0009\u0009\u0009\u0009\u0009"name": "buttonSize",\u000a\u0009\u0009\u0009\u0009\u0009"type": "select",\u000a\u0009\u0009\u0009\u0009\u0009"typeOptions": {\u000a\u0009\u0009\u0009\u0009\u0009\u0009"validValues": [\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"label": "small",\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "btn-sm"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"label": "medium",\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": ""\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"label": "large",\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "btn-lg"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009\u0009\u0009]\u000a\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009"dataType": "string",\u000a\u0009\u0009\u0009\u0009\u0009"defaultValue": false,\u000a\u0009\u0009\u0009\u0009\u0009"label": "inverted",\u000a\u0009\u0009\u0009\u0009\u0009"name": "inverted",\u000a\u0009\u0009\u0009\u0009\u0009"type": "checkbox"\u000a\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009"dataType": "string",\u000a\u0009\u0009\u0009\u0009\u0009"defaultValue": false,\u000a\u0009\u0009\u0009\u0009\u0009"label": "uppercase",\u000a\u0009\u0009\u0009\u0009\u0009"name": "uppercase",\u000a\u0009\u0009\u0009\u0009\u0009"type": "checkbox"\u000a\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009"dataType": "string",\u000a\u0009\u0009\u0009\u0009\u0009"defaultValue": "share",\u000a\u0009\u0009\u0009\u0009\u0009"label": "Icon Name",\u000a\u0009\u0009\u0009\u0009\u0009"name": "iconName",\u000a\u0009\u0009\u0009\u0009\u0009"type": "text"\u000a\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009]\u000a\u0009\u0009}\u000a\u0009]\u000a}','0','{"com.liferay.fragment.entry.processor.editable.EditableFragmentEntryProcessor":{"link":{"defaultValue":"\n\t\t<span data-lfr-editable-id=\"text\" data-lfr-editable-type=\"text\" id=\"fragment--label\">Go Somewhere<\/span>\n\t\t<span id=\"fragment--icon\" class=\"ml-2\">\n<svg class=\"lexicon-icon lexicon-icon-\" role=\"presentation\" viewbox=\"0 0 512 512\"><use xlink:href=\"http://localhost:8080/o/classic-theme/images/clay/icons.svg#\" /><\/svg>\t<\/span>\n\t","en_US":"Learn More","config":{"mapperType":"link"}},"text":{"defaultValue":"Go Somewhere","config":{"mapperType":"link"}}},"com.liferay.fragment.entry.processor.freemarker.FreeMarkerFragmentEntryProcessor":{"uppercase":false,"iconName":"","style":"primary","type":"solid","inverted":true,"buttonSize":""}}','wrmf',1,'dialect-dialect-button',1,'2024-08-28 19:04:27.573000',NULL,'bf9d17ab-361a-247e-15bc-c81e4fdac871')
