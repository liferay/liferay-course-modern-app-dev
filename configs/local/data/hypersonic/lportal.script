INSERT INTO O_16796623585306_TICKET VALUES(67913,0,'No, we don\u2019t have any retail stores because we make the digital\u000aexperience even better.','critical',0,'lATAM',NULL,'Do you have any retail stores?',NULL,'open','other')
INSERT INTO O_16796623585306_TICKET VALUES(67915,0,'All our glasses and sunglasses are a Standard Size. For the majority of\u000apeople, this Standard Size is the correct fit on the face.','major',0,'lATAM',NULL,'How do I measure eyeglasses or sunglasses?',NULL,'open','other')
INSERT INTO O_16796623585306_TICKET VALUES(67917,0,'I need to understand what''s the process for sending my glassess to a\u000areview as they have different problems in the side pieces.','moderate',0,'aPAC',NULL,'Asking for help related to my glasses, model 45TRGR',NULL,'inProgress','other')
