3 -15 -12 -31 -18 -35 -15 -9 -17 -275 -2 -286 6 -4 19 -25 30 -47 27 -54 119 -142 175 -166 25 -11 54 -24 65 -29 11 -5 62 -17 113 -26 86 -15 98 -15 180 1 48 9 101 23 119 31 17 8 38 14 47 14 9 0 16 5 16 10 0 6 5 10 11 10 12 0 82 54 115 88 12 12 24 22 28 22 3 0 6 -36 6 -80 l0 -80 151 0 151 0 -5 483 c-4 453 -5 485 -24 532 -48 121 -64 146 -130 211 -52 52 -181 124 -220 124 -10 0 -23 4 -28 9 -14 12 -207 20 -280 11z m263 -750 c10 -4 40 -12 67 -17 l50 -8 3 -100 c2 -65 -2 -109 -10 -125 -19 -39 -89 -103 -149 -135 -49 -26 -65 -29 -175 -33 -103 -3 -128 -1 -160 14 -48 23 -89 58 -114 100 -26 42 -28 148 -3 184 25 37 70 80 82 80 6 0 11 4 11 10 0 5 12 13 28 16 15 4 32 10 37 14 6 5 24 11 40 13 44 8 274 -3 293 -13z"&gt; &lt;/path&gt; &lt;path d="M4720 1903 c-44 -4 -138 -33 -165 -50 -11 -7 -27 -13 -37 -13 -10 0 -18 -4 -18 -8 0 -5 -20 -22 -45 -40 -24 -17 -58 -50 -74 -74 -17 -24 -35 -48 -41 -55 -5 -7 -10 -17 -10 -23 0 -5 -4 -10 -10 -10 -6 0 -10 47 -10 120 l0 120 -155 0 -155 0 0 -670 0 -670 155 0 155 0 0 394 c0 416 -2 399 47 506 17 37 77 100 131 138 63 44 121 64 270 89 l32 5 0 124 c0 112 -2 124 -17 122 -10 0 -34 -3 -53 -5z"&gt; &lt;/path&gt; &lt;path d="M5020 1200 l0 -670 150 0 150 0 0 670 0 670 -150 0 -150 0 0 -670z"&gt;&lt;/path&gt; &lt;path d="M6572 1838 c6 -18 14 -37 18 -43 4 -5 11 -25 15 -42 3 -18 11 -33 15 -33 5 0 12 -17 16 -37 4 -21 10 -40 13 -43 13 -11 41 -73 41 -91 0 -10 4 -19 9 -19 5 0 12 -14 16 -31 4 -17 13 -42 21 -57 8 -15 14 -33 14 -39 0 -7 5 -13 10 -13 6 0 10 -6 10 -14 0 -8 14 -44 30 -81 17 -37 30 -73 30 -81 0 -8 4 -14 9 -14 5 0 12 -18 16 -40 4 -22 11 -40 16 -40 5 0 9 -5 9 -11 0 -5 11 -35 25 -64 13 -30 27 -66 31 -80 3 -14 10 -25 14 -25 5 0 11 -18 15 -40 4 -22 11 -40 16 -40 5 0 9 -5 9 -11 0 -12 22 -66 46 -112 8 -16 14 -37 14 -48 0 -10 5 -19 10 -19 6 0 10 -6 10 -12 0 -7 6 -25 14 -40 8 -15 17 -40 21 -57 4 -17 10 -33 15 -36 5 -3 -2 -26 -15 -52 -14 -25 -25 -51 -25 -57 0 -12 -32 -48 -70 -79 -12 -10 -45 -22 -73 -27 -57 -9 -180 5 -185 20 -2 6 -11 10 -21 10 -11 0 -21 -15 -30 -47 -7 -27 -20 -70 -28 -96 -8 -26 -13 -54 -10 -61 7 -17 120 -56 164 -56 18 0 33 -4 33 -10 0 -6 32 -10 75 -10 43 0 75 4 75 10 0 6 13 10 29 10 26 0 89 24 136 53 73 44 202 225 220 307 4 16 11 32 16 35 5 4 9 13 9 21 0 9 11 40 25 69 13 30 27 66 31 80 3 14 10 25 14 25 5 0 11 18 15 40 4 22 11 40 16 40 5 0 9 8 9 18 0 9 7 30 15 46 8 15 15 33 15 40 0 6 14 38 30 71 16 33 30 65 30 71 0 7 7 25 15 40 8 16 15 36 15 45 0 8 4 19 8 25 5 5 24 50 42 99 18 50 36 95 40 100 4 6 15 33 25 60 17 50 31 84 60 149 8 19 15 38 15 43 0 9 20 57 39 93 5 9 12 30 16 48 3 18 11 32 16 32 5 0 9 10 9 23 0 12 6 31 14 42 7 11 16 32 20 48 l7 28 -158 -3 -157 -3 -9 -42 c-4 -24 -12 -43 -18 -43 -5 0 -9 -9 -9 -21 0 -12 -6 -35 -14 -52 -7 -18 -21 -54 -31 -82 -9 -27 -23 -64 -31 -82 -8 -17 -14 -38 -14 -47 0 -9 -4 -16 -9 -16 -5 0 -12 -16 -15 -35 -4 -19 -13 -47 -21 -62 -8 -15 -15 -34 -15 -41 0 -7 -4 -20 -9 -30 -18 -35 -38 -89 -57 -149 -10 -35 -22 -63 -26 -63 -5 0 -8 -7 -8 -16 0 -9 -6 -30 -14 -47 -8 -18 -16 -41 -19 -52 -16 -60 -45 -115 -61 -115 -3 0 -9 18 -12 40 -4 22 -10 40 -13 40 -4 0 -16 24 -26 53 -10 28 -25 63 -32 77 -7 14 -13 33 -13 43 0 9 -4 17 -9 17 -5 0 -12 18 -16 40 -4 22 -10 40 -15 40 -5 0 -11 19 -15 43 -4 23 -11 44 -14 47 -9 7 -41 75 -41 88 0 5 -7 23 -15 38 -8 16 -15 37 -15 47 0 9 -4 17 -9 17 -5 0 -12 18 -16 40 -4 22 -10 40 -13 40 -4 0 -13 19 -20 42 -7 23 -22 61 -33 85 -10 23 -19 49 -19 57 0 9 -4 16 -9 16 -5 0 -11 14 -15 32 -11 57 -15 58 -182 58 l-153 0 11 -32z"&gt; &lt;/path&gt; &lt;/g&gt; &lt;/svg&gt;\u000a&lt;h1&gt;We have received your application!&lt;/h1&gt;\u000a\u000a&lt;h1&gt;A representative will contact you shortly.&lt;/h1&gt;\u000a\u000a&lt;p style="margin-bottom: 2.6rem; margin-top: 1.6rem"&gt;To review your application, click the button below.&lt;/p&gt;\u000a&lt;a href="[%???%]" onmouseout="this.style.backgroundColor=''#4c85ff''" onmouseover="this.style.backgroundColor=''#295ccc''" style="background-color: rgb(76, 133, 255); border: 0px none; border-radius: 4px; color: white; font-weight: bold; height: 56px; text-decoration: none; padding: 16px 18px; text-transform: uppercase; width: 168px;"&gt; View Application &lt;/a&gt;&lt;/main&gt;\u000a</Body></root>','Sends email notifications to applicants to indicate their applications have been received.','richText','D4B8 Application Received, Applicant, Email','email','<?xml version="1.0" ?><root available-locales="en_US" default-locale="en_US"><Subject language-id="en_US">Thank you for submitting your application!</Subject></root>','0','email')
INSERT INTO NOTIFICATIONTEMPLATE VALUES(0,'0dfacec8-f098-00dc-fa2f-ffc303eb6b68','L_COMMERCE_ORDER_TEMPLATE',61801,16796623585306,20122,'Clarity Admin','2025-03-06 12:55:12.890000','2025-03-06 12:55:12.890000',0,'<?xml version="1.0" ?><root available-locales="en_US" default-locale="en_US"><Body language-id="en_US">&lt;html&gt;\u000a&lt;head&gt;\u000a\u0009&lt;meta content="width=device-width, initial-scale=1" name="viewport" /&gt;\u000a\u0009&lt;style type="text/css"&gt;\u000a\u0009\u0009html, body {\u000a\u0009\u0009\u0009background-color: #FFF;\u000a\u0009\u0009\u0009color: #272833;\u000a\u0009\u0009\u0009margin: 0;\u000a\u0009\u0009\u0009padding: 0;\u000a\u0009\u0009\u0009width: 100%;\u000a\u0009\u0009}\u000a\u0009\u0009.banner {\u000a\u0009\u0009\u0009background: linear-gradient(120deg, #011181 0%,#0c6297 45%,#0c6297 50%,#7eefec 100%);\u000a\u0009\u0009\u0009border-radius: 8px 8px 0 0;\u000a\u0009\u0009\u0009height: 56px;\u000a\u0009\u0009}\u000a\u0009\u0009.container {\u000a\u0009\u0009\u0009background-color: #F7F8F9;\u000a\u0009\u0009\u0009border-radius: 20px;\u000a\u0009\u0009\u0009box-sizing: border-box;\u000a\u0009\u0009\u0009font-family: ''Roboto'', sans-serif;\u000a\u0009\u0009\u0009font-size: 14px;\u000a\u0009\u0009\u0009margin: 48px auto;\u000a\u0009\u0009\u0009max-width: 640px;\u000a\u0009\u0009\u0009min-width: 320px;\u000a\u0009\u0009\u0009overflow: hidden;\u000a\u0009\u0009\u0009padding: 32px 48px;\u000a\u0009\u0009}\u000a\u0009\u0009.content {\u000a\u0009\u0009\u0009box-sizing: border-box;\u000a\u0009\u0009\u0009margin-top: 14px;\u000a\u0009\u0009}\u000a\u0009\u0009.footer {\u000a\u0009\u0009\u0009color: #6B6C7E;\u000a\u0009\u0009\u0009font-size: 14px;\u000a\u0009\u0009\u0009line-height: 21px;\u000a\u0009\u0009\u0009text-align: center;\u000a\u0009\u0009}\u000a\u0009\u0009.section {\u000a\u0009\u0009\u0009background-color: #FFF;\u000a\u0009\u0009\u0009border-radius: 8px;\u000a\u0009\u0009\u0009margin-bottom: 24px;\u000a\u0009\u0009\u0009overflow: hidden;\u000a\u0009\u0009\u0009padding-bottom: 1px;\u000a\u0009\u0009}\u000a\u0009\u0009.order-address-section, \u000a\u0009\u0009.order-confirmation-section, \u000a\u0009\u0009.order-details-section, \u000a\u0009\u0009.order-items-section {\u000a\u0009\u0009\u0009border-bottom: 1px solid #E7E7ED;\u000a\u0009\u0009\u0009margin: 0 24px;\u000a\u0009\u0009\u0009padding: 0 0 24px;\u000a\u0009\u0009}\u000a\u0009\u0009.order-confirmation-section h3 {\u000a\u0009\u0009\u0009font-size: 18px;\u000a\u0009\u0009\u0009font-weight: 500;\u000a\u0009\u0009\u0009margin: 20px 0;\u000a\u0009\u0009}\u000a\u0009\u0009.help-section h4,\u000a\u0009\u0009.order-address-section h4, \u000a\u0009\u0009.order-details-section h4, \u000a\u0009\u0009.order-items-section h4,\u000a\u0009\u0009.order-items-section h4,\u000a\u0009\u0009.order-items-section th {\u000a\u0009\u0009\u0009font-size: 16px;\u000a\u0009\u0009\u0009font-weight: 600;\u000a\u0009\u0009\u0009margin: 20px 0;\u000a\u0009\u0009\u0009text-align:left;\u000a\u0009\u0009}\u000a\u0009\u0009.help-section {\u000a\u0009\u0009\u0009padding: 1px 24px 8px;\u000a\u0009\u0009}\u000a\u0009\u0009.order-summary-section {\u000a\u0009\u0009\u0009background-color: #F0F5FF;\u000a\u0009\u0009\u0009border-radius: 8px;\u000a\u0009\u0009\u0009margin: 24px;\u000a\u0009\u0009\u0009padding: 24px;\u000a\u0009\u0009\u0009text-align: right;\u000a\u0009\u0009}\u000a\u0009\u0009.order-summary-section div {\u000a\u0009\u0009\u0009line-height: 18px;\u000a\u0009\u0009}\u000a\u0009\u0009.summary-helper {\u000a\u0009\u0009\u0009font-size: 12px;\u000a\u0009\u0009}\u000a\u0009\u0009.order-items,\u000a\u0009\u0009.order-items table {\u000a\u0009\u0009\u0009width: 100%;\u000a\u0009\u0009}\u000a\u0009\u0009.order-item-info th {\u000a\u0009\u0009\u0009margin-bottom: 5px;\u000a\u0009\u0009\u0009text-align:left;\u000a\u0009\u0009}\u000a\u0009\u0009.order-item-price table {\u000a\u0009\u0009\u0009text-align: right;\u000a\u0009\u0009}\u000a\u0009\u0009.order-item-price td {\u000a\u0009\u0009\u0009white-space: nowrap;\u000a\u0009\u0009}\u000a\u0009\u0009.order-item-discount-price {\u000a\u0009\u0009\u0009color:#FF0000;\u000a\u0009\u0009}\u000a\u0009\u0009.order-item-info {\u000a\u0009\u0009\u0009padding-right: 16px;\u000a\u0009\u0009\u0009vertical-align: top;\u000a\u0009\u0009}\u000a\u0009\u0009.order-item-info td {\u000a\u0009\u0009\u0009font-size: 12px;\u000a\u0009\u0009}\u000a\u0009\u0009.order-item-info-label {\u000a\u0009\u0009\u0009display: block;\u000a\u0009\u0009}\u000a\u0009\u0009.order-item-info-label td:first-child {\u000a\u0009\u0009\u0009font-weight: bold;\u000a\u0009\u0009\u0009padding: 0;\u000a\u0009\u0009}\u000a\u0009\u0009.order-item-original-price {\u000a\u0009\u0009\u0009text-decoration: line-through;\u000a\u0009\u0009}\u000a\u0009\u0009.order-item-price {\u000a\u0009\u0009\u0009font-size: 16px;\u000a\u0009\u0009\u0009font-weight: bold;\u000a\u0009\u0009\u0009vertical-align: top;\u000a\u0009\u0009}\u000a\u0009\u0009.order-item-title {\u000a\u0009\u0009\u0009font-size: 16px;\u000a\u0009\u0009\u0009padding: 0px;\u000a\u0009\u0009\u0009text-align: left;\u000a\u0009\u0009}\u000a\u0009\u0009.order-items {\u000a\u0009\u0009\u0009border-collapse: inherit;\u000a\u0009\u0009\u0009border-spacing: 0 16px;\u000a\u0009\u0009\u0009text-align: left;\u000a\u0009\u0009}\u000a\u0009\u0009@media only screen and (max-width: 640px) {\u000a\u0009\u0009\u0009.container { \u000a\u0009\u0009\u0009\u0009margin: 0 auto !important;\u000a\u0009\u0009\u0009\u0009padding: 24px !important;\u000a\u0009\u0009\u0009}\u000a\u0009\u0009\u0009.order-items .order-item-img {\u000a\u0009\u0009\u0009\u0009height: 60px !important;\u000a\u0009\u0009\u0009\u0009vertical-align: top !important;\u000a\u0009\u0009\u0009\u0009width: 60px !important;\u000a\u0009\u0009\u0009}\u000a\u0009\u0009\u0009.order-items .order-item-img img {\u000a\u0009\u0009\u0009\u0009max-height: 60px !important;\u000a\u0009\u0009\u0009\u0009max-width: 60px !important;\u000a\u0009\u0009\u0009}\u000a\u0009\u0009\u0009.order-item-info {\u000a\u0009\u0009\u0009\u0009max-width: 80% !important;\u000a\u0009\u0009\u0009}\u000a\u0009\u0009}\u000a\u0009&lt;/style&gt;&lt;/head&gt;&lt;body&gt;\u000a\u0009\u0009&lt;div class="container"&gt;\u000a\u0009\u0009\u0009&lt;div class="content"&gt;\u000a\u0009\u0009\u0009\u0009&lt;div class="section"&gt;\u000a\u0009\u0009\u0009\u0009\u0009&lt;div class="banner"&gt;&amp;nbsp;&lt;/div&gt;\u000a\u000a\u0009\u0009\u0009\u0009\u0009&lt;div class="order-confirmation-section"&gt;\u000a\u0009\u0009\u0009\u0009\u0009\u0009&lt;h3&gt;Order confirmation&lt;/h3&gt;\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009&lt;div&gt;Hi, [%COMMERCEORDER_AUTHOR_PREFIX%] &lt;b&gt;[%COMMERCEORDER_AUTHOR_FIRST_NAME%] [%COMMERCEORDER_AUTHOR_LAST_NAME%]&lt;/b&gt; [%COMMERCEORDER_AUTHOR_SUFFIX%]&lt;br /&gt;\u000a\u0009\u0009\u0009\u0009\u0009\u0009Thank you for your order! Here is your order summary and delivery details. We will prepare your order as soon as possible and you will receive another email when it has been shipped.&lt;/div&gt;\u000a\u0009\u0009\u0009\u0009\u0009&lt;/div&gt;\u000a\u000a\u0009\u0009\u0009\u0009\u0009&lt;div class="order-details-section"&gt;\u000a\u0009\u0009\u0009\u0009\u0009\u0009&lt;h4&gt;Order details&lt;/h4&gt;\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009&lt;div&gt;\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009&lt;div&gt;&lt;b&gt;Order Number&lt;/b&gt;: #[%COMMERCEORDER_ID%]&lt;/div&gt;\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009&lt;div&gt;&lt;b&gt;Order Date&lt;/b&gt;: [%COMMERCEORDER_ORDERDATE%]&lt;/div&gt;\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009&lt;div&gt;&lt;b&gt;Account&lt;/b&gt;: [%COMMERCEORDER_ACCOUNT_NAME%] - #[%COMMERCEORDER_ACCOUNTID%]&lt;/div&gt;\u000a\u0009\u0009\u0009\u0009\u0009\u0009&lt;/div&gt;\u000a\u0009\u0009\u0009\u0009\u0009&lt;/div&gt;\u000a\u000a\u0009\u0009\u0009\u0009\u0009&lt;div class="order-address-section"&gt;\u000a\u0009\u0009\u0009\u0009\u0009\u0009&lt;h4&gt;Address&lt;/h4&gt;\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009&lt;div&gt;\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009&lt;div&gt;&lt;b&gt;Billing Address&lt;/b&gt;: [%COMMERCEORDER_BILLING_ADDRESS_STREET1%] [%COMMERCEORDER_BILLING_ADDRESS_STREET2%] [%COMMERCEORDER_BILLING_ADDRESS_STREET3%], [%COMMERCEORDER_BILLING_ADDRESS_ZIP%] [%COMMERCEORDER_BILLING_ADDRESS_CITY%], [%COMMERCEORDER_BILLING_ADDRESS_REGION%] [%COMMERCEORDER_BILLING_ADDRESS_COUNTRY%]&lt;/div&gt;\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009&lt;div&gt;&lt;b&gt;Shipping Address&lt;/b&gt;: [%COMMERCEORDER_SHIPPING_ADDRESS_STREET1%] [%COMMERCEORDER_SHIPPING_ADDRESS_STREET2%] [%COMMERCEORDER_SHIPPING_ADDRESS_STREET3%], [%COMMERCEORDER_SHIPPING_ADDRESS_ZIP%] [%COMMERCEORDER_SHIPPING_ADDRESS_CITY%], [%COMMERCEORDER_SHIPPING_ADDRESS_REGION%] [%COMMERCEORDER_SHIPPING_ADDRESS_COUNTRY%]&lt;/div&gt;\u000a\u0009\u0009\u0009\u0009\u0009\u0009&lt;/div&gt;\u000a\u0009\u0009\u0009\u0009\u0009&lt;/div&gt;\u000a\u000a\u0009\u0009\u0009\u0009\u0009&lt;div class="order-items-section"&gt;\u000a\u0009\u0009\u0009\u0009\u0009\u0009&lt;div&gt;[%COMMERCEORDER_ORDER_ITEMS%]&lt;/div&gt;\u000a\u0009\u0009\u0009\u0009\u0009&lt;/div&gt;\u000a\u000a\u0009\u0009\u0009\u0009\u0009&lt;div class="order-summary-section"&gt;\u000a\u0009\u0009\u0009\u0009\u0009\u0009&lt;div&gt;&lt;b&gt;Total: [%COMMERCEORDER_TOTALFORMATTED%]&lt;/b&gt;&lt;/div&gt;\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009&lt;div class="summary-helper"&gt;Including Tax&lt;/div&gt;\u000a\u0009\u0009\u0009\u0009\u0009&lt;/div&gt;\u000a\u0009\u0009\u0009\u0009&lt;/div&gt;\u000a\u0009\u0009\u0009&lt;/div&gt;\u000a\u000a\u0009\u0009\u0009&lt;div class="section"&gt;\u000a\u0009\u0009\u0009\u0009&lt;div class="help-section"&gt;\u000a\u0009\u0009\u0009\u0009\u0009&lt;h4&gt;Do you need help?&lt;/h4&gt;\u000a\u000a\u0009\u0009\u0009\u0009\u0009&lt;p&gt;If you have any questions, please contact us.&lt;/p&gt;\u000a\u0009\u0009\u0009\u0009&lt;/div&gt;\u000a\u0009\u0009\u0009&lt;/div&gt;\u000a\u000a\u0009\u0009\u0009&lt;div class="footer"&gt;\u000a\u0009\u0009\u0009\u0009&lt;div&gt;Copyright \u00a9 2024&lt;/div&gt;\u000a\u0009\u0009\u0009&lt;/div&gt;\u000a\u0009\u0009&lt;/div&gt;\u000a\u0009&lt;/body&gt;\u000a\u0009&lt;/html&gt;</Body></root>',NULL,'richText','Commerce Order Notification','email','<?xml version="1.0" ?><root available-locales="en_US" default-locale="en_US"><Subject language-id="en_US">Order #[%COMMERCEORDER_ID%]</Subject></root>','0','email')
