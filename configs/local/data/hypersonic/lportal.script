ue": "4"\u000a                            },\u000a                            {\u000a                                "label": "H5",\u000a                                "value": "5"\u000a                            },\u000a                            {\u000a                                "label": "H6",\u000a                                "value": "6"\u000a                            }\u000a                        ]\u000a                    }\u000a                }\u000a            ]\u000a        }\u000a    ]\u000a}','code',0,'0',1,'',NULL,0,20122,'Clarity Admin','2024-06-03 10:21:06.419000','b4e0cc56-b50d-424c-e3c4-02eec60d8352')
