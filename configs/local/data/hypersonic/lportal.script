\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009dayValue=customFacetCalendarDisplayContext.getFromDayValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009disabled=false\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009firstDayOfWeek=customFacetCalendarDisplayContext.getFromFirstDayOfWeek()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009monthParam="fromMonth"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009monthValue=customFacetCalendarDisplayContext.getFromMonthValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="fromInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009yearParam="fromYear"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009yearValue=customFacetCalendarDisplayContext.getFromYearValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</@>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009<div class="col-md-6" id="${namespace}customRangeTo">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_aui["field-wrapper"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009label="to"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="toInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_ui["input-date"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009cssClass="custom-range-input-date-to"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009dayParam="toDay"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009dayValue=customFacetCalendarDisplayContext.getToDayValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009disabled=false\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009firstDayOfWeek=customFacetCalendarDisplayContext.getToFirstDayOfWeek()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009monthParam="toMonth"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009monthValue=customFacetCalendarDisplayContext.getToMonthValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="toInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009yearParam="toYear"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009yearValue=customFacetCalendarDisplayContext.getToYearValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</@>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009<@clay["button"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009cssClass="custom-range-filter-button"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009disabled=customFacetCalendarDisplayContext.isRangeBackwards()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009displayType="secondary"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009id="${namespace + ''searchCustomRangeButton''}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009label="search"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="${namespace + ''searchCustomRangeButton''}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009\u0009</#if>\u000a\u0009\u0009\u0009</#if>\u000a\u0009\u0009</ul>\u000a\u0009</@>\u000a</@>',0,20095,NULL,'2025-03-06 12:56:36.237000')
INSERT INTO DDMTEMPLATEVERSION VALUES(0,0,64890,20119,16796623585306,20095,NULL,'2025-03-06 12:56:36.242000',31631,0,31632,'1.2','<?xml version="1.0" ?><root available-locales="en_US,sv_SE,pt_BR,ja_JP,fr_FR,hu_HU,de_DE,ca_ES,ar_SA,fi_FI,zh_CN,es_ES,nl_NL" default-locale="en_US"><Name language-id="en_US">Compact Layout (Multiselect)</Name><Name language-id="ar_SA">\u062a\u062e\u0637\u064a\u0637 \u0635\u063a\u064a\u0631 (\u062a\u062d\u062f\u064a\u062f \u0645\u062a\u0639\u062f\u062f)</Name><Name language-id="ca_ES">Disposici\u00f3 compacta (selecci\u00f3 m\u00faltiple)</Name><Name language-id="zh_CN">\u7d27\u51d1\u5e03\u5c40\uff08\u591a\u9009\uff09</Name><Name language-id="nl_NL">Compacte lay-out (meervoudige selectie)</Name><Name language-id="fi_FI">Tiivis asettelu (monivalinta)</Name><Name language-id="fr_FR">Disposition compacte (s\u00e9lection multiple)</Name><Name language-id="de_DE">Kompaktes Layout (Mehrfachauswahl)</Name><Name language-id="hu_HU">Kompakt elrendez\u00e9s (t\u00f6bbv\u00e1laszt\u00f3s)</Name><Name language-id="ja_JP">\u30b3\u30f3\u30d1\u30af\u30c8\u30ec\u30a4\u30a2\u30a6\u30c8 (\u8907\u6570\u9078\u629e)</Name><Name language-id="pt_BR">Layout compacto (Multisele\u00e7\u00e3o)</Name><Name language-id="es_ES">Dise\u00f1o compacto (selecci\u00f3n m\u00faltiple)</Name><Name language-id="sv_SE">Kompakt layout (flera val)</Name></root>','<?xml version="1.0" ?><root available-locales="en_US,sv_SE,pt_BR,ja_JP,fr_FR,hu_HU,de_DE,ca_ES,ar_SA,fi_FI,zh_CN,es_ES,nl_NL" default-locale="en_US"><Description language-id="en_US">Display terms as a list of links.</Description><Description language-id="ar_SA">\u0639\u0631\u0636 \u0627\u0644\u0645\u0635\u0637\u0644\u062d\u0627\u062a \u0643\u0642\u0627\u0626\u0645\u0629 \u0645\u0646 \u0627\u0644\u0631\u0648\u0627\u0628\u0637.</Description><Description language-id="ca_ES">Mostra els termes com una llista d''enlla\u00e7os.</Description><Description language-id="zh_CN">\u5c06\u641c\u7d22\u8bcd\u663e\u793a\u4e3a\u94fe\u63a5\u5217\u8868\u3002</Description><Description language-id="nl_NL">Termen weergeven als een lijst met links.</Description><Description language-id="fi_FI">N\u00e4yt\u00e4 termit linkkien luettelona.</Description><Description language-id="fr_FR">Afficher les termes sous la forme de liste de liens.</Description><Description language-id="de_DE">Begriffe als Linkliste anzeigen.</Description><Description language-id="hu_HU">Jelen\u00edtse meg a kifejez\u00e9seket hivatkoz\u00e1sok list\u00e1jak\u00e9nt.</Description><Description language-id="ja_JP">\u7528\u8a9e\u3092\u30ea\u30f3\u30af\u30ea\u30b9\u30c8\u3068\u3057\u3066\u8868\u793a\u3057\u307e\u3059\u3002</Description><Description language-id="pt_BR">Exibir termos como uma lista de links.</Description><Description language-id="es_ES">Muestra t\u00e9rminos como una lista de enlaces.</Description><Description language-id="sv_SE">Visa villkoren som en lista med l\u00e4nkar.</Description></root>','ftl','<@liferay_ui["panel-container"]\u000a\u0009extended=true\u000a\u0009id="${namespace + ''facetCustomPanelContainer''}"\u000a\u0009markupView="lexicon"\u000a\u0009persistState=true\u000a>\u000a\u0009<@liferay_ui.panel\u000a\u0009\u0009collapsible=true\u000a\u0009\u0009cssClass="search-facet"\u000a\u0009\u0009id="${namespace + ''facetCustomPanel''}"\u000a\u0009\u0009markupView="lexicon"\u000a\u0009\u0009persistState=true\u000a\u0009\u0009title="${customFacetDisplayContext.getDisplayCaption()}"\u000a\u0009>\u000a\u0009\u0009<#if !customFacetDisplayContext.isNothingSelected()>\u000a\u0009\u0009\u0009<@clay.button\u000a\u0009\u0009\u0009\u0009cssClass="btn-unstyled c-mb-4 facet-clear-btn"\u000a\u0009\u0009\u0009\u0009displayType="link"\u000a\u0009\u0009\u0009\u0009id="${namespace + ''facetCustomClear''}"\u000a\u0009\u0009\u0009\u0009onClick="Liferay.Search.FacetUtil.clearSelections(event);"\u000a\u0009\u0009\u0009>\u000a\u0009\u0009\u0009\u0009<strong>${languageUtil.get(locale, "clear")}</strong>\u000a\u0009\u0009\u0009</@clay.button>\u000a\u0009\u0009</#if>\u000a\u000a\u0009\u0009<ul class="list-unstyled">\u000a\u0009\u0009\u0009<#if entries?has_content>\u000a\u0009\u0009\u0009\u0009<#list entries as entry>\u000a\u0009\u0009\u0009\u0009\u0009<li>\u000a\u0009\u0009\u0009\u0009\u0009\u0009<@clay.button\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009cssClass="facet-term btn-unstyled ${(entry.isSelected())?then(''facet-term-selected'', ''facet-term-unselected'')} term-name"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009data\-term\-id="${entry.getBucketText()}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009disabled="true"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009displayType="link"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009onClick="Liferay.Search.FacetUtil.changeSelection(event);"\u000a\u0009\u0009\u0009\u0009\u0009\u0009>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if entry.isSelected()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<strong><@liferay_ui["message"] key="${htmlUtil.escape(entry.getBucketText())}" /></strong>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#else>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_ui["message"] key="${htmlUtil.escape(entry.getBucketText())}" />\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if entry.isFrequencyVisible()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<small class="term-count">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009(${entry.getFrequency()})\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</small>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</@clay.button>\u000a\u0009\u0009\u0009\u0009\u0009</li>\u000a\u0009\u0009\u0009\u0009</#list>\u000a\u0009\u0009\u0009</#if>\u000a\u000a\u0009\u0009\u0009<#if customFacetDisplayContext.isShowInputRange()>\u000a\u0009\u0009\u0009\u0009<#if (customFacetDisplayContext.getAggregationType() == "range") || (customFacetDisplayContext.getAggregationType() == "dateRange")>\u000a\u0009\u0009\u0009\u0009\u0009<li class="facet-value">\u000a\u0009\u0009\u0009\u0009\u0009\u0009<@clay.button\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009cssClass="facet-term btn-unstyled ${(customRangeBucketDisplayContext.isSelected())?then(''facet-term-selected'', ''facet-term-unselected'')} term-name"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009data\-term\-id="${htmlUtil.escape(customRangeBucketDisplayContext.getBucketText())}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009disabled="true"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009displayType="link"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009id="${namespace}${customRangeBucketDisplayContext.getBucketText()}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="${namespace}${customRangeBucketDisplayContext.getBucketText()}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if customRangeBucketDisplayContext.isSelected()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<strong><@liferay_ui["message"] key="${htmlUtil.escape(customRangeBucketDisplayContext.getBucketText())}" /></strong>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#else>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_ui["message"] key="${htmlUtil.escape(customRangeBucketDisplayContext.getBucketText())}" />\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if customRangeBucketDisplayContext.isSelected()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<small class="term-count">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009(${customRangeBucketDisplayContext.getFrequency()})\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</small>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</@clay.button>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_aui.script>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009document.getElementById(''${namespace}${customRangeBucketDisplayContext.getBucketText()}'').onclick = function(event) {\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009if ("${customFacetDisplayContext.getAggregationType()}" == "dateRange") {\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009Liferay.Search.FacetUtil.changeSelection(event);\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009}\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009if ("${customFacetDisplayContext.getAggregationType()}" == "range") {\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009event.preventDefault();\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009const customRangeElement = document.getElementById(''${namespace}customRange'');\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009if (customRangeElement && customRangeElement.classList.contains(''hide'')) {\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009customRangeElement.classList.remove(''hide'');\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009else if (Liferay.Search.FacetUtil.isCustomRangeValid(event)) {\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009Liferay.Search.FacetUtil.changeSelection(event);\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009\u0009\u0009</@liferay_aui.script>\u000a\u0009\u0009\u0009\u0009\u0009</li>\u000a\u0009\u0009\u0009\u0009</#if>\u000a\u000a\u0009\u0009\u0009\u0009<#if customFacetDisplayContext.getAggregationType() == "range">\u000a\u0009\u0009\u0009\u0009\u0009<div class="${(!customRangeBucketDisplayContext.isSelected())?then("hide", "")} date-custom-range" id="${namespace}customRange">\u000a\u0009\u0009\u0009\u0009\u0009\u0009<div class="col-md-6" id="${namespace}customRangeFrom">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_aui["field-wrapper"]>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_aui.input\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009label="from"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009id="fromInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="fromInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009type="number"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009value=customFacetDisplayContext.getFromParameterValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</@>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009<div class="col-md-6" id="${namespace}customRangeTo">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_aui["field-wrapper"]>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_aui.input\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009label="to"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009id="toInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="toInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009type="number"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009value=customFacetDisplayContext.getToParameterValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</@>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009<@clay["button"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009cssClass="custom-range-filter-button"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009disabled=!customFacetDisplayContext.getToParameterValue()?? || !customFacetDisplayContext.getFromParameterValue()?? || customFacetDisplayContext.getToParameterValue()?number < customFacetDisplayContext.getFromParameterValue()?number\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009displayType="secondary"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009id="${namespace + ''searchCustomRangeButton''}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009label="search"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="${namespace + ''searchCustomRangeButton''}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009\u0009</#if>\u000a\u000a\u0009\u0009\u0009\u0009<#if customFacetDisplayContext.getAggregationType() == "dateRange">\u000a\u0009\u0009\u0009\u0009\u0009<div class="${(!customFacetCalendarDisplayContext.isSelected())?then("hide", "")} date-custom-range" id="${namespace}customRange">\u000a\u0009\u0009\u0009\u0009\u0009\u0009<div class="col-md-6" id="${namespace}customRangeFrom">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_aui["field-wrapper"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009label="from"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="fromInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_ui["input-date"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009cssClass="date-facet-custom-range-input-date-from"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009dayParam="fromDay"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009dayValue=customFacetCalendarDisplayContext.getFromDayValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009disabled=false\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009firstDayOfWeek=customFacetCalendarDisplayContext.getFromFirstDayOfWeek()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009monthParam="fromMonth"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009monthValue=customFacetCalendarDisplayContext.getFromMonthValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="fromInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009yearParam="fromYear"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009yearValue=customFacetCalendarDisplayContext.getFromYearValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</@>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009<div class="col-md-6" id="${namespace}customRangeTo">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_aui["field-wrapper"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009label="to"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="toInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_ui["input-date"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009cssClass="date-facet-custom-range-input-date-to"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009dayParam="toDay"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009dayValue=customFacetCalendarDisplayContext.getToDayValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009disabled=false\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009firstDayOfWeek=customFacetCalendarDisplayContext.getToFirstDayOfWeek()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009monthParam="toMonth"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009monthValue=customFacetCalendarDisplayContext.getToMonthValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="toInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009yearParam="toYear"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009yearValue=customFacetCalendarDisplayContext.getToYearValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</@>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009<@clay["button"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009cssClass="date-facet-custom-range-filter-button"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009disabled=customFacetCalendarDisplayContext.isRangeBackwards()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009displayType="secondary"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009id="${namespace + ''searchCustomRangeButton''}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009label="search"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="${namespace + ''searchCustomRangeButton''}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009\u0009</#if>\u000a\u0009\u0009\u0009</#if>\u000a\u0009\u0009</ul>\u000a\u0009</@>\u000a</@>',0,20095,NULL,'2025-03-06 12:56:36.242000')
INSERT INTO DDMTEMPLATEVERSION VALUES(0,0,64891,20119,16796623585306,20095,NULL,'2025-03-06 12:56:36.244000',31631,0,31635,'1.2','<?xml version="1.0" ?><root available-locales="en_US,sv_SE,pt_BR,ja_JP,fr_FR,hu_HU,de_DE,ca_ES,ar_SA,fi_FI,zh_CN,es_ES,nl_NL" default-locale="en_US"><Name language-id="en_US">Label Layout (Multiselect)</Name><Name language-id="ar_SA">\u062a\u062e\u0637\u064a\u0637 \u0627\u0644\u062a\u0633\u0645\u064a\u0629 (\u062a\u062d\u062f\u064a\u062f \u0645\u062a\u0639\u062f\u062f)</Name><Name language-id="ca_ES">Disposici\u00f3 d''etiquetes (selecci\u00f3 m\u00faltiple)</Name><Name language-id="zh_CN">\u6807\u7b7e\u5e03\u5c40\uff08\u591a\u9009\uff09</Name><Name language-id="nl_NL">Labellay-out (meervoudige selectie)</Name><Name language-id="fi_FI">Tunnisteiden asettelu (monivalinta)</Name><Name language-id="fr_FR">Disposition des libell\u00e9s (s\u00e9lection multiple)</Name><Name language-id="de_DE">Bezeichnungslayout (Mehrfachauswahl)</Name><Name language-id="hu_HU">C\u00edmke elrendez\u00e9se (t\u00f6bbv\u00e1laszt\u00f3s)</Name><Name language-id="ja_JP">\u30e9\u30d9\u30eb\u30ec\u30a4\u30a2\u30a6\u30c8 (\u8907\u6570\u9078\u629e)</Name><Name language-id="pt_BR">Layout de r\u00f3tulo (Multisele\u00e7\u00e3o)</Name><Name language-id="es_ES">Dise\u00f1o de etiqueta (selecci\u00f3n m\u00faltiple)</Name><Name language-id="sv_SE">Etikettlayout (flera val)</Name></root>','<?xml version="1.0" ?><root available-locales="en_US,sv_SE,pt_BR,ja_JP,fr_FR,hu_HU,de_DE,ca_ES,ar_SA,fi_FI,zh_CN,es_ES,nl_NL" default-locale="en_US"><Description language-id="en_US">Display terms as an inline list of labels.</Description><Description language-id="ar_SA">\u0639\u0631\u0636 \u0627\u0644\u0645\u0635\u0637\u0644\u062d\u0627\u062a \u0643\u0642\u0627\u0626\u0645\u0629 \u0645\u062f\u0645\u062c\u0629 \u0645\u0646 \u0627\u0644\u062a\u0633\u0645\u064a\u0627\u062a.</Description><Description language-id="ca_ES">Mostra els termes com una llista integrada d''etiquetes.</Description><Description language-id="zh_CN">\u5c06\u641c\u7d22\u8bcd\u663e\u793a\u4e3a\u5185\u8054\u6807\u7b7e\u5217\u8868\u3002</Description><Description language-id="nl_NL">Termen weergeven als een gealigneerde lijst met links.</Description><Description language-id="fi_FI">N\u00e4yt\u00e4 termit linline-otsikkoluettelona.</Description><Description language-id="fr_FR">Afficher les termes sous la forme de liste int\u00e9gr\u00e9e de libell\u00e9s.</Description><Description language-id="de_DE">Begriffe als eingebettete Labelliste anzeigen.</Description><Description language-id="hu_HU">Jelen\u00edtse meg a kifejez\u00e9seket c\u00edmk\u00e9k sork\u00f6zi list\u00e1jak\u00e9nt.</Description><Description language-id="ja_JP">\u7528\u8a9e\u3092\u30a4\u30f3\u30e9\u30a4\u30f3\u5f62\u5f0f\u306e\u30ea\u30b9\u30c8\u3068\u3057\u3066\u8868\u793a\u3057\u307e\u3059\u3002</Description><Description language-id="pt_BR">Exibir termos como uma lista embutida de r\u00f3tulos.</Description><Description language-id="es_ES">Muestra t\u00e9rminos como una lista de etiquetas en l\u00ednea.</Description><Description language-id="sv_SE">Visa villkoren som en infogad lista med etiketter.</Description></root>','ftl','<@liferay_ui["panel-container"]\u000a\u0009extended=true\u000a\u0009id="${namespace + ''facetCustomPanelContainer''}"\u000a\u0009markupView="lexicon"\u000a\u0009persistState=true\u000a>\u000a\u0009<@liferay_ui.panel\u000a\u0009\u0009collapsible=true\u000a\u0009\u0009cssClass="search-facet search-facet-display-label"\u000a\u0009\u0009id="${namespace + ''facetCustomPanel''}"\u000a\u0009\u0009markupView="lexicon"\u000a\u0009\u0009persistState=true\u000a\u0009\u0009title="${customFacetDisplayContext.getDisplayCaption()}"\u000a\u0009>\u000a\u0009\u0009<#if !customFacetDisplayContext.isNothingSelected()>\u000a\u0009\u0009\u0009<@clay.button\u000a\u0009\u0009\u0009\u0009cssClass="btn-unstyled c-mb-4 facet-clear-btn"\u000a\u0009\u0009\u0009\u0009displayType="link"\u000a\u0009\u0009\u0009\u0009id="${namespace + ''facetCustomClear''}"\u000a\u0009\u0009\u0009\u0009onClick="Liferay.Search.FacetUtil.clearSelections(event);"\u000a\u0009\u0009\u0009>\u000a\u0009\u0009\u0009\u0009<strong>${languageUtil.get(locale, "clear")}</strong>\u000a\u0009\u0009\u0009</@clay.button>\u000a\u0009\u0009</#if>\u000a\u000a\u0009\u0009<#if entries?has_content>\u000a\u0009\u0009\u0009<div class="label-container">\u000a\u0009\u0009\u0009\u0009<#list entries as entry>\u000a\u0009\u0009\u0009\u0009\u0009<@clay.button\u000a\u0009\u0009\u0009\u0009\u0009\u0009cssClass="label label-lg facet-term ${(entry.isSelected())?then(''label-primary facet-term-selected'', ''label-secondary facet-term-unselected'')} term-name"\u000a\u0009\u0009\u0009\u0009\u0009\u0009data\-term\-id="${entry.getBucketText()}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009disabled="true"\u000a\u0009\u0009\u0009\u0009\u0009\u0009displayType="unstyled"\u000a\u0009\u0009\u0009\u0009\u0009\u0009onClick="Liferay.Search.FacetUtil.changeSelection(event);"\u000a\u0009\u0009\u0009\u0009\u0009>\u000a\u0009\u0009\u0009\u0009\u0009\u0009<#if entry.isSelected()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<strong><@liferay_ui["message"] key="${htmlUtil.escape(entry.getBucketText())}" /></strong>\u000a\u0009\u0009\u0009\u0009\u0009\u0009<#else>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_ui["message"] key="${htmlUtil.escape(entry.getBucketText())}" />\u000a\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009<#if entry.isFrequencyVisible()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009(${entry.getFrequency()})\u000a\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u0009\u0009\u0009\u0009\u0009</@clay.button>\u000a\u0009\u0009\u0009\u0009</#list>\u000a\u0009\u0009\u0009</div>\u000a\u0009\u0009</#if>\u000a\u000a\u0009\u0009<#if customFacetDisplayContext.isShowInputRange()>\u000a\u0009\u0009\u0009<#if (customFacetDisplayContext.getAggregationType() == "range") || (customFacetDisplayContext.getAggregationType() == "dateRange")>\u000a\u0009\u0009\u0009\u0009<@clay.button\u000a\u0009\u0009\u0009\u0009\u0009cssClass="label label-lg facet-term ${(customRangeBucketDisplayContext.isSelected())?then(''label-primary facet-term-selected'', ''label-secondary facet-term-unselected'')} term-name"\u000a\u0009\u0009\u0009\u0009\u0009data\-term\-id="${htmlUtil.escape(customRangeBucketDisplayContext.getBucketText())}"\u000a\u0009\u0009\u0009\u0009\u0009disabled="true"\u000a\u0009\u0009\u0009\u0009\u0009displayType="unstyled"\u000a\u0009\u0009\u0009\u0009\u0009id="${namespace}${customRangeBucketDisplayContext.getBucketText()}"\u000a\u0009\u0009\u0009\u0009\u0009name="${namespace}${customRangeBucketDisplayContext.getBucketText()}"\u000a\u0009\u0009\u0009\u0009>\u000a\u0009\u0009\u0009\u0009\u0009<#if customRangeBucketDisplayContext.isSelected()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009<strong><@liferay_ui["message"] key="${htmlUtil.escape(customRangeBucketDisplayContext.getBucketText())}" /></strong>\u000a\u0009\u0009\u0009\u0009\u0009<#else>\u000a\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_ui["message"] key="${htmlUtil.escape(customRangeBucketDisplayContext.getBucketText())}" />\u000a\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u000a\u0009\u0009\u0009\u0009\u0009<#if customRangeBucketDisplayContext.isSelected()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009<div class="term-count">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009(${customRangeBucketDisplayContext.getFrequency()})\u000a\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u0009\u0009\u0009\u0009</@clay.button>\u000a\u000a\u0009\u0009\u0009\u0009<@liferay_aui.script>\u000a\u0009\u0009\u0009\u0009\u0009document.getElementById(''${namespace}${customRangeBucketDisplayContext.getBucketText()}'').onclick = function(event) {\u000a\u0009\u0009\u0009\u0009\u0009\u0009if ("${customFacetDisplayContext.getAggregationType()}" == "dateRange") {\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009Liferay.Search.FacetUtil.changeSelection(event);\u000a\u0009\u0009\u0009\u0009\u0009\u0009}\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009if ("${customFacetDisplayContext.getAggregationType()}" == "range") {\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009event.preventDefault();\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009const customRangeElement = document.getElementById(''${namespace}customRange'');\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009if (customRangeElement && customRangeElement.classList.contains(''hide'')) {\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009customRangeElement.classList.remove(''hide'');\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009else if (Liferay.Search.FacetUtil.isCustomRangeValid(event)) {\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009Liferay.Search.FacetUtil.changeSelection(event);\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009</@liferay_aui.script>\u000a\u0009\u0009\u0009</#if>\u000a\u000a\u0009\u0009\u0009<#if customFacetDisplayContext.getAggregationType() == "range">\u000a\u0009\u0009\u0009\u0009<div class="${(!customRangeBucketDisplayContext.isSelected())?then("hide", "")} date-custom-range" id="${namespace}customRange">\u000a\u0009\u0009\u0009\u0009\u0009<div class="col-md-6" id="${namespace}customRangeFrom">\u000a\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_aui["field-wrapper"]>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_aui.input\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009label="from"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009id="fromInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="fromInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009type="number"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009value=customFacetDisplayContext.getFromParameterValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</@>\u000a\u0009\u0009\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u0009\u0009<div class="col-md-6" id="${namespace}customRangeTo">\u000a\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_aui["field-wrapper"]>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_aui.input\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009label="to"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009id="toInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="toInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009type="number"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009value=customFacetDisplayContext.getToParameterValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</@>\u000a\u0009\u0009\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u0009\u0009<@clay["button"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009cssClass="custom-range-filter-button"\u000a\u0009\u0009\u0009\u0009\u0009\u0009disabled=!customFacetDisplayContext.getToParameterValue()?? || !customFacetDisplayContext.getFromParameterValue()?? || customFacetDisplayContext.getToParameterValue()?number < customFacetDisplayContext.getFromParameterValue()?number\u000a\u0009\u0009\u0009\u0009\u0009\u0009displayType="secondary"\u000a\u0009\u0009\u0009\u0009\u0009\u0009id="${namespace + ''searchCustomRangeButton''}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009label="search"\u000a\u0009\u0009\u0009\u0009\u0009\u0009name="${namespace + ''searchCustomRangeButton''}"\u000a\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009</#if>\u000a\u000a\u0009\u0009\u0009<#if customFacetDisplayContext.getAggregationType() == "dateRange">\u000a\u0009\u0009\u0009\u0009<div class="${(!customFacetCalendarDisplayContext.isSelected())?then("hide", "")} date-custom-range" id="${namespace}customRange">\u000a\u0009\u0009\u0009\u0009\u0009<div class="col-md-6" id="${namespace}customRangeFrom">\u000a\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_aui["field-wrapper"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009label="from"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="fromInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_ui["input-date"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009cssClass="date-facet-custom-range-input-date-from"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009dayParam="fromDay"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009dayValue=customFacetCalendarDisplayContext.getFromDayValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009disabled=false\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009firstDayOfWeek=customFacetCalendarDisplayContext.getFromFirstDayOfWeek()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009monthParam="fromMonth"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009monthValue=customFacetCalendarDisplayContext.getFromMonthValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="fromInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009yearParam="fromYear"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009yearValue=customFacetCalendarDisplayContext.getFromYearValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</@>\u000a\u0009\u0009\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u0009\u0009<div class="col-md-6" id="${namespace}customRangeTo">\u000a\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_aui["field-wrapper"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009label="to"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="toInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_ui["input-date"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009cssClass="date-facet-custom-range-input-date-to"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009dayParam="toDay"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009dayValue=customFacetCalendarDisplayContext.getToDayValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009disabled=false\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009firstDayOfWeek=customFacetCalendarDisplayContext.getToFirstDayOfWeek()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009monthParam="toMonth"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009monthValue=customFacetCalendarDisplayContext.getToMonthValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="toInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009yearParam="toYear"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009yearValue=customFacetCalendarDisplayContext.getToYearValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</@>\u000a\u0009\u0009\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u0009\u0009<@clay["button"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009cssClass="date-facet-custom-range-filter-button"\u000a\u0009\u0009\u0009\u0009\u0009\u0009disabled=customFacetCalendarDisplayContext.isRangeBackwards()\u000a\u0009\u0009\u0009\u0009\u0009\u0009displayType="secondary"\u000a\u0009\u0009\u0009\u0009\u0009\u0009id="${namespace + ''searchCustomRangeButton''}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009label="search"\u000a\u0009\u0009\u0009\u0009\u0009\u0009name="${namespace + ''searchCustomRangeButton''}"\u000a\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009</#if>\u000a\u0009\u0009</#if>\u000a\u0009</@>\u000a</@>',0,20095,NULL,'2025-03-06 12:56:36.244000')
INSERT INTO DDMTEMPLATEVERSION VALUES(0,0,64892,20119,16796623585306,20095,NULL,'2025-03-06 12:56:36.244000',31631,0,62053,'1.1','<?xml version="1.0" ?><root available-locales="en_US,sv_SE,pt_BR,ja_JP,fr_FR,hu_HU,de_DE,ca_ES,ar_SA,fi_FI,zh_CN,es_ES,nl_NL" default-locale="en_US"><Name language-id="en_US">Radio Button Layout (Single Select)</Name><Name language-id="ar_SA">\u062a\u062e\u0637\u064a\u0637 \u0632\u0631 \u062a\u0628\u0627\u062f\u0644\u064a (\u062a\u062d\u062f\u064a\u062f \u0641\u0631\u062f\u064a)</Name><Name language-id="ca_ES">Disposici\u00f3 del bot\u00f3 de r\u00e0dio (selecci\u00f3 \u00fanica)</Name><Name language-id="zh_CN">\u5355\u9009\u6309\u94ae\u5e03\u5c40\uff08\u5355\u9009\uff09</Name><Name language-id="nl_NL">Lay-out keuzerondjes (enkelvoudige selectie)</Name><Name language-id="fi_FI">Valintanapin asettelu (yksitt\u00e4inen valinta)</Name><Name language-id="fr_FR">Disposition des boutons radio (s\u00e9lection unique)</Name><Name language-id="de_DE">Optionsfeldlayout (Einzelauswahl)</Name><Name language-id="hu_HU">R\u00e1di\u00f3gombok elrendez\u00e9se (egyv\u00e1laszt\u00f3s)</Name><Name language-id="ja_JP">\u30e9\u30b8\u30aa\u30dc\u30bf\u30f3\u306e\u30ec\u30a4\u30a2\u30a6\u30c8 (\u5358\u4e00\u9078\u629e)</Name><Name language-id="pt_BR">Layout do bot\u00e3o de r\u00e1dio (Sele\u00e7\u00e3o \u00fanica)</Name><Name language-id="es_ES">Dise\u00f1o del bot\u00f3n de radio (selecci\u00f3n \u00fanica)</Name><Name language-id="sv_SE">Layout f\u00f6r radioknapp (ett val)</Name></root>','<?xml version="1.0" ?><root available-locales="en_US,sv_SE,pt_BR,ja_JP,fr_FR,hu_HU,de_DE,ca_ES,ar_SA,fi_FI,zh_CN,es_ES,nl_NL" default-locale="en_US"><Description language-id="en_US">Display terms with radio buttons.</Description><Description language-id="ar_SA">\u0639\u0631\u0636 \u0627\u0644\u0645\u0635\u0637\u0644\u062d\u0627\u062a \u0628\u0623\u0632\u0631\u0627\u0631 \u0627\u062e\u062a\u064a\u0627\u0631.</Description><Description language-id="ca_ES">Mostra els termes amb botons de r\u00e0dio.</Description><Description language-id="zh_CN">\u5c06\u641c\u7d22\u8bcd\u663e\u793a\u4e3a\u5355\u9009\u6309\u94ae\u3002</Description><Description language-id="nl_NL">Termen weergeven met checkboxen.</Description><Description language-id="fi_FI">N\u00e4yt\u00e4 termit radiopainikkeina.</Description><Description language-id="fr_FR">Afficher les termes avec les boutons radio.</Description><Description language-id="de_DE">Begriffe mit Optionsfeldern anzeigen.</Description><Description language-id="hu_HU">Jelen\u00edtse meg a kifejez\u00e9seket r\u00e1di\u00f3gombokkal.</Description><Description language-id="ja_JP">\u7528\u8a9e\u3092\u30e9\u30b8\u30aa\u30dc\u30bf\u30f3\u4ed8\u304d\u3067\u8868\u793a\u3057\u307e\u3059\u3002</Description><Description language-id="pt_BR">Exibir termos como bot\u00f5es de r\u00e1dio.</Description><Description language-id="es_ES">Muestra t\u00e9rminos con botones de radio.</Description><Description language-id="sv_SE">Visa villkoren med radioknappar.</Description></root>','ftl','<@liferay_ui["panel-container"]\u000a\u0009extended=true\u000a\u0009id="${namespace + ''facetCustomPanelContainer''}"\u000a\u0009markupView="lexicon"\u000a\u0009persistState=true\u000a>\u000a\u0009<@liferay_ui.panel\u000a\u0009\u0009collapsible=true\u000a\u0009\u0009cssClass="search-facet"\u000a\u0009\u0009id="${namespace + ''facetCustomPanel''}"\u000a\u0009\u0009markupView="lexicon"\u000a\u0009\u0009persistState=true\u000a\u0009\u0009title="${customFacetDisplayContext.getDisplayCaption()}"\u000a\u0009>\u000a\u0009\u0009<#if !customFacetDisplayContext.isNothingSelected()>\u000a\u0009\u0009\u0009<@clay.button\u000a\u0009\u0009\u0009\u0009cssClass="btn-unstyled c-mb-4 facet-clear-btn"\u000a\u0009\u0009\u0009\u0009displayType="link"\u000a\u0009\u0009\u0009\u0009id="${namespace + ''facetCustomClear''}"\u000a\u0009\u0009\u0009\u0009onClick="Liferay.Search.FacetUtil.clearSelections(event);"\u000a\u0009\u0009\u0009>\u000a\u0009\u0009\u0009\u0009<strong>${languageUtil.get(locale, "clear")}</strong>\u000a\u0009\u0009\u0009</@clay.button>\u000a\u0009\u0009</#if>\u000a\u000a\u0009\u0009<ul class="list-unstyled">\u000a\u0009\u0009\u0009<#if entries?has_content>\u000a\u0009\u0009\u0009\u0009<#list entries as entry>\u000a\u0009\u0009\u0009\u0009\u0009<li class="facet-value">\u000a\u0009\u0009\u0009\u0009\u0009\u0009<div class="custom-control custom-radio">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<label class="facet-checkbox-label" for="${namespace}${entry.getBucketText()}">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<input\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009${(entry.isSelected())?then("checked", "")}\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009class="custom-control-input facet-term"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009disabled\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009id="${namespace}${entry.getBucketText()}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="${namespace}${entry.getBucketText()}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009role="radio"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009type="radio"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_aui.script>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009document.getElementById(''${namespace}${entry.getBucketText()}'').onchange = function() {\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009window.location.href = "${entry.getFilterValue()}";\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</@liferay_aui.script>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span class="custom-control-label term-name ${(entry.isSelected())?then(''facet-term-selected'', ''facet-term-unselected'')}">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span class="custom-control-label-text">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if entry.isSelected()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<strong><@liferay_ui["message"] key="${htmlUtil.escape(entry.getBucketText())}" /></strong>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#else>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_ui["message"] key="${htmlUtil.escape(entry.getBucketText())}" />\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if entry.isFrequencyVisible()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<small class="term-count">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009(${entry.getFrequency()})\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</small>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</label>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009\u0009\u0009</li>\u000a\u0009\u0009\u0009\u0009</#list>\u000a\u0009\u0009\u0009</#if>\u000a\u000a\u0009\u0009\u0009<#if customFacetDisplayContext.isShowInputRange()>\u000a\u0009\u0009\u0009\u0009<#if (customFacetDisplayContext.getAggregationType() == "range") || (customFacetDisplayContext.getAggregationType() == "dateRange")>\u000a\u0009\u0009\u0009\u0009\u0009<li class="facet-value">\u000a\u0009\u0009\u0009\u0009\u0009\u0009<div class="custom-control custom-radio">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<label class="facet-checkbox-label" for="${namespace}${customRangeBucketDisplayContext.getBucketText()}">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<input\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009${(customRangeBucketDisplayContext.isSelected())?then("checked", "")}\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009data-term-id="${htmlUtil.escape(customRangeBucketDisplayContext.getBucketText())}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009class="custom-control-input facet-term"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009disabled\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009id="${namespace}${customRangeBucketDisplayContext.getBucketText()}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="${namespace}${customRangeBucketDisplayContext.getBucketText()}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009role="radio"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009type="radio"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_aui.script>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009document.getElementById(''${namespace}${customRangeBucketDisplayContext.getBucketText()}'').onclick = function(event) {\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009if ("${customFacetDisplayContext.getAggregationType()}" == "dateRange") {\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009window.location.href = "${customRangeBucketDisplayContext.getFilterValue()}";\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009}\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009if ("${customFacetDisplayContext.getAggregationType()}" == "range") {\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009event.preventDefault();\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009const customRangeElement = document.getElementById(''${namespace}customRange'');\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009if (customRangeElement && customRangeElement.classList.contains(''hide'')) {\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009customRangeElement.classList.remove(''hide'');\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009else if (Liferay.Search.FacetUtil.isCustomRangeValid(event)) {\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009Liferay.Search.FacetUtil.changeSingleSelection(event);\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</@liferay_aui.script>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span class="custom-control-label term-name ${(customRangeBucketDisplayContext.isSelected())?then(''facet-term-selected'', ''facet-term-unselected'')}">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span class="custom-control-label-text">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if customRangeBucketDisplayContext.isSelected()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<strong><@liferay_ui["message"] key="${htmlUtil.escape(customRangeBucketDisplayContext.getBucketText())}" /></strong>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#else>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_ui["message"] key="${htmlUtil.escape(customRangeBucketDisplayContext.getBucketText())}" />\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if customRangeBucketDisplayContext.isSelected()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<small class="term-count">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009(${customRangeBucketDisplayContext.getFrequency()})\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</small>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</label>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009\u0009\u0009</li>\u000a\u0009\u0009\u0009\u0009</#if>\u000a\u000a\u0009\u0009\u0009\u0009<#if customFacetDisplayContext.getAggregationType() == "range">\u000a\u0009\u0009\u0009\u0009\u0009<div class="${(!customRangeBucketDisplayContext.isSelected())?then("hide", "")} date-custom-range" id="${namespace}customRange">\u000a\u0009\u0009\u0009\u0009\u0009\u0009<div class="col-md-6" id="${namespace}customRangeFrom">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_aui["field-wrapper"]>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_aui.input\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009label="from"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009id="fromInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="fromInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009type="number"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009value=customFacetDisplayContext.getFromParameterValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</@>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009<div class="col-md-6" id="${namespace}customRangeTo">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_aui["field-wrapper"]>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_aui.input\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009label="to"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009id="toInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="toInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009type="number"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009value=customFacetDisplayContext.getToParameterValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</@>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009<@clay["button"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009cssClass="custom-range-filter-button"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009disabled=!customFacetDisplayContext.getToParameterValue()?? || !customFacetDisplayContext.getFromParameterValue()?? || customFacetDisplayContext.getToParameterValue()?number < customFacetDisplayContext.getFromParameterValue()?number\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009displayType="secondary"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009id="${namespace + ''searchCustomRangeButton''}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009label="search"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="${namespace + ''searchCustomRangeButton''}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009\u0009</#if>\u000a\u000a\u0009\u0009\u0009\u0009<#if customFacetDisplayContext.getAggregationType() == "dateRange">\u000a\u0009\u0009\u0009\u0009\u0009<div class="${(!customFacetCalendarDisplayContext.isSelected())?then("hide", "")} date-custom-range" id="${namespace}customRange">\u000a\u0009\u0009\u0009\u0009\u0009\u0009<div class="col-md-6" id="${namespace}customRangeFrom">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_aui["field-wrapper"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009label="from"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="fromInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_ui["input-date"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009cssClass="date-facet-custom-range-input-date-from"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009dayParam="fromDay"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009dayValue=customFacetCalendarDisplayContext.getFromDayValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009disabled=false\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009firstDayOfWeek=customFacetCalendarDisplayContext.getFromFirstDayOfWeek()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009monthParam="fromMonth"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009monthValue=customFacetCalendarDisplayContext.getFromMonthValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="fromInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009yearParam="fromYear"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009yearValue=customFacetCalendarDisplayContext.getFromYearValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</@>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009<div class="col-md-6" id="${namespace}customRangeTo">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_aui["field-wrapper"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009label="to"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="toInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_ui["input-date"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009cssClass="date-facet-custom-range-input-date-to"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009dayParam="toDay"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009dayValue=customFacetCalendarDisplayContext.getToDayValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009disabled=false\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009firstDayOfWeek=customFacetCalendarDisplayContext.getToFirstDayOfWeek()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009monthParam="toMonth"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009monthValue=customFacetCalendarDisplayContext.getToMonthValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="toInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009yearParam="toYear"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009yearValue=customFacetCalendarDisplayContext.getToYearValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</@>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009<@clay["button"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009cssClass="date-facet-custom-range-filter-button"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009disabled=customFacetCalendarDisplayContext.isRangeBackwards()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009displayType="secondary"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009id="${namespace + ''searchCustomRangeButton''}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009label="search"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="${namespace + ''searchCustomRangeButton''}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009\u0009</#if>\u000a\u0009\u0009\u0009</#if>\u000a\u0009\u0009</ul>\u000a\u0009</@>\u000a</@>',0,20095,NULL,'2025-03-06 12:56:36.244000')
INSERT INTO DDMTEMPLATEVERSION VALUES(0,0,64893,20119,16796623585306,20095,NULL,'2025-03-06 12:56:36.357000',31659,0,31660,'1.3','<?xml version="1.0" ?><root available-locales="en_US,sv_SE,pt_BR,ja_JP,fr_FR,hu_HU,de_DE,ca_ES,ar_SA,fi_FI,zh_CN,es_ES,nl_NL" default-locale="en_US"><Name language-id="en_US">Radio Layout</Name><Name language-id="ar_SA">\u0645\u062e\u0637\u0637 \u0627\u0644\u0631\u0627\u062f\u064a\u0648</Name><Name language-id="ca_ES">Disposici\u00f3 de r\u00e0dio</Name><Name language-id="zh_CN">\u5355\u9009\u6309\u94ae\u5e03\u5c40</Name><Name language-id="nl_NL">Keuzerondjeslay-out</Name><Name language-id="fi_FI">Valintapainikeasettelu</Name><Name language-id="fr_FR">Disposition radio</Name><Name language-id="de_DE">Optionsfelderlayout</Name><Name language-id="hu_HU">R\u00e1di\u00f3 elrendez\u00e9s</Name><Name language-id="ja_JP">\u30e9\u30b8\u30aa\u306e\u30ec\u30a4\u30a2\u30a6\u30c8</Name><Name language-id="pt_BR">Layout de r\u00e1dio</Name><Name language-id="es_ES">Dise\u00f1o de radio</Name><Name language-id="sv_SE">Radio-layout</Name></root>','<?xml version="1.0" ?><root available-locales="en_US,sv_SE,pt_BR,ja_JP,fr_FR,hu_HU,de_DE,ca_ES,ar_SA,fi_FI,zh_CN,es_ES,nl_NL" default-locale="en_US"><Description language-id="en_US">Display terms with radio buttons.</Description><Description language-id="ar_SA">\u0639\u0631\u0636 \u0627\u0644\u0645\u0635\u0637\u0644\u062d\u0627\u062a \u0628\u0623\u0632\u0631\u0627\u0631 \u0627\u062e\u062a\u064a\u0627\u0631.</Description><Description language-id="ca_ES">Mostra els termes amb botons de r\u00e0dio.</Description><Description language-id="zh_CN">\u5c06\u641c\u7d22\u8bcd\u663e\u793a\u4e3a\u5355\u9009\u6309\u94ae\u3002</Description><Description language-id="nl_NL">Termen weergeven met checkboxen.</Description><Description language-id="fi_FI">N\u00e4yt\u00e4 termit radiopainikkeina.</Description><Description language-id="fr_FR">Afficher les termes avec les boutons radio.</Description><Description language-id="de_DE">Begriffe mit Optionsfeldern anzeigen.</Description><Description language-id="hu_HU">Jelen\u00edtse meg a kifejez\u00e9seket r\u00e1di\u00f3gombokkal.</Description><Description language-id="ja_JP">\u7528\u8a9e\u3092\u30e9\u30b8\u30aa\u30dc\u30bf\u30f3\u4ed8\u304d\u3067\u8868\u793a\u3057\u307e\u3059\u3002</Description><Description language-id="pt_BR">Exibir termos como bot\u00f5es de r\u00e1dio.</Description><Description language-id="es_ES">Muestra t\u00e9rminos con botones de radio.</Description><Description language-id="sv_SE">Visa villkoren med radioknappar.</Description></root>','ftl','<@liferay_ui["panel-container"]\u000a\u0009extended=true\u000a\u0009id="${namespace + ''facetModifiedPanelContainer''}"\u000a\u0009markupView="lexicon"\u000a\u0009persistState=true\u000a>\u000a\u0009<@liferay_ui.panel\u000a\u0009\u0009collapsible=true\u000a\u0009\u0009cssClass="search-facet"\u000a\u0009\u0009id="${namespace + ''facetModifiedPanel''}"\u000a\u0009\u0009markupView="lexicon"\u000a\u0009\u0009persistState=true\u000a\u0009\u0009title="last-modified"\u000a\u0009>\u000a\u0009\u0009<#if !modifiedFacetDisplayContext.isNothingSelected()>\u000a\u0009\u0009\u0009<@clay.button\u000a\u0009\u0009\u0009\u0009cssClass="btn-unstyled c-mb-4 facet-clear-btn"\u000a\u0009\u0009\u0009\u0009displayType="link"\u000a\u0009\u0009\u0009\u0009id="${namespace + ''facetModifiedClear''}"\u000a\u0009\u0009\u0009\u0009onClick="Liferay.Search.FacetUtil.clearSelections(event);"\u000a\u0009\u0009\u0009>\u000a\u0009\u0009\u0009\u0009<strong>${languageUtil.get(locale, "clear")}</strong>\u000a\u0009\u0009\u0009</@clay.button>\u000a\u0009\u0009</#if>\u000a\u000a\u0009\u0009<ul class="list-unstyled modified">\u000a\u0009\u0009\u0009<#if entries?has_content>\u000a\u0009\u0009\u0009\u0009<#list entries as entry>\u000a\u0009\u0009\u0009\u0009\u0009<li class="facet-value">\u000a\u0009\u0009\u0009\u0009\u0009\u0009<div class="custom-control custom-radio">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<label class="facet-checkbox-label" for="${namespace}${entry.getBucketText()}">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_ui.csp>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<input\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009${(entry.isSelected())?then("checked", "")}\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009class="custom-control-input facet-term"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009disabled\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009id="${namespace}${entry.getBucketText()}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="${namespace}${entry.getBucketText()}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009onChange=''${"window.location.href = \"${entry.getFilterValue()}\";"}''\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009role="radio"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009type="radio"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</@liferay_ui.csp>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span class="custom-control-label term-name ${(entry.isSelected())?then(''facet-term-selected'', ''facet-term-unselected'')}">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span class="custom-control-label-text">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if entry.isSelected()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<strong><@liferay_ui["message"] key="${htmlUtil.escape(entry.getBucketText())}" /></strong>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#else>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_ui["message"] key="${htmlUtil.escape(entry.getBucketText())}" />\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<small class="term-count">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009(${entry.getFrequency()})\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</small>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</label>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009\u0009\u0009</li>\u000a\u0009\u0009\u0009\u0009</#list>\u000a\u0009\u0009\u0009</#if>\u000a\u000a\u0009\u0009\u0009<li class="facet-value">\u000a\u0009\u0009\u0009\u0009<div class="custom-control custom-radio">\u000a\u0009\u0009\u0009\u0009\u0009<label class="facet-checkbox-label" for="${namespace}${customRangeBucketDisplayContext.getBucketText()}">\u000a\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_ui.csp>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<input\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009${(customRangeBucketDisplayContext.isSelected())?then("checked", "")}\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009class="custom-control-input facet-term"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009disabled\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009id="${namespace}${customRangeBucketDisplayContext.getBucketText()}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="${namespace}${customRangeBucketDisplayContext.getBucketText()}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009onChange=''${"window.location.href = \"${customRangeBucketDisplayContext.getFilterValue()}\";"}''\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009role="radio"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009type="radio"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</@liferay_ui.csp>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009<span class="custom-control-label term-name ${(customRangeBucketDisplayContext.isSelected())?then(''facet-term-selected'', ''facet-term-unselected'')}">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span class="custom-control-label-text">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if customRangeBucketDisplayContext.isSelected()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<strong><@liferay_ui["message"] key="${htmlUtil.escape(customRangeBucketDisplayContext.getBucketText())}" /></strong>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#else>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_ui["message"] key="${htmlUtil.escape(customRangeBucketDisplayContext.getBucketText())}" />\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009<#if customRangeBucketDisplayContext.isSelected()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<small class="term-count">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009(${customRangeBucketDisplayContext.getFrequency()})\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</small>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u0009\u0009\u0009\u0009\u0009</label>\u000a\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009</li>\u000a\u000a\u0009\u0009\u0009<div class="${(!modifiedFacetCalendarDisplayContext.isSelected())?then("hide", "")} modified-custom-range" id="${namespace}customRange">\u000a\u0009\u0009\u0009\u0009<div class="col-md-6" id="${namespace}customRangeFrom">\u000a\u0009\u0009\u0009\u0009\u0009<@liferay_aui["field-wrapper"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009label="from"\u000a\u0009\u0009\u0009\u0009\u0009\u0009name="fromInput"\u000a\u0009\u0009\u0009\u0009\u0009>\u000a\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_ui["input-date"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009cssClass="modified-facet-custom-range-input-date-from"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009dayParam="fromDay"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009dayValue=modifiedFacetCalendarDisplayContext.getFromDayValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009disabled=false\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009firstDayOfWeek=modifiedFacetCalendarDisplayContext.getFromFirstDayOfWeek()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009monthParam="fromMonth"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009monthValue=modifiedFacetCalendarDisplayContext.getFromMonthValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="fromInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009yearParam="fromYear"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009yearValue=modifiedFacetCalendarDisplayContext.getFromYearValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009\u0009</@>\u000a\u0009\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u0009<div class="col-md-6" id="${namespace}customRangeTo">\u000a\u0009\u0009\u0009\u0009\u0009<@liferay_aui["field-wrapper"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009label="to"\u000a\u0009\u0009\u0009\u0009\u0009\u0009name="toInput"\u000a\u0009\u0009\u0009\u0009\u0009>\u000a\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_ui["input-date"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009cssClass="modified-facet-custom-range-input-date-to"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009dayParam="toDay"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009dayValue=modifiedFacetCalendarDisplayContext.getToDayValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009disabled=false\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009firstDayOfWeek=modifiedFacetCalendarDisplayContext.getToFirstDayOfWeek()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009monthParam="toMonth"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009monthValue=modifiedFacetCalendarDisplayContext.getToMonthValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009name="toInput"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009yearParam="toYear"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009yearValue=modifiedFacetCalendarDisplayContext.getToYearValue()\u000a\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009\u0009</@>\u000a\u0009\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u0009<@clay["button"]\u000a\u0009\u0009\u0009\u0009\u0009cssClass="modified-facet-custom-range-filter-button"\u000a\u0009\u0009\u0009\u0009\u0009disabled=modifiedFacetCalendarDisplayContext.isRangeBackwards()\u000a\u0009\u0009\u0009\u0009\u0009displayType="secondary"\u000a\u0009\u0009\u0009\u0009\u0009id="${namespace + ''searchCustomRangeButton''}"\u000a\u0009\u0009\u0009\u0009\u0009label="search"\u000a\u0009\u0009\u0009\u0009\u0009name="${namespace + ''searchCustomRangeButton''}"\u000a\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009</div>\u000a\u0009\u0009</ul>\u000a\u0009</@>\u000a</@>',0,20095,NULL,'2025-03-06 12:56:36.357000')
