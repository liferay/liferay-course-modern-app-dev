",\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "nm"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"label": "large",\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "lg"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009\u0009\u0009]\u000a\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009],\u000a\u0009\u0009\u0009"label": "button-options"\u000a\u0009\u0009}\u000a\u0009]\u000a}','0','{"com.liferay.fragment.entry.processor.editable.EditableFragmentEntryProcessor":{"link":{"defaultValue":"\n\t\t\t\tGo Somewhere\n\t\t\t","en_US":"Learn More About Our Impact","config":{"alt":"","imageConfiguration":{}}}},"com.liferay.fragment.entry.processor.freemarker.FreeMarkerFragmentEntryProcessor":{"buttonType":"primary","type":"link","buttonSize":"nm"}}','tefh',1,'BASIC_COMPONENT-button',1,'2025-11-06 19:44:23.881000',NULL,'66636b7c-d3e1-1755-6cba-7b3712874501')
INSERT INTO FRAGMENTENTRYLINK VALUES(9,0,'345f43f9-9e77-c25e-7c98-099dbe08bd5c',44477,32106,16796623585306,20122,'Clarity Admin','2024-08-12 17:01:31.240000','2025-05-01 19:05:53.862000',44447,8,32391,20031,25,25,'.heading-underline {\u000a  position: relative;\u000a  line-height: 1.3em;\u000a}\u000a\u000a.heading-underline:before {\u000a  position: absolute;\u000a  left: 0;\u000a  top: 1.2em;\u000a  height: 0;\u000a  width: 60%;\u000a  content: '''';\u000a  border-top: 1px solid #1D8C8C;\u000a}','<div class="page-title-container font-weight-bold">\u000a\u0009<h${configuration.headingSize} class="font-weight-bold">\u000a\u0009\u0009<span class="heading-underline pb-2" data-lfr-editable-id="page-title-fragment-left" data-lfr-editable-type="text">Heading Title</span> \u000a\u0009</h${configuration.headingSize}>\u000a</div>','','{\u000a    "fieldSets": [\u000a        {\u000a            "fields": [\u000a                {\u000a                    "dataType": "string",\u000a                    "defaultValue": "1",\u000a                    "label": "Heading Level",\u000a                    "name": "headingSize",\u000a                    "type": "select",\u000a                    "typeOptions": {\u000a                        "validValues": [\u000a                            {\u000a                                "label": "H1",\u000a                                "value": "1"\u000a                            },\u000a                            {\u000a                                "label": "H2",\u000a                                "value": "2"\u000a                            },\u000a                            {\u000a                                "label": "H3",\u000a                                "value": "3"\u000a                            },\u000a                            {\u000a                                "label": "H4",\u000a                                "value": "4"\u000a                            },\u000a                            {\u000a                                "label": "H5",\u000a                                "value": "5"\u000a                            },\u000a                            {\u000a                                "label": "H6",\u000a                                "value": "6"\u000a                            }\u000a                        ]\u000a                    }\u000a                }\u000a            ]\u000a        }\u000a    ]\u000a}','0','{"com.liferay.fragment.entry.processor.editable.EditableFragmentEntryProcessor":{"page-title-fragment-right":{"en_US":"dership","config":{"mapperType":"link"}},"page-title-fragment-left":{"defaultValue":"Heading Title","en_US":"Leadership","config":{"mapperType":"link"}}},"com.liferay.fragment.entry.processor.freemarker.FreeMarkerFragmentEntryProcessor":{"headingSize":"1"}}','numl',0,'heading-1',1,'2024-05-20 20:34:23.489000',NULL,'345f43f9-9e77-c25e-7c98-099dbe08bd5c')
INSERT INTO FRAGMENTENTRYLINK VALUES(127,0,'0793576f-e40c-49d2-6a5a-1f20d872fdb6',44480,32106,16796623585306,20122,'Clarity Admin','2024-08-12 17:01:31.245000','2025-11-06 19:44:23.860000',44450,0,32391,20031,25,25,'.component-html img {\u000a\u0009max-width: 100%;\u000a}','<div class="component-html" data-lfr-editable-id="element-html" data-lfr-editable-type="html">\u000a\u0009<h1>HTML Example</h1>\u000a\u000a\u0009<p class="mb-0">\u000a\u0009\u0009A paragraph is a <strong>self-contained</strong> unit of a discourse in\u000a\u0009\u0009writing dealing with a particular point or <em>idea</em>. Paragraphs are\u000a\u0009\u0009usually an expected part of formal writing, used to organize longer\u000a\u0009\u0009prose.\u000a\u0009</p>\u000a</div>','','','0','{"com.liferay.fragment.entry.processor.editable.EditableFragmentEntryProcessor":{"element-html":{"defaultValue":"\n\t<h1>HTML Example<\/h1>\n\n\t<p class=\"mb-0\">\n\t\tA paragraph is a <strong>self-contained<\/strong> unit of a discourse in\n\t\twriting dealing with a particular point or <em>idea<\/em>. Paragraphs are\n\t\tusually an expected part of formal writing, used to organize longer\n\t\tprose.\n\t<\/p>\n","en_US":"\n\t<h1>Making a Positive<br>Impact, Sustainably<\/h1>\n\n\t<p class=\"mb-2 mt-3 text-small\">\n    At Clarity, our commitment to making a difference goes beyond stylish eyewear. \n    Through initiatives like empowering underserved communities with access to quality \n    eyewear, we bridge vision gaps and contribute to socail well-being. \n    Simultaneously, our dedication to sustainability is reflected in our eco-friendly\t\n    practices, from responsible material sourcing to the use of recyclable packaging.\n    Every purchase you make with us not only enhances your style but also supports our\n    collective journey toward a brighter, more includsive, and susainable future. \n<\/p>\n","config":{}}}}','hmyb',0,'BASIC_COMPONENT-html',1,'2025-11-06 19:44:23.860000',NULL,'0793576f-e40c-49d2-6a5a-1f20d872fdb6')
