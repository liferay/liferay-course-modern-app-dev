INSERT INTO FRAGMENTENTRYLINK VALUES(67,0,'b3226517-1428-d427-d941-73affe549fee',49988,32106,16796623585306,32252,'Walter Douglas','2024-08-28 19:21:47.445000','2025-11-06 19:44:25.245000',0,0,49955,20031,97,97,'.component-paragraph img {\u000a\u0009max-width: 100%;\u000a}','<div class="clearfix component-paragraph text-break" data-lfr-editable-id="element-text" data-lfr-editable-type="rich-text">\u000a\u0009A paragraph is a self-contained unit of a discourse in writing dealing with\u000a\u0009a particular point or idea. Paragraphs are usually an expected part of\u000a\u0009formal writing, used to organize longer prose.\u000a</div>','','','0','{"com.liferay.fragment.entry.processor.editable.EditableFragmentEntryProcessor":{"element-text":{"defaultValue":"\n\tA paragraph is a self-contained unit of a discourse in writing dealing with\n\ta particular point or idea. Paragraphs are usually an expected part of\n\tformal writing, used to organize longer prose.\n","en_US":"Our goal is to be your trusted partner in eye care, offering unparalleled support and collaboration to acheieve your vision. Elevate your brand with premium eyeglass frames and lenses.","config":{"mapperType":"link"}}}}','intw',1,'BASIC_COMPONENT-paragraph',1,'2025-11-06 19:44:25.244000',NULL,'b3226517-1428-d427-d941-73affe549fee')
