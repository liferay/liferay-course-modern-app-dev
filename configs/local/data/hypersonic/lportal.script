INSERT INTO CPDEFINITIONLOCALIZATION VALUES(1,0,51561,16796623585306,51558,'en_US','Classic Aviator Sunglasses',NULL,'<p>Introducing our must-have accessory for sunny days \u2013 our classic\u000a  aviator sunglasses! \ud83d\udd76\ufe0f</p>\u000a<p>Whether you''re lounging on the beach, driving with the top down, or\u000a  just enjoying a leisurely walk, these sunglasses are the perfect blend\u000a  of style and functionality. The timeless aviator design never goes out\u000a  of fashion, making them a versatile choice for any outfit or occasion.</p>\u000a<p>Crafted with high-quality materials, these sunglasses offer not only\u000a  a sleek look but also durability to withstand your fun-filled outdoor\u000a  adventures. The UV-protective lenses ensure your eyes stay safe from\u000a  the sun''s harmful rays, so you can focus on soaking up the sunshine.</p>\u000a<p>With a comfortable fit and lightweight feel, you''ll forget you''re\u000a  even wearing them \u2013 until you catch a glimpse of your stylish self,\u000a  that is! So why not elevate your sunny day look with our classic\u000a  aviator sunglasses? Trust us, you won''t want to leave home without\u000a  them! \ud83d\ude0e</p>',NULL,NULL,NULL)
