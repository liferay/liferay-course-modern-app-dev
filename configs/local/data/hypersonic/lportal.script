INSERT INTO KALEODEFINITION VALUES(1,0,31813,0,16796623585306,20095,NULL,'2024-05-13 14:38:19.267000','2024-05-13 14:38:19.383000','message-boards-user-stats-moderation','<?xml version=''1.0'' encoding=''UTF-8''?><root available-locales="en_US,sv_SE,pt_BR,fr_FR,ja_JP,ca_ES,de_DE,hu_HU,ar_SA,fi_FI,zh_CN,es_ES,nl_NL" default-locale="en_US"><title language-id="sv_SE">Moderering av anv\u00e4ndarstatistik f\u00f6r diskussionsforum</title><title language-id="pt_BR">Modera\u00e7\u00e3o de estat\u00edsticas de usu\u00e1rio do f\u00f3rum</title><title language-id="fr_FR">Mod\u00e9ration sur statistiques utilisateur des forums de discussion</title><title language-id="ja_JP">\u63b2\u793a\u677f\u30e6\u30fc\u30b6\u30fc\u7d71\u8a08\u306e\u627f\u8a8d</title><title language-id="ca_ES">Moderaci\u00f3 de les estad\u00edstiques d''usuari dels taulers de missatges</title><title language-id="de_DE">Moderation der Foren-Benutzerstatistiken</title><title language-id="hu_HU">F\u00f3rumok felhaszn\u00e1l\u00f3i statisztik\u00e1inak a moder\u00e1l\u00e1sa</title><title language-id="ar_SA">\u0627\u0644\u0625\u0634\u0631\u0627\u0641 \u0639\u0644\u0649 \u0625\u062d\u0635\u0627\u0621\u0627\u062a \u0645\u0633\u062a\u062e\u062f\u0645 \u0644\u0648\u062d\u0627\u062a \u0627\u0644\u0631\u0633\u0627\u0626\u0644</title><title language-id="fi_FI">Keskustelualueiden k\u00e4ytt\u00e4j\u00e4tilastojen moderointi</title><title language-id="en_US">Message Boards User Stats Moderation</title><title language-id="zh_CN">\u7559\u8a00\u677f\u7528\u6237\u7edf\u8ba1\u5ba1\u6838</title><title language-id="es_ES">Moderaci\u00f3n de estad\u00edsticas de usuario de los foros de discusi\u00f3n</title><title language-id="nl_NL">Moderatiestatistieken forumgebruiker</title></root>','Users with a reputation over the threshold get their threads and comments approved automatically.','{"#tag-name":"workflow-definition","#child-nodes":[{"#tag-name":"name","#value":"Message Board Threads and Comments Reputation Approver"},{"#tag-name":"description","#value":"Users with a reputation over the threshold get their threads and comments approved automatically."},{"#tag-name":"version","#value":"1"},{"#tag-name":"condition","#child-nodes":[{"#tag-name":"name","#value":"check-reputation"},{"#tag-name":"metadata","#cdata-value":["","                {","                    \"xy\": [","                        199,","                        43","                    ]","                }","            "]},{"#tag-name":"script","#cdata-value":["com.liferay.message.boards.moderation.internal.kaleo.runtime.condition.MBModerationConditionEvaluator"]},{"#tag-name":"script-language","#value":"java"},{"#tag-name":"transitions","#child-nodes":[{"#tag-name":"transition","#child-nodes":[{"#tag-name":"name","#value":"approve"},{"#tag-name":"target","#value":"approved"},{"#tag-name":"default","#value":"true"}]},{"#tag-name":"transition","#child-nodes":[{"#tag-name":"name","#value":"review"},{"#tag-name":"target","#value":"review"},{"#tag-name":"default","#value":"false"}]}]}]},{"#tag-name":"state","#child-nodes":[{"#tag-name":"name","#value":"created"},{"#tag-name":"metadata","#cdata-value":["","                {","                    \"xy\": [","                        36,","                        51","                    ]","                }","            "]},{"#tag-name":"initial","#value":"true"},{"#tag-name":"transitions","#child-nodes":[{"#tag-name":"transition","#child-nodes":[{"#tag-name":"name","#value":"check-reputation"},{"#tag-name":"target","#value":"check-reputation"},{"#tag-name":"default","#value":"true"}]}]}]},{"#tag-name":"state","#child-nodes":[{"#tag-name":"name","#value":"approved"},{"#tag-name":"metadata","#cdata-value":["","                {","                    \"terminal\": true,","                    \"xy\": [","                        648,","                        50","                    ]","                }","            "]},{"#tag-name":"actions","#child-nodes":[{"#tag-name":"acti