INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2139,16796623585306,1641,44245,'name','en_US','','"leader-nigel-cook.png"')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2140,16796623585306,1641,44245,'width','en_US','','"290"')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2141,16796623585306,1641,44245,'description','en_US','','"leader-nigel-cook-headshot"')
