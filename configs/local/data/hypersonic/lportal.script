"\u000a\u0009\u0009\u0009\u0009\u0009type="submit"\u000a\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009<@liferay_aui.select\u000a\u0009\u0009\u0009\u0009cssClass="search-bar-scope-select"\u000a\u0009\u0009\u0009\u0009disabled=true\u000a\u0009\u0009\u0009\u0009label=""\u000a\u0009\u0009\u0009\u0009name=htmlUtil.escape(searchBarPortletDisplayContext.getScopeParameterName())\u000a\u0009\u0009\u0009\u0009title="scope"\u000a\u0009\u0009\u0009\u0009useNamespace=false\u000a\u0009\u0009\u0009\u0009wrapperCssClass="input-group-item input-group-item-shrink input-group-prepend search-bar-search-select-wrapper"\u000a\u0009\u0009\u0009>\u000a\u0009\u0009\u0009\u0009<@liferay_aui.option\u000a\u0009\u0009\u0009\u0009\u0009label="this-site"\u000a\u0009\u0009\u0009\u0009\u0009selected=searchBarPortletDisplayContext.isSelectedCurrentSiteSearchScope()\u000a\u0009\u0009\u0009\u0009\u0009value=searchBarPortletDisplayContext.getCurrentSiteSearchScopeParameterString()\u000a\u0009\u0009\u0009\u0009/>\u000a\u000a\u0009\u0009\u0009\u0009<#if searchBarPortletDisplayContext.isAvailableEverythingSearchScope()>\u000a\u0009\u0009\u0009\u0009\u0009<@liferay_aui.option\u000a\u0009\u0009\u0009\u0009\u0009\u0009label="everything"\u000a\u0009\u0009\u0009\u0009\u0009\u0009selected=searchBarPortletDisplayContext.isSelectedEverythingSearchScope()\u000a\u0009\u0009\u0009\u0009\u0009\u0009value=searchBarPortletDisplayContext.getEverythingSearchScopeParameterString()\u000a\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009</#if>\u000a\u0009\u0009\u0009</@>\u000a\u000a\u0009\u0009\u0009<#assign data = {\u000a\u0009\u0009\u0009\u0009"test-id": "searchInput"\u000a\u0009\u0009\u0009} />\u000a\u000a\u0009\u0009\u0009<@liferay_aui.input\u000a\u0009\u0009\u0009\u0009autoFocus=true\u000a\u0009\u0009\u0009\u0009autocomplete="off"\u000a\u0009\u0009\u0009\u0009cssClass="search-bar-keywords-input"\u000a\u0009\u0009\u0009\u0009data=data\u000a\u0009\u0009\u0009\u0009disabled=true\u000a\u0009\u0009\u0009\u0009label=""\u000a\u0009\u0009\u0009\u0009name=htmlUtil.escape(searchBarPortletDisplayContext.getKeywordsParameterName())\u000a\u0009\u0009\u0009\u0009placeholder=searchBarPortletDisplayContext.getInputPlaceholder()\u000a\u0009\u0009\u0009\u0009title=languageUtil.get(locale, "search")\u000a\u0009\u0009\u0009\u0009type="text"\u000a\u0009\u0009\u0009\u0009useNamespace=false\u000a\u0009\u0009\u0009\u0009value=htmlUtil.escape(searchBarPortletDisplayContext.getKeywords())\u000a\u0009\u0009\u0009\u0009wrapperCssClass="input-group-item input-group-append search-bar-keywords-input-wrapper"\u000a\u0009\u0009\u0009/>\u000a\u0009\u0009<#else>\u000a\u0009\u0009\u0009<div class="input-group-item search-bar-keywords-input-wrapper">\u000a\u0009\u0009\u0009\u0009<input\u000a\u0009\u0009\u0009\u0009\u0009autocomplete="off"\u000a\u0009\u0009\u0009\u0009\u0009class="form-control input-group-inset input-group-inset-before search-bar-keywords-input"\u000a\u0009\u0009\u0009\u0009\u0009data-qa-id="searchInput"\u000a\u0009\u0009\u0009\u0009\u0009disabled=true\u000a\u0009\u0009\u0009\u0009\u0009id="${namespace + stringUtil.randomId()}"\u000a\u0009\u0009\u0009\u0009\u0009name="${htmlUtil.escape(searchBarPortletDisplayContext.getKeywordsParameterName())}"\u000a\u0009\u0009\u0009\u0009\u0009placeholder="${searchBarPortletDisplayContext.getInputPlaceholder()}"\u000a\u0009\u0009\u0009\u0009\u0009title="${languageUtil.get(locale, "search")}"\u000a\u0009\u0009\u0009\u0009\u0009type="text"\u000a\u0009\u0009\u0009\u0009\u0009value="${htmlUtil.escape(searchBarPortletDisplayContext.getKeywords())}"\u000a\u0009\u0009\u0009\u0009/>\u000a\u000a\u0009\u0009\u0009\u0009<div class="input-group-inset-item input-group-inset-item-before">\u000a\u0009\u0009\u0009\u0009\u0009<@clay["button"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009aria\-label="${languageUtil.get(locale, ''search'')}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009cssClass="search-bar-submit-button"\u000a\u0009\u0009\u0009\u0009\u0009\u0009disabled=true\u000a\u0009\u0009\u0009\u0009\u0009\u0009displayType="unstyled"\u000a\u0009\u0009\u0009\u0009\u0009\u0009icon="search"\u000a\u0009\u0009\u0009\u0009\u0009\u0009type="submit"\u000a\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u0009<@liferay_aui.input\u000a\u0009\u0009\u0009\u0009\u0009name=htmlUtil.escape(searchBarPortletDisplayContext.getScopeParameterName())\u000a\u0009\u0009\u0009\u0009\u0009type="hidden"\u000a\u0009\u0009\u0009\u0009\u0009value=searchBarPortletDisplayContext.getScopeParameterValue()\u000a\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009</div>\u000a\u0009\u0009</#if>\u000a\u0009</div>\u000a</@>','0','0',31665,NULL,NULL,'3260aa5e-c1a9-a925-b5e1-cff98fb7a270')
INSERT INTO DDMTEMPLATE VALUES(1,0,'0926714b-ff51-0f4e-9abf-d331f130cc62',31668,20119,16796623585306,20095,NULL,20095,NULL,'2024-05-13 14:37:49.917000','2024-08-07 01:06:31.661000',31667,0,31505,'SEARCH-RESULTS-COMPACT-FTL','1.1','<?xml version=''1.0'' encoding=''UTF-8''?><root available-locales="en_US,sv_SE,pt_BR,ja_JP,fr_FR,hu_HU,de_DE,ca_ES,ar_SA,fi_FI,zh_CN,es_ES,nl_NL" default-locale="en_US"><Name language-id="en_US">Compact Layout</Name><Name language-id="ar_SA">\u0645\u062e\u0637\u0637 \u0645\u0636\u063a\u0648\u0637</Name><Name language-id="ca_ES">Disposici\u00f3 compacta</Name><Name language-id="zh_CN">\u7d27\u51d1\u5e03\u5c40</Name><Name language-id="nl_NL">Compacte lay-out</Name><Name language-id="fi_FI">Tiivis Asettelu</Name><Name language-id="fr_FR">Disposition compacte</Name><Name language-id="de_DE">Kompaktes Layout</Name><Name language-id="hu_HU">Kompakt elrendez\u00e9s</Name><Name language-id="ja_JP">\u30b3\u30f3\u30d1\u30af\u30c8\u30ec\u30a4\u30a2\u30a6\u30c8</Name><Name language-id="pt_BR">Layout compacto</Name><Name language-id="es_ES">Dise\u00f1o compacto</Name><Name language-id="sv_SE">Kompakt layout</Name></root>','<?xml version=''1.0'' encoding=''UTF-8''?><root available-locales="en_US,sv_SE,pt_BR,ja_JP,fr_FR,hu_HU,de_DE,ca_ES,ar_SA,fi_FI,zh_CN,es_ES,nl_NL" default-locale="en_US"><Description language-id="en_US">Display results with only their title.</Description><Description language-id="ar_SA">\u0639\u0631\u0636 \u0627\u0644\u0646\u062a\u0627\u0626\u062c \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0639\u0646\u0648\u0627\u0646\u0647\u0627 \u0641\u0642\u0637.</Description><Description language-id="ca_ES">Mostra els resultats nom\u00e9s amb el t\u00edtol.</Description><Description language-id="zh_CN">\u663e\u793a\u7ed3\u679c\u53ca\u5176\u6807\u9898\u3002</Description><Description language-id="nl_NL">Resultaten weergeven met enkel hun titel.</Description><Description language-id="fi_FI">N\u00e4yt\u00e4 tulokset vain otsikoinaan.</Description><Description language-id="fr_FR">Afficher les r\u00e9sultats avec seulement leur intitul\u00e9.</Description><Description language-id="de_DE">Ergebnisse nur mit ihrem Titel anzeigen.</Description><Description language-id="hu_HU">Az eredm\u00e9nyeket csak a c\u00edm\u00fckkel jelen\u00edtse meg.</Description><Description language-id="ja_JP">\u7d50\u679c\u306b\u3064\u3044\u3066\u30bf\u30a4\u30c8\u30eb\u306e\u307f\u3092\u8868\u793a\u3057\u307e\u3059\u3002</Description><Description language-id="pt_BR">Exibir resultados com apenas seus t\u00edtulos.</Description><Description language-id="es_ES">Muestra resultados solo con el t\u00edtulo.</Description><Description language-id="sv_SE">Visa bara resultat med titel.</Description></root>','display',NULL,'ftl','<div class="c-mb-4 c-mt-4 search-total-label">\u000a\u0009<#if searchContainer.getTotal() == 1>\u000a\u0009\u0009${languageUtil.format(locale, "x-result-for-x", [searchContainer.getTotal(), "<strong>" + htmlUtil.escape(searchResultsPortletDisplayContext.getKeywords()) + "</strong>"], false)}\u000a\u0009<#else>\u000a\u0009\u0009${languageUtil.format(locale, "x-results-for-x", [searchContainer.getTotal(), "<strong>" + htmlUtil.escape(searchResultsPortletDisplayContext.getKeywords()) + "</strong>"], false)}\u000a\u0009</#if>\u000a</div>\u000a\u000a<div class="display-compact">\u000a\u0009<ul class="list-unstyled">\u000a\u0009\u0009<#if entries?has_content>\u000a\u0009\u0009\u0009<#list entries as entry>\u000a\u0009\u0009\u0009\u0009<li class="align-items-center d-flex">\u000a\u0009\u0009\u0009\u0009\u0009<div class="c-mb-2 c-mt-2">\u000a\u0009\u0009\u0009\u0009\u0009\u0009<a class="link-primary single-link" href="${entry.getViewURL()}">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009${entry.getHighlightedTitle()}\u000a\u0009\u0009\u0009\u0009\u0009\u0009</a>\u000a\u0009\u0009\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u0009\u0009<#if entry.isAssetRendererURLDownloadVisible()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009<span\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009class="lfr-portal-tooltip c-ml-1"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009title="${languageUtil.format(locale, ''download-x'', [''('' + languageUtil.formatStorageSize(entry.getAssetRendererDownloadSize(), locale) + '')''])}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@clay.link\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009aria\-label="${languageUtil.format(locale, ''download-x'', [entry.getTitle()])}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009cssClass="link-monospaced link-outline link-outline-borderless link-outline-secondary"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009displayType="secondary"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009href="${entry.getAssetRendererURLDownload()}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@clay.icon symbol="download" />\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</@clay.link>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u0009\u0009\u0009\u0009</li>\u000a\u0009\u0009\u0009</#list>\u000a\u0009\u0009</#if>\u000a\u0009</ul>\u000a</div>','0','0',31669,NULL,NULL,'0926714b-ff51-0f4e-9abf-d331f130cc62')
INSERT INTO DDMTEMPLATE VALUES(2,0,'4698c298-94ce-3ee4-44d7-7dd78460259c',31671,20119,16796623585306,20095,NULL,20095,NULL,'2024-05-13 14:37:49.919000','2024-10-21 12:37:34.810000',31667,0,31505,'SEARCH-RESULTS-LIST-FTL','1.2','<?xml version="1.0" ?><root available-locales="en_US,sv_SE,pt_BR,ja_JP,fr_FR,hu_HU,de_DE,ca_ES,ar_SA,fi_FI,zh_CN,es_ES,nl_NL" default-locale="en_US"><Name language-id="en_US">List Layout</Name><Name language-id="ar_SA">\u0645\u062e\u0637\u0637 \u0627\u0644\u0642\u0627\u0626\u0645\u0629</Name><Name language-id="ca_ES">Disposici\u00f3 de la llista</Name><Name language-id="zh_CN">\u5217\u8868\u5e03\u5c40</Name><Name language-id="nl_NL">Lijstlay-out</Name><Name language-id="fi_FI">Luetteloasettelu</Name><Name language-id="fr_FR">Disposition en liste</Name><Name language-id="de_DE">Listenlayout</Name><Name language-id="hu_HU">Lista elrendez\u00e9s</Name><Name language-id="ja_JP">\u30ea\u30b9\u30c8\u30ec\u30a4\u30a2\u30a6\u30c8</Name><Name language-id="pt_BR">Layout da lista</Name><Name language-id="es_ES">Dise\u00f1o de lista</Name><Name language-id="sv_SE">Listlayout</Name></root>','<?xml version="1.0" ?><root available-locales="en_US,sv_SE,pt_BR,ja_JP,fr_FR,hu_HU,de_DE,ca_ES,ar_SA,fi_FI,zh_CN,es_ES,nl_NL" default-locale="en_US"><Description language-id="en_US">Display results with their title, creator''s user name, asset type, and creation date.</Description><Description language-id="ar_SA">\u0639\u0631\u0636 \u0627\u0644\u0646\u062a\u0627\u0626\u062c \u0645\u0646 \u062e\u0644\u0627\u0644 \u0639\u0646\u0627\u0648\u064a\u0646\u0647\u0627\u060c \u0648\u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0645\u0646\u0634\u0626 \u0648\u0646\u0648\u0639 \u0627\u0644\u0623\u0635\u0644 \u0648\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0646\u0634\u0627\u0621.</Description><Description language-id="ca_ES">Mostra els resultats amb el t\u00edtol, el nom d''usuari del creador, el tipus de contingut i la data de creaci\u00f3.</Description><Description language-id="zh_CN">\u663e\u793a\u7ed3\u679c\u53ca\u5176\u6807\u9898\u3001\u521b\u5efa\u8005\u7528\u6237\u540d\u3001\u8d44\u6e90\u7c7b\u578b\u548c\u521b\u5efa\u65e5\u671f\u3002</Description><Description language-id="nl_NL">Resultaten weergeven met hun titel, de gebruikersnaam van de maker, het assettype en de aanmaakdatum.</Description><Description language-id="fi_FI">N\u00e4yt\u00e4 tulokset otsikoineen, luojan k\u00e4ytt\u00e4j\u00e4nimineen, sis\u00e4lt\u00f6tyyppeineen ja luontip\u00e4ivineen.</Description><Description language-id="fr_FR">Afficher les r\u00e9sultats avec leur intitul\u00e9, le nom d''utilisateur du cr\u00e9ateur, le type d''actif et la date de cr\u00e9ation.</Description><Description language-id="de_DE">Ergebnisse mit deren Titel, Benutzername des Erstellers, Assettyp und Erstellungsdatum anzeigen.</Description><Description language-id="hu_HU">A tal\u00e1latokat jelen\u00edtse meg c\u00edmmel, a k\u00e9sz\u00edt\u0151 felhaszn\u00e1l\u00f3nev\u00e9vel, tartalomt\u00edpussal \u00e9s le\u00edr\u00e1ssal.</Description><Description language-id="ja_JP">\u7d50\u679c\u3068\u305d\u306e\u30bf\u30a4\u30c8\u30eb\u3001\u4f5c\u6210\u8005\u306e\u30e6\u30fc\u30b6\u30fc\u540d\u3001\u30a2\u30bb\u30c3\u30c8\u30bf\u30a4\u30d7\u3001\u4f5c\u6210\u65e5\u3092\u8868\u793a\u3057\u307e\u3059\u3002</Description><Description language-id="pt_BR">Exibir resultados com seus t\u00edtulos, nome de usu\u00e1rio do criador, tipo de conte\u00fado e data de cria\u00e7\u00e3o.</Description><Description language-id="es_ES">Muestra resultados con el t\u00edtulo, el nombre de usuario del autor, el tipo de activo y la fecha de creaci\u00f3n.</Description><Description language-id="sv_SE">Visa resultat med titel, skaparens anv\u00e4ndarnamn, tillg\u00e5ngstyp och skapandedatum.</Description></root>','display',NULL,'ftl','<div class="c-mb-4 c-mt-4 search-total-label">\u000a\u0009<#if searchContainer.getTotal() == 1>\u000a\u0009\u0009${languageUtil.format(locale, "x-result-for-x", [searchContainer.getTotal(), "<strong>" + htmlUtil.escape(searchResultsPortletDisplayContext.getKeywords()) + "</strong>"], false)}\u000a\u0009<#else>\u000a\u0009\u0009${languageUtil.format(locale, "x-results-for-x", [searchContainer.getTotal(), "<strong>" + htmlUtil.escape(searchResultsPortletDisplayContext.getKeywords()) + "</strong>"], false)}\u000a\u0009</#if>\u000a</div>\u000a\u000a<div class="display-list">\u000a\u0009<ul class="list-group" id="search-results-display-list">\u000a\u0009\u0009<#if entries?has_content>\u000a\u0009\u0009\u0009<#list entries as entry>\u000a\u0009\u0009\u0009\u0009<li class="list-group-item list-group-item-flex">\u000a\u0009\u0009\u0009\u0009\u0009<div class="autofit-col">\u000a\u0009\u0009\u0009\u0009\u0009\u0009<#if entry.isThumbnailVisible()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span class="sticker">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span class="sticker-overlay">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<img\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009alt="${languageUtil.get(locale, "thumbnail")}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009class="sticker-img"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009src="${entry.getThumbnailURLString()}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u0009\u0009\u0009\u0009\u0009\u0009<#elseif entry.isUserPortraitVisible() && stringUtil.equals(entry.getClassName(), userClassName)>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_ui["user-portrait"] userId=entry.getAssetEntryUserId() />\u000a\u0009\u0009\u0009\u0009\u0009\u0009<#elseif entry.isIconVisible()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span class="sticker sticker-rounded sticker-secondary sticker-static">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@clay.icon symbol="${entry.getIconId()}" />\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u0009\u0009\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u0009\u0009<div class="autofit-col autofit-col-expand">\u000a\u0009\u0009\u0009\u0009\u0009\u0009<section class="autofit-section">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<div class="c-mt-0 list-group-title">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<a href="${entry.getViewURL()}">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009${entry.getHighlightedTitle()}\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</a>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<div class="search-results-metadata">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<p class="list-group-subtext">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if entry.isModelResourceVisible()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span class="subtext-item">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<strong>${entry.getModelResource()}</strong>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if entry.isLocaleReminderVisible()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span class="lfr-portal-tooltip" title="${entry.getLocaleReminder()}">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@clay["icon"] symbol="${entry.getLocaleLanguageId()?lower_case?replace(''_'', ''-'')}" />\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if entry.isCreatorVisible()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span class="subtext-item">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009&#183;\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay.language key="written-by" />\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<strong>${htmlUtil.escape(entry.getCreatorUserName())}</strong>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if entry.isCreationDateVisible()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span class="subtext-item">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay.language key="on-date" />\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009${entry.getCreationDateString()}\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</p>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if entry.isContentVisible()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<p class="list-group-subtext">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span class="subtext-item">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009${entry.getContent()}\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</p>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if entry.isFieldsVisible()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<p class="list-group-subtext">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#assign separate = false />\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#list entry.getFieldDisplayContexts() as fieldDisplayContext>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if separate>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009&#183;\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span class="badge">${fieldDisplayContext.getName()}</span>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span>${fieldDisplayContext.getValuesToString()}</span>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#assign separate = true />\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#list>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</p>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if entry.isAssetCategoriesOrTagsVisible()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<div class="c-mt-2 h6 search-document-tags text-default">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_asset["asset-tags-summary"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009className=entry.getClassName()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009classPK=entry.getClassPK()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009paramName=entry.getFieldAssetTagNames()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009portletURL=entry.getPortletURL()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay_asset["asset-categories-summary"]\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009className=entry.getClassName()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009classPK=entry.getClassPK()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009paramName=entry.getFieldAssetCategoryIds()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009portletURL=entry.getPortletURL()\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009/>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if entry.isDocumentFormVisible()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<div class="expand-details text-default">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span class="list-group-text text-2">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<a href="javascript:void(0);" role="button">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay.language key="details" />...\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</a>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<div class="hide search-results-list table-details table-responsive">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<table class="table table-head-bordered table-hover table-sm table-striped">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<thead>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<tr>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<th class="table-cell-expand-smaller table-cell-text-end">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay.language key="key" />\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</th>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<th class="table-cell-expand">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@liferay.language key="value" />\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</th>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</tr>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</thead>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<tbody>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#list entry.getDocumentFormFieldDisplayContexts() as fieldDisplayContext>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<tr>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<td class="table-cell-expand-smaller table-cell-text-end table-details-content">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<strong>${htmlUtil.escape(fieldDisplayContext.getName())}</strong>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</td>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<td class="table-cell-expand table-details-content">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<code>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009${fieldDisplayContext.getValuesToString()}\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</code>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</td>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</tr>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#list>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</tbody>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</table>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</section>\u000a\u0009\u0009\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u0009\u0009<#if entry.isAssetRendererURLDownloadVisible()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009<div class="autofit-col">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009class="c-mt-2 lfr-portal-tooltip"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009title="${languageUtil.format(locale, ''download-x'', [''('' + languageUtil.formatStorageSize(entry.getAssetRendererDownloadSize(), locale) + '')''])}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@clay.link\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009aria\-label="${languageUtil.format(locale, ''download-x'', [entry.getTitle()])}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009cssClass="link-monospaced link-outline link-outline-borderless link-outline-secondary"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009displayType="secondary"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009href="${entry.getAssetRendererURLDownload()}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@clay.icon symbol="download" />\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</@clay.link>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u0009\u0009\u0009\u0009</li>\u000a\u0009\u0009\u0009</#list>\u000a\u0009\u0009</#if>\u000a\u0009</ul>\u000a</div>\u000a\u000a<@liferay_aui.script use="aui-base">\u000a\u0009A.one(''#search-results-display-list'').delegate(\u000a\u0009\u0009''click'',\u000a\u0009\u0009function(event) {\u000a\u0009\u0009\u0009var currentTarget = event.currentTarget;\u000a\u000a\u0009\u0009\u0009currentTarget.siblings(''.search-results-list'').toggleClass(''hide'');\u000a\u0009\u0009},\u000a\u0009\u0009''.expand-details''\u000a\u0009);\u000a</@liferay_aui.script>','0','0',31672,NULL,NULL,'4698c298-94ce-3ee4-44d7-7dd78460259c')
INSERT INTO DDMTEMPLATE VALUES(1,0,'9c6a718a-5921-b9b1-a96b-3f8b3ab06cc6',31674,20119,16796623585306,20095,NULL,20095,NULL,'2024-05-13 14:37:49.921000','2024-08-07 01:06:31.675000',31667,0,31505,'SEARCH-RESULTS-CARD-FTL','1.1','<?xml version=''1.0'' encoding=''UTF-8''?><root available-locales="en_US,sv_SE,pt_BR,ja_JP,fr_FR,hu_HU,de_DE,ca_ES,ar_SA,fi_FI,zh_CN,es_ES,nl_NL" default-locale="en_US"><Name language-id="en_US">Card Layout</Name><Name language-id="ar_SA">\u0645\u062e\u0637\u0637 \u0627\u0644\u0628\u0637\u0627\u0642\u0629</Name><Name language-id="ca_ES">Disposici\u00f3 de la targeta</Name><Name language-id="zh_CN">\u5361\u7247\u5e03\u5c40</Name><Name language-id="nl_NL">Kaartlay-out</Name><Name language-id="fi_FI">Kortin Asettelu</Name><Name language-id="fr_FR">Disposition de la carte</Name><Name language-id="de_DE">Kartenlayout</Name><Name language-id="hu_HU">K\u00e1rtyaelrendez\u00e9s</Name><Name language-id="ja_JP">\u30ab\u30fc\u30c9\u30ec\u30a4\u30a2\u30a6\u30c8</Name><Name language-id="pt_BR">Layout do cart\u00e3o</Name><Name language-id="es_ES">Dise\u00f1o de tarjeta</Name><Name language-id="sv_SE">Kortlayout</Name></root>','<?xml version=''1.0'' encoding=''UTF-8''?><root available-locales="en_US,sv_SE,pt_BR,ja_JP,fr_FR,hu_HU,de_DE,ca_ES,ar_SA,fi_FI,zh_CN,es_ES,nl_NL" default-locale="en_US"><Description language-id="en_US">Display results with a grid of cards.</Description><Description language-id="ar_SA">\u0639\u0631\u0636 \u0627\u0644\u0646\u062a\u0627\u0626\u062c \u0645\u0646 \u062e\u0644\u0627\u0644 \u0634\u0628\u0643\u0629 \u0645\u0646 \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a.</Description><Description language-id="ca_ES">Mostra els resultats com una s\u00e8rie de cartes.</Description><Description language-id="zh_CN">\u663e\u793a\u7ed3\u679c\u4e0e\u5361\u7247\u7f51\u683c\u3002</Description><Description language-id="nl_NL">Resultaten weergeven als een kaartenrooster.</Description><Description language-id="fi_FI">N\u00e4yt\u00e4 tulokset korttien ruudukkona.</Description><Description language-id="fr_FR">Afficher les r\u00e9sultats sous la forme de grille de cartes.</Description><Description language-id="de_DE">Ergebnisse als Kartengitter anzeigen.</Description><Description language-id="hu_HU">Az eredm\u00e9nyeket jelen\u00edtse meg k\u00e1rtyar\u00e1csk\u00e9nt.</Description><Description language-id="ja_JP">\u7d50\u679c\u3092\u30b0\u30ea\u30c3\u30c9\u72b6\u306b\u914d\u7f6e\u3057\u305f\u30ab\u30fc\u30c9\u3067\u8868\u793a\u3057\u307e\u3059\u3002</Description><Description language-id="pt_BR">Exibir resultados com uma s\u00e9rie de cart\u00f5es.</Description><Description language-id="es_ES">Muestra resultados con una cuadr\u00edcula de tarjetas.</Description><Description language-id="sv_SE">Visa resultat som ett rutn\u00e4t med kort.</Description></root>','display',NULL,'ftl','<div class="c-mb-4 c-mt-4 search-total-label">\u000a\u0009<#if searchContainer.getTotal() == 1>\u000a\u0009\u0009${languageUtil.format(locale, "x-result-for-x", [searchContainer.getTotal(), "<strong>" + htmlUtil.escape(searchResultsPortletDisplayContext.getKeywords()) + "</strong>"], false)}\u000a\u0009<#else>\u000a\u0009\u0009${languageUtil.format(locale, "x-results-for-x", [searchContainer.getTotal(), "<strong>" + htmlUtil.escape(searchResultsPortletDisplayContext.getKeywords()) + "</strong>"], false)}\u000a\u0009</#if>\u000a</div>\u000a\u000a<div class="display-card">\u000a\u0009<ul class="card-page">\u000a\u0009\u0009<#if entries?has_content>\u000a\u0009\u0009\u0009<#list entries as entry>\u000a\u0009\u0009\u0009\u0009<li class="card-page-item card-page-item-asset">\u000a\u0009\u0009\u0009\u0009\u0009<div class="card card-type-asset file-card">\u000a\u0009\u0009\u0009\u0009\u0009\u0009<div class="aspect-ratio card-item-first">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if entry.isThumbnailVisible()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<img alt="${htmlUtil.escape(entry.getTitle())}" class="aspect-ratio-item aspect-ratio-item-center-middle aspect-ratio-item-vertical-fluid" src="${entry.getThumbnailURLString()}" />\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#elseif entry.isUserPortraitVisible() && stringUtil.equals(entry.getClassName(), userClassName)>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<div class="user-card">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<div class="aspect-ratio-item aspect-ratio-item-center-middle aspect-ratio-item-vertical-fluid card-type-asset-icon">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span class="sticker sticker-secondary sticker-user-icon">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span class="sticker-overlay">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<img alt="${htmlUtil.escape(entry.getTitle())}" class="img-fluid" src="${entry.getUserPortraitURLString()}" />\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#else>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<div class="aspect-ratio-item aspect-ratio-item-center-middle aspect-ratio-item-vertical-fluid card-type-asset-icon">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@clay.icon symbol="${(entry.isIconVisible())?then(entry.getIconId(),''web-content'')}" />\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009<div class="card-body">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<div class="card-row">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<div class="autofit-col autofit-col-expand">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<section class="autofit-section">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<h3 class="card-title">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<a href="${entry.getViewURL()}">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009${entry.getHighlightedTitle()}\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</a>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</h3>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if entry.isCreatorVisible()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<p class="card-subtitle text-2">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span class="text-truncate-inline">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span class="text-truncate">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009${htmlUtil.escape(entry.getCreatorUserName())}\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</p>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if entry.isCreationDateVisible()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<p class="card-subtitle text-2">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span class="text-truncate-inline">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span class="text-truncate">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009${entry.getCreationDateString()}\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</p>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if entry.isModelResourceVisible()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<p class="card-subtitle text-2">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span class="text-truncate-inline">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span class="text-truncate">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009${entry.getModelResource()}\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</p>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if entry.isContentVisible()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<p class="c-mt-1 card-description text-2">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009${entry.getContent()}\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</p>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</section>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if entry.isAssetRendererURLDownloadVisible()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<div class="autofit-col c-mr-n2">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<span\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009class="lfr-portal-tooltip"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009title="${languageUtil.format(locale, ''download-x'', [''('' + languageUtil.formatStorageSize(entry.getAssetRendererDownloadSize(), locale) + '')''])}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@clay.link\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009aria\-label="${languageUtil.format(locale, ''download-x'', [entry.getTitle()])}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009cssClass="link-monospaced link-outline link-outline-borderless link-outline-secondary"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009displayType="secondary"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009href="${entry.getAssetRendererURLDownload()}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<@clay.icon symbol="download" />\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</@clay.link>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</span>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009\u0009</li>\u000a\u0009\u0009\u0009</#list>\u000a\u0009\u0009</#if>\u000a\u0009</ul>\u000a</div>','0','0',31675,NULL,NULL,'9c6a718a-5921-b9b1-a96b-3f8b3ab06cc6')
INSERT INTO DDMTEMPLATE VALUES(0,0,'a4d285d0-3905-aa03-8d55-8a0fcdd47e34',31678,20119,16796623585306,20095,NULL,20095,NULL,'2024-05-13 14:37:50.334000','2024-05-13 14:37:50.334000',31677,0,31505,'SITE-FACET-COMPACT-FTL','1.0','<?xml version=''1.0'' encoding=''UTF-8''?><root available-locales="en_US,sv_SE,pt_BR,ja_JP,fr_FR,hu_HU,de_DE,ca_ES,ar_SA,fi_FI,zh_CN,es_ES,nl_NL" default-locale="en_US"><Name language-id="sv_SE">Kompakt layout</Name><Name language-id="pt_BR">Layout compacto</Name><Name language-id="ja_JP">\u30b3\u30f3\u30d1\u30af\u30c8\u30ec\u30a4\u30a2\u30a6\u30c8</Name><Name language-id="fr_FR">Disposition compacte</Name><Name language-id="hu_HU">Kompakt elrendez\u00e9s</Name><Name language-id="de_DE">Kompaktes Layout</Name><Name language-id="ca_ES">Disposici\u00f3 compacta</Name><Name language-id="ar_SA">\u0645\u062e\u0637\u0637 \u0645\u0636\u063a\u0648\u0637</Name><Name language-id="fi_FI">Tiivis Asettelu</Name><Name language-id="en_US">Compact Layout</Name><Name language-id="zh_CN">\u7d27\u51d1\u5e03\u5c40</Name><Name language-id="es_ES">Dise\u00f1o compacto</Name><Name language-id="nl_NL">Compacte lay-out</Name></root>','<?xml version=''1.0'' encoding=''UTF-8''?><root available-locales="en_US,sv_SE,pt_BR,ja_JP,fr_FR,hu_HU,de_DE,ca_ES,ar_SA,fi_FI,zh_CN,es_ES,nl_NL" default-locale="en_US"><Description language-id="sv_SE">Visa villkoren som en lista med l\u00e4nkar.</Description><Description language-id="pt_BR">Exibir termos como uma lista de links.</Description><Description language-id="ja_JP">\u7528\u8a9e\u3092\u30ea\u30f3\u30af\u30ea\u30b9\u30c8\u3068\u3057\u3066\u8868\u793a\u3057\u307e\u3059\u3002</Description><Description language-id="fr_FR">Afficher les termes sous la forme de liste de liens.</Description><Description language-id="hu_HU">Jelen\u00edtse meg a kifejez\u00e9seket hivatkoz\u00e1sok list\u00e1jak\u00e9nt.</Description><Description language-id="de_DE">Begriffe als Linkliste anzeigen.</Description><Description language-id="ca_ES">Mostra els termes com una llista d''enlla\u00e7os.</Description><Description language-id="ar_SA">\u0639\u0631\u0636 \u0627\u0644\u0645\u0635\u0637\u0644\u062d\u0627\u062a \u0643\u0642\u0627\u0626\u0645\u0629 \u0645\u0646 \u0627\u0644\u0631\u0648\u0627\u0628\u0637.</Description><Description language-id="fi_FI">N\u00e4yt\u00e4 termit linkkien luettelona.</Description><Description language-id="en_US">Display terms as a list of links.</Description><Description language-id="zh_CN">\u5c06\u641c\u7d22\u8bcd\u663e\u793a\u4e3a\u94fe\u63a5\u5217\u8868\u3002</Description><Description language-id="es_ES">Muestra t\u00e9rminos como una lista de enlaces.</Description><Description language-id="nl_NL">Termen weergeven als een lijst met links.</Description></root>','display',NULL,'ftl','<@liferay_ui["panel-container"]\u000a\u0009extended=true\u000a\u0009id="${namespace + ''facetScopePanelContainer''}"\u000a\u0009markupView="lexicon"\u000a\u0009persistState=true\u000a>\u000a\u0009<@liferay_ui.panel\u000a\u0009\u0009collapsible=true\u000a\u0009\u0009cssClass="search-facet"\u000a\u0009\u0009id="${namespace + ''facetScopePanel''}"\u000a\u0009\u0009markupView="lexicon"\u000a\u0009\u0009persistState=true\u000a\u0009\u0009title="site"\u000a\u0009>\u000a\u0009\u0009<#if !scopeSearchFacetDisplayContext.isNothingSelected()>\u000a\u0009\u0009\u0009<@clay.button\u000a\u0009\u0009\u0009\u0009cssClass="btn-unstyled c-mb-4 facet-clear-btn"\u000a\u0009\u0009\u0009\u0009displayType="link"\u000a\u0009\u0009\u0009\u0009id="${namespace + ''facetScopeClear''}"\u000a\u0009\u0009\u0009\u0009onClick="Liferay.Search.FacetUtil.clearSelections(event);"\u000a\u0009\u0009\u0009>\u000a\u0009\u0009\u0009\u0009<strong>${languageUtil.get(locale, "clear")}</strong>\u000a\u0009\u0009\u0009</@clay.button>\u000a\u0009\u0009</#if>\u000a\u000a\u0009\u0009<ul class="list-unstyled">\u000a\u0009\u0009\u0009<#if entries?has_content>\u000a\u0009\u0009\u0009\u0009<#list entries as entry>\u000a\u0009\u0009\u0009\u0009\u0009<li>\u000a\u0009\u0009\u0009\u0009\u0009\u0009<@clay.button\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009cssClass="btn-unstyled facet-term ${(entry.isSelected())?then(''facet-term-selected'', ''facet-term-unselected'')} term-name"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009data\-term\-id="${entry.getFilterValue()}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009disabled="true"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009displayType="link"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009onClick="Liferay.Search.FacetUtil.changeSelection(event);"\u000a\u0009\u0009\u0009\u0009\u0009\u0009>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if entry.isSelected()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<strong>${htmlUtil.escape(entry.getBucketText())}</strong>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#else>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009${htmlUtil.escape(entry.getBucketText())}\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if entry.isFrequencyVisible()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<small class="term-count">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009(${entry.getFrequency()})\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</small>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</@clay.button>\u000a\u0009\u0009\u0009\u0009\u0009</li>\u000a\u0009\u0009\u0009\u0009</#list>\u000a\u0009\u0009\u0009</#if>\u000a\u0009\u0009</ul>\u000a\u0009</@>\u000a</@>','0','0',31679,NULL,NULL,'a4d285d0-3905-aa03-8d55-8a0fcdd47e34')
