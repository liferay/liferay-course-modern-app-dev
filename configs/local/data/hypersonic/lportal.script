INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2021,16796623585306,1607,44175,NULL,'en_US','','Alexis Harper')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2022,16796623585306,1608,44175,NULL,'en_US','','Chief Innovation Officer')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2023,16796623585306,1609,44175,NULL,'en_US','<p>Introducing Alexis Harper, our visionary Chief Innovation Officer. With an artistic flair and an eye for the extraordinary, Alexis has played a pivotal role in shaping our eyewear collections. Her innovative designs seamlessly blend fashion and functionality, setting new trends in the industry. Alexis'' commitment to crafting eyewear that not only enhances vision but also makes a bold style statement has positioned our brand at the forefront of chic and sustainable eyewear. Explore the world of eyewear through Alexis imaginative lens and witness the fusion of elegance and innovation at Clarity.</p>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2024,16796623585306,1610,44185,'availableLanguageIds',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2025,16796623585306,1610,44185,'defaultLanguageId',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2026,16796623585306,1611,44185,'groupId','en_US','','"32680"')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2027,16796623585306,1611,44185,'alt','en_US','','"leader-allison-fox-headshot"')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2028,16796623585306,1611,44185,'name','en_US','','"leader-allison-fox.png"')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2029,16796623585306,1611,44185,'width','en_US','','"290"')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2030,16796623585306,1611,44185,'description','en_US','','"leader-allison-fox-headshot"')
