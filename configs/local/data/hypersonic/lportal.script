INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,3242,16796623585306,2616,51851,'height','en_US','','""')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,3243,16796623585306,2617,51851,NULL,'en_US','','<p>The Latest Eyewear Trends for Fashion Enthusiasts</p>')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,3244,16796623585306,2618,51851,NULL,'en_US','<p>Eyewear trends are constantly evolving, and this year is no exception. From oversized frames to colorful lenses, there''s a style for everyone. Retro-inspired round glasses are making a comeback, while cat-eye shapes continue to be a favorite among fashionistas. Clear frames and geometric designs are also gaining popularity. Whether you''re looking for a vintage vibe or a futuristic look, the latest eyewear trends offer something for every taste. Stay ahead of the fashion curve with these stylish eyewear options!</p>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,3245,16796623585306,2619,51861,'availableLanguageIds',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,3246,16796623585306,2619,51861,'defaultLanguageId',NULL,'','en_US')
