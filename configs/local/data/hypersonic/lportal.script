INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,3249,16796623585306,2620,51861,'name','en_US','','"sunglasses-on-shelves.png"')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,3250,16796623585306,2620,51861,'width','en_US','','""')
