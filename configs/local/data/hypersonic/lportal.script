INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2147,16796623585306,1641,44245,'url','en_US','','"\/documents\/d\/asset-library-32679\/leader-nigel-cook"')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2148,16796623585306,1641,44245,'height','en_US','','"306"')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2149,16796623585306,1642,44245,NULL,'en_US','','Nigel Cook')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2150,16796623585306,1643,44245,NULL,'en_US','','Chief Financial Officer')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2151,16796623585306,1644,44245,NULL,'en_US','<p>Nigel Cook is the Chief Financial Officer at Clarity Vision Solutions, a leading manufacturer of innovative and stylish eyewear. With over 20 years of experience in the finance industry, Nigel brings a wealth of knowledge and expertise to his role, overseeing the company\u2019s financial operations and strategies.<br>\u000aNigel joined Clarity Vision Solutions in 2015 and has been instrumental in driving the company\u2019s financial growth and stability. His strategic financial planning and keen insight into market trends have helped Clarity expand its market share and enhance its profitability. Under his leadership, the company has implemented robust financial controls and reporting systems, ensuring transparency and efficiency in all financial activities.<br>\u000aBefore joining Clarity, Nigel held senior financial positions at several multinational corporations, where he honed his skills in financial management, budgeting, and risk assessment. He holds a Bachelor\u2019s degree in Accounting from the University of Manchester and an MBA from London Business School.<br>\u000aNigel is known for his analytical acumen, strong leadership, and commitment to fostering a culture of financial excellence. He is passionate about leveraging financial data to drive business decisions and is dedicated to supporting Clarity''s mission of delivering high-quality eyewear products to customers worldwide.<br>\u000aIn his free time, Nigel enjoys reading, traveling, and exploring new culinary experiences. He is also an avid supporter of various charitable causes and actively participates in community service initiatives.</p>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2201,16796623585306,1701,44756,'availableLanguageIds',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2202,16796623585306,1701,44756,'defaultLanguageId',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2203,16796623585306,1702,44756,NULL,'en_US','<p><strong>Elevate your vision for the future!</strong> Clarity, a world-renowned manufacturer of innovative eyewear, seeks a passionate Associate Optical Engineer (Level 2) to join our growing team. In this progressive role, you''ll leverage your developing expertise to contribute significantly to the design, analysis, and optimization of advanced optical components for our next-generation eyewear solutions. You''ll collaborate with industry experts, tackle challenging projects, and gain valuable experience that will propel your career forward.</p>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2204,16796623585306,1703,44756,NULL,'en_US','<ul data-sourcepos="11:1-18:0">\u000a\u0009<li data-sourcepos="11:1-11:152">Collaborate with senior engineers on the design and analysis of optical components and systems using industry-standard software (e.g., Zemax, Code V).</li>\u000a\u0009<li data-sourcepos="12:1-12:146">Independently conduct optical simulations and analyses to evaluate performance metrics (e.g., image quality, light transmission, field of view).</li>\u000a\u0009<li data-sourcepos="13:1-13:207">Lead problem-solving efforts for assigned optical design challenges, proposing innovative solutions and collaborating with cross-functional teams (e.g., manufacturing, research) to achieve optimal results.</li>\u000a\u0009<li data-sourcepos="14:1-14:159">Actively participate in the development and testing of optical prototypes, ensuring functionality, manufacturability, and adherence to design specifications.</li>\u000a\u0009<li data-sourcepos="15:1-15:149">Create and maintain clear and comprehensive technical documentation for assigned projects, including optical designs, test procedures, and results.</li>\u000a\u0009<li data-sourcepos="16:1-16:148">Stay abreast of advancements in optical technology and materials, actively seeking opportunities to integrate new knowledge into ongoing projects.</li>\u000a\u0009<li data-sourcepos="17:1-18:0">Contribute to the continuous improvement of optical design processes and methodologies.</li>\u000a</ul>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2205,16796623585306,1704,44756,NULL,'en_US','<ul data-sourcepos="21:1-28:0">\u000a\u0009<li data-sourcepos="21:1-21:83">Bachelor''s degree in Optical Engineering, Physics, or a related field (required).</li>\u000a\u0009<li data-sourcepos="22:1-22:145">2-4 years of experience in applied optics or a related field, with demonstrable experience using optical design software (e.g., Zemax, Code V).</li>\u000a\u0009<li data-sourcepos="23:1-23:154">Strong understanding of optical design principles and theories (e.g., geometrical optics, physical optics) and their application to real-world problems.</li>\u000a\u0009<li data-sourcepos="24:1-24:99">Proven ability to analyze data, identify trends, and translate findings into actionable insights.</li>\u000a\u0009<li data-sourcepos="25:1-25:169">Excellent communication, collaboration, and interpersonal skills, with the ability to work effectively in a team environment and present technical information clearly.</li>\u000a\u0009<li data-sourcepos="26:1-26:79">A meticulous eye for detail and a commitment to delivering high-quality work.</li>\u000a\u0009<li data-sourcepos="27:1-28:0">A passion for learning and a desire to continuously develop your skills within the field of optical engineering.</li>\u000a</ul>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2206,16796623585306,1705,45056,'availableLanguageIds',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2207,16796623585306,1705,45056,'defaultLanguageId',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2208,16796623585306,1706,45056,NULL,'en_US','<p><strong>Elevate your vision for the future!</strong> Clarity, a world-renowned manufacturer of innovative eyewear, seeks a passionate Associate Optical Engineer (Level 2) to join our growing team. In this progressive role, you''ll leverage your developing expertise to contribute significantly to the design, analysis, and optimization of advanced optical components for our next-generation eyewear solutions. You''ll collaborate with industry experts, tackle challenging projects, and gain valuable experience that will propel your career forward.</p>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2209,16796623585306,1707,45056,NULL,'en_US','<ul data-sourcepos="11:1-18:0">\u000a\u0009<li data-sourcepos="11:1-11:152">Collaborate with senior engineers on the design and analysis of optical components and systems using industry-standard software (e.g., Zemax, Code V).</li>\u000a\u0009<li data-sourcepos="12:1-12:146">Independently conduct optical simulations and analyses to evaluate performance metrics (e.g., image quality, light transmission, field of view).</li>\u000a\u0009<li data-sourcepos="13:1-13:207">Lead problem-solving efforts for assigned optical design challenges, proposing innovative solutions and collaborating with cross-functional teams (e.g., manufacturing, research) to achieve optimal results.</li>\u000a\u0009<li data-sourcepos="14:1-14:159">Actively participate in the development and testing of optical prototypes, ensuring functionality, manufacturability, and adherence to design specifications.</li>\u000a\u0009<li data-sourcepos="15:1-15:149">Create and maintain clear and comprehensive technical documentation for assigned projects, including optical designs, test procedures, and results.</li>\u000a\u0009<li data-sourcepos="16:1-16:148">Stay abreast of advancements in optical technology and materials, actively seeking opportunities to integrate new knowledge into ongoing projects.</li>\u000a\u0009<li data-sourcepos="17:1-18:0">Contribute to the continuous improvement of optical design processes and methodologies.</li>\u000a</ul>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2210,16796623585306,1708,45056,NULL,'en_US','<ul data-sourcepos="21:1-28:0">\u000a\u0009<li data-sourcepos="21:1-21:83">Bachelor''s degree in Optical Engineering, Physics, or a related field (required).</li>\u000a\u0009<li data-sourcepos="22:1-22:145">2-4 years of experience in applied optics or a related field, with demonstrable experience using optical design software (e.g., Zemax, Code V).</li>\u000a\u0009<li data-sourcepos="23:1-23:154">Strong understanding of optical design principles and theories (e.g., geometrical optics, physical optics) and their application to real-world problems.</li>\u000a\u0009<li data-sourcepos="24:1-24:99">Proven ability to analyze data, identify trends, and translate findings into actionable insights.</li>\u000a\u0009<li data-sourcepos="25:1-25:169">Excellent communication, collaboration, and interpersonal skills, with the ability to work effectively in a team environment and present technical information clearly.</li>\u000a\u0009<li data-sourcepos="26:1-26:79">A meticulous eye for detail and a commitment to delivering high-quality work.</li>\u000a\u0009<li data-sourcepos="27:1-28:0">A passion for learning and a desire to continuously develop your skills within the field of optical engineering.</li>\u000a</ul>',NULL)
