INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2045,16796623585306,1616,44195,'name','en_US','','"leader-brandon-oquinn.png"')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2046,16796623585306,1616,44195,'width','en_US','','"290"')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2047,16796623585306,1616,44195,'description','en_US','','"leader-brandon-o''quinn-headshot"')
