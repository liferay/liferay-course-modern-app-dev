INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2037,16796623585306,1611,44185,'height','en_US','','"306"')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2038,16796623585306,1612,44185,NULL,'en_US','','Allison Fox')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2039,16796623585306,1613,44185,NULL,'en_US','','VP Creative Design')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2040,16796623585306,1614,44185,NULL,'en_US','<p>Allison Fox is the Vice President of Creative Design at Clarity Vision Solutions, a premier eyewear manufacturer known for its cutting-edge and stylish products. With over 15 years of experience in the design industry, Allison is a creative powerhouse whose visionary approach has significantly shaped the company\u2019s product offerings.<br>\u000aAllison joined Clarity Vision Solutions in 2017 and has been instrumental in driving the creative direction and innovation of the company\u2019s eyewear collections. Her keen sense of style, combined with a deep understanding of market trends, has helped the company develop products that resonate with a diverse customer base. Under her leadership, the design team has introduced several iconic and award-winning collections, establishing Clarity Vision Solutions as a trendsetter in the eyewear industry.<br>\u000aBefore her role at Clarity Vision Solutions, Allison held senior design positions at several leading fashion and accessory brands. She holds a Bachelor\u2019s degree in Fashion Design from the Parsons School of Design and a Master\u2019s degree in Product Design from the Royal College of Art.<br>\u000aAllison is known for her innovative design concepts, attention to detail, and ability to inspire and lead creative teams. She is passionate about exploring new materials and technologies to push the boundaries of traditional eyewear design, ensuring that Clarity Vision Solutions remains at the forefront of the industry.<br>\u000aIn her free time, Allison enjoys sketching, traveling, and discovering new art forms. She is also actively involved in design communities and enjoys mentoring young designers, sharing her knowledge and experience to foster the next generation of creative talent.</p>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,2041,16796623585306,1615,44195,'availableLanguageIds',NULL,'','en_US')
