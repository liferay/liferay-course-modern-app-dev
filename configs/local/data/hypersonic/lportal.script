INSERT INTO FRAGMENTENTRYLINK VALUES(119,0,'d2688005-34bd-e0bb-93d5-318c81dcd704',34188,32106,16796623585306,20122,'Clarity Admin','2024-05-20 20:34:23.505000','2025-11-06 19:44:24.130000',0,0,32391,20031,26,26,'.component-paragraph img {\u000a\u0009max-width: 100%;\u000a}','<div class="clearfix component-paragraph text-break" data-lfr-editable-id="element-text" data-lfr-editable-type="rich-text">\u000a\u0009A paragraph is a self-contained unit of a discourse in writing dealing with\u000a\u0009a particular point or idea. Paragraphs are usually an expected part of\u000a\u0009formal writing, used to organize longer prose.\u000a</div>','','','0','{"com.liferay.fragment.entry.processor.editable.EditableFragmentEntryProcessor":{"element-text":{"config":{"mapperType":"link"},"defaultValue":"\n\tA paragraph is a self-contained unit of a discourse in writing dealing with\n\ta particular point or idea. Paragraphs are usually an expected part of\n\tformal writing, used to organize longer prose.\n","collectionFieldId":"DDMStructure_RichText79978771"}}}','euzo',2,'BASIC_COMPONENT-paragraph',1,'2025-11-06 19:44:24.130000',NULL,'d2688005-34bd-e0bb-93d5-318c81dcd704')
INSERT INTO FRAGMENTENTRYLINK VALUES(0,0,'f20f513c-efce-b13b-06b0-e4c6888affee',34189,32106,16796623585306,20122,'Clarity Admin','2024-05-20 20:34:23.509000','2024-05-20 20:34:23.509000',0,22,32391,20031,26,26,'.clarity-gradient-container {\u000a\u0009background: linear-gradient(180deg, #22c1c3 0.88%, #187474 40%);\u000a  background-blend-mode: soft-light, normal;\u000a/*\u0009max-height: 452px;*/\u000a/*\u0009border-radius: 24px;*/\u000a}','<div class="clarity-gradient-container">\u000a\u0009\u0009<lfr-drop-zone></lfr-drop-zone>\u000a</div>','','{\u000a\u0009"fieldSets": [\u000a\u0009]\u000a}','0','{}','meui',0,'banner-(copy)',1,'2024-05-20 20:34:23.509000',NULL,'f20f513c-efce-b13b-06b0-e4c6888affee')
INSERT INTO FRAGMENTENTRYLINK VALUES(118,0,'2839610f-de48-5894-9b73-9d946897b049',34190,32106,16796623585306,20122,'Clarity Admin','2024-05-20 20:34:23.512000','2025-11-06 19:44:23.931000',0,0,32391,20031,26,26,'.component-html img {\u000a\u0009max-width: 100%;\u000a}','<div class="component-html" data-lfr-editable-id="element-html" data-lfr-editable-type="html">\u000a\u0009<h1>HTML Example</h1>\u000a\u000a\u0009<p class="mb-0">\u000a\u0009\u0009A paragraph is a <strong>self-contained</strong> unit of a discourse in\u000a\u0009\u0009writing dealing with a particular point or <em>idea</em>. Paragraphs are\u000a\u0009\u0009usually an expected part of formal writing, used to organize longer\u000a\u0009\u0009prose.\u000a\u0009</p>\u000a</div>','','','0','{"com.liferay.fragment.entry.processor.editable.EditableFragmentEntryProcessor":{"element-html":{"defaultValue":"\n\t<h1>HTML Example<\/h1>\n\n\t<p class=\"mb-0\">\n\t\tA paragraph is a <strong>self-contained<\/strong> unit of a discourse in\n\t\twriting dealing with a particular point or <em>idea<\/em>. Paragraphs are\n\t\tusually an expected part of formal writing, used to organize longer\n\t\tprose.\n\t<\/p>\n","en_US":"\n\t<h1>Making a Positive<br>Impact, Sustainably<\/h1>\n\n\t<p class=\"mb-2 mt-3 text-small\">\n    At Clarity, our commitment to making a difference goes beyond stylish eyewear. \n    Through initiatives like empowering underserved communities with access to quality \n    eyewear, we bridge vision gaps and contribute to socail well-being. \n    Simultaneously, our dedication to sustainability is reflected in our eco-friendly\t\n    practices, from responsible material sourcing to the use of recyclable packaging.\n    Every purchase you make with us not only enhances your style but also supports our\n    collective journey toward a brighter, more includsive, and susainable future. \n<\/p>\n","config":{}}}}','hmyb',0,'BASIC_COMPONENT-html',1,'2025-11-06 19:44:23.931000',NULL,'2839610f-de48-5894-9b73-9d946897b049')
INSERT INTO FRAGMENTENTRYLINK VALUES(122,0,'ffcd1313-b887-b6e6-b584-896a416c4d74',34191,32106,16796623585306,20122,'Clarity Admin','2024-05-20 20:34:23.520000','2025-11-06 19:44:24.053000',0,0,32391,20031,26,26,'','[#if configuration.type == "action"]\u000a\u0009<button class="btn btn-${configuration.buttonSize} btn-${configuration.buttonType}" data-lfr-editable-id="action" data-lfr-editable-type="action">\u000a\u0009\u0009Go Somewhere\u000a\u0009</button>\u000a\u000a\u0009[#else]\u000a\u0009\u0009<div class="component-button text-break">\u000a\u0009\u0009\u0009<a class="btn btn-${configuration.buttonSize} btn-${configuration.buttonType}" data-lfr-editable-id="link" data-lfr-editable-type="link" href="" id="fragment-${fragmentEntryLinkNamespace}-link">\u000a\u0009\u0009\u0009\u0009Go Somewhere\u000a\u0009\u0009\u0009</a>\u000a\u0009\u0009</div>\u000a[/#if]','','{\u000a\u0009"fieldSets": [\u000a\u0009\u0009{\u000a\u0009\u0009\u0009"fields": [\u000a\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009"dataType": "string",\u000a\u0009\u0009\u0009\u0009\u0009"defaultValue": "link",\u000a\u0009\u0009\u0009\u0009\u0009"label": "type",\u000a\u0009\u0009\u0009\u0009\u0009"name": "type",\u000a\u0009\u0009\u0009\u0009\u0009"type": "select",\u000a\u0009\u0009\u0009\u0009\u0009"typeOptions": {\u000a\u0009\u0009\u0009\u0009\u0009\u0009"validValues": [\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "link"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009"value": "action"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009\u0009\u0009]\u000a\u0009\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009},\u000a\u0009\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009\u0009"dataType": "string",\u000a\u0009\u0009\u0009\u0009\u0009"defaultValue": "primary",\u000a\u0009\u0009\u0009\u0009\u0