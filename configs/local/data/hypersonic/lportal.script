INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,3233,16796623585306,2616,51851,'name','en_US','','"sunglasses-on-shelves.png"')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,3234,16796623585306,2616,51851,'width','en_US','','""')
