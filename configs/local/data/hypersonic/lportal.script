INSERT INTO FRAGMENTENTRYLINK VALUES(2,0,'a5ebc884-7675-2e64-a7cc-6b5d4ee2a5c9',73437,32106,16796623585306,20122,'Clarity Admin','2025-08-14 12:22:05.329000','2025-08-14 12:22:11.757000',0,802,52937,20031,109,109,'','[#assign\u000a\u0009readOnly = input.attributes.readOnly?? && input.attributes.readOnly\u000a]\u000a[#attempt]\u000a\u0009[#assign countries = restClient.get("/headless-admin-address/v1.0/countries?fields=a3,title_i18n&sort=name&pageSize=300").items![] /]\u000a[#recover]\u000a\u0009[#assign countries = [] /]\u000a[/#attempt]\u000a<div class="select-input">\u000a\u0009<div class="form-group [#if input.errorMessage?has_content]has-error[/#if] mb-0" id="${fragmentEntryLinkNamespace}-form-group">\u000a\u0009\u0009<label class="[#if !input.showLabel || !input.label?has_content]sr-only[/#if]" for="${fragmentEntryLinkNamespace}-select-input" id="${fragmentEntryLinkNamespace}-select-input-label">${htmlUtil.escape(input.label)} [#if readOnly](${languageUtil.get(locale, "read-only")})[#elseif input.required][@clay["icon"] className="reference-mark" symbol="asterisk" /][/#if]</label>\u000a\u0009\u0009<select\u000a\u0009\u0009\u0009aria-describedby="${fragmentEntryLinkNamespace}-select-input-help-text"\u000a\u0009\u0009\u0009aria-labelledby="${fragmentEntryLinkNamespace}-select-input-label [#if  input.errorMessage?has_content]${fragmentEntryLinkNamespace}-select-input-error-message[/#if]"\u000a\u0009\u0009\u0009class="form-control"\u000a\u0009\u0009\u0009id="${fragmentEntryLinkNamespace}-select-input"\u000a\u0009\u0009\u0009name="${input.name}"\u000a\u0009\u0009\u0009[#if readOnly]readonly[/#if]\u000a\u0009\u0009\u0009${input.required?then(''required'', '''')}\u000a\u0009\u0009>\u000a\u0009\u0009\u0009<option value="">${languageUtil.get(locale, "choose-an-option")}</option>\u000a\u0009\u0009\u0009[#list countries as country]\u000a\u0009\u0009\u0009\u0009<option value="${country.a3}">${country.title_i18n[locale]}</option>\u000a\u0009\u0009\u0009[/#list]\u000a\u0009\