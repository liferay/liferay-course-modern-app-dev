INSERT INTO ASSETENTRY VALUES(1,0,37841,32106,16796623585306,20122,'Clarity Admin','2024-05-01 02:19:12.570000','2024-05-04 22:20:18.852000',29437,37839,'b19f841f-92f6-4f93-771a-cb646b7f2c74',0,'1','1',NULL,NULL,'2024-05-01 02:18:00.000000',NULL,'text/html','Innovations in Eyewear Technology: Beyond Clear Vision','','Take advantage of exclusive offers on latest products to deliver exceptional value for your business and your customers.\u00a0Take advantage of exclusive offers on latest products to deliver exceptional value for your business and your customers.\u00a0Take advantage of exclusive offers on latest products to deliver exceptional value for your business and your customers.\u00a0Take advantage of exclusive offers on latest products to deliver exceptional value for your business and your customers.\u00a0Take...',NULL,NULL,0,0,0.0E0)
