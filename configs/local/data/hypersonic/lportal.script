INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,1910,16796623585306,1507,43702,'availableLanguageIds',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,1911,16796623585306,1507,43702,'defaultLanguageId',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,1912,16796623585306,1508,43702,NULL,'en_US','','<p>You can place an order through our website. Simply choose the glasses you like, select your prescription and lens type, add the item to your cart, and proceed to checkout.</p>')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,1913,16796623585306,1509,43712,'availableLanguageIds',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,1914,16796623585306,1509,43712,'defaultLanguageId',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,1915,16796623585306,1510,43712,NULL,'en_US','','<p>We accept various payment methods including credit cards (Visa, Mastercard, American Express), PayPal, and bank transfers.</p>')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,1916,16796623585306,1511,43722,'availableLanguageIds',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,1917,16796623585306,1511,43722,'defaultLanguageId',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,1918,16796623585306,1512,43722,NULL,'en_US','','<p>Yes, we do. We have qualified optometrists who can conduct comprehensive eye exams to determine your prescription and check for any eye health issues.</p>')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,1919,16796623585306,1513,43732,'availableLanguageIds',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,1920,16796623585306,1513,43732,'defaultLanguageId',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,1921,16796623585306,1514,43732,NULL,'en_US','','<p>We offer a wide range of eyewear including prescription glasses, sunglasses, and contact lenses. We also have a collection of designer frames to suit different styles and preferences.</p>')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,1922,16796623585306,1515,43742,'availableLanguageIds',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,1923,16796623585306,1515,43742,'defaultLanguageId',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,1924,16796623585306,1516,43742,NULL,'en_US','','<p>Return shipping costs are the responsibility of the customer unless the item is defective or an error was made on our end</p>')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,1925,16796623585306,1517,43752,'availableLanguageIds',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,1926,16796623585306,1517,43752,'defaultLanguageId',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,1927,16796623585306,1518,43752,NULL,'en_US','','<p>We offer a 30-day return policy from the date of delivery. Items must be unused and in the same condition that you received them, including all original packaging.</p>')
