INSERT INTO ASSETENTRY VALUES(3,0,54641,20119,16796623585306,20122,'Clarity Admin','2024-12-02 22:55:10.132000','2025-03-09 01:58:08.252000',29027,54639,NULL,0,'1','1',NULL,NULL,NULL,NULL,NULL,'Iris Optical','A luxury boutique dedicated to offering an exclusive selection of premium eyewear brands from around the world. They pride themselves on curating unique collections that combine cutting-edge design, unparalleled craftsmanship, and the highest quality materials.','',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(3,0,54647,20119,16796623585306,20122,'Clarity Admin','2024-12-02 22:57:49.221000','2025-03-09 01:57:56.457000',29027,54645,NULL,0,'1','1',NULL,NULL,NULL,NULL,NULL,'Retro Eyewear','Company that celebrates timeless style by bringing the charm of vintage and retro eyewear to modern fashion enthusiasts. They specialize in curating and crafting classic frames inspired by iconic designs from decades past, blending nostalgic aesthetics with modern craftsmanship.','',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(2,0,54653,20119,16796623585306,20122,'Clarity Admin','2024-12-02 22:59:45.102000','2025-03-09 01:58:26.992000',29027,54651,NULL,0,'1','1',NULL,NULL,NULL,NULL,NULL,'True Focus Optical','Company dedicated to enhancing vision and productivity through innovative optical solutions. We design and craft high-quality glasses that cater to modern lifestyles, offering advanced lens technologies for seamless transitions between work, leisure, and life.','',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(8,0,55244,20119,16796623585306,20122,'Clarity Admin','2024-12-10 23:45:54.331000','2025-03-09 01:59:56.336000',20070,55239,'c2bc1da1-1a8d-87a7-869d-13136361b052',0,'1','0',NULL,NULL,NULL,NULL,NULL,'Renee Salinger','','',NULL,NULL,0,0,0.0E0)
