INSERT INTO ASSETENTRY VALUES(2,0,37606,32106,16796623585306,20122,'Clarity Admin','2024-05-31 17:25:07.630000','2024-05-31 17:25:34.197000',29437,37602,'a6157a0a-e78b-7942-6f00-89884368d9e2',0,'1','1',NULL,NULL,'2024-05-31 17:24:00.000000',NULL,'text/html','Blue Light Glasses: Protecting Your Eyes from Digital Strain','','Save your eyes with Blue Ligh protection In the era of digitalization, where screens have become an integral part of our lives, the rise in digital eye strain is a concern. Enter blue light glasses, designed to block the blue light emitted by screens, reducing eye discomfort and promoting better sleep. These glasses are becoming a staple for those spending long hours in front of computers or other digital devices. While not a replacement for good screen habits, they provide an extra layer of...',NULL,NULL,0,0,0.0E0)
