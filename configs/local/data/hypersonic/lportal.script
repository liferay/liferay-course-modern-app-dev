INSERT INTO ASSETENTRY VALUES(1,0,37859,32106,16796623585306,20122,'Clarity Admin','2024-05-01 12:24:23.874000','2024-05-04 22:22:51.720000',29437,37857,'a0df10cb-3675-c029-d4c7-ae47d9976d66',0,'1','1',NULL,NULL,'2024-05-01 12:24:00.000000',NULL,'text/html','Revolutionizing Eyewear with Smart Glasses','','The world of eyewear is witnessing a paradigm shift with the advent of smart glasses. These advanced tech gadgets are doing much more than just improving vision; they are redefining how we interact with technology. From displaying texts and emails directly in your field of vision to real-time navigation, the applications of smart glasses are vast. Some models even allow you to take pictures or record videos, offering a first-person point of view. This technology is also paving the way for...',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,37867,32106,16796623585306,20122,'Clarity Admin','2024-05-01 12:24:36.457000','2024-05-01 12:24:36.465000',20009,37865,'f257f6b8-7d4f-2495-47d7-8574168e00a0',0,'1','1',NULL,NULL,'2024-05-01 12:24:36.457000',NULL,'image/png','img1714566274516-1.jpg','','',NULL,NULL,0,0,0.0E0)
INSERT INTO ASSETENTRY VALUES(1,0,37873,32106,16796623585306,20122,'Clarity Admin','2024-05-01 12:24:36.435000','2024-05-04 22:29:39.624000',29437,37871,'ec37d022-4782-3c72-30db-6958fe259a75',0,'1','1',NULL,NULL,'2024-05-01 12:24:00.000000',NULL,'text/html','The Rise of Customized 3D-Printed Glasses','','The eyewear industry is embracing the power of 3D printing, bringing unparalleled customization to glasses. With 3D printing, glasses can be tailored to fit an individual''s unique facial features perfectly. Moreover, this technology allows for a more sustainable production process, as it reduces waste by using only the necessary amount of material. It also serves as a platform for creativity, enabling designers to experiment with various shapes and styles that would otherwise be impossible to...',NULL,NULL,0,0,0.0E0)
