INSERT INTO FRAGMENTENTRYLINK VALUES(6,0,'4b94ddce-6b23-af45-5993-5eaa9c7afbe2',50776,32106,16796623585306,32252,'Walter Douglas','2024-08-28 23:33:15.474000','2024-12-13 21:30:16.950000',50105,20,49955,20031,97,97,'.values{\u000a  display: flex;  \u000a}\u000a\u000a.value-card{\u000a  display: flex;\u000a  flex-direction: column;\u000a  justify-content: center;\u000a  align-items: center;\u000a\u0009padding: 32px;\u000a  width: 100%;\u000a  height: 148px;\u000a\u0009gap: 16px;\u000a  background: #F7EBD9;\u000a  border-radius: 12px;\u000a\u0009isolation: isolate;\u000a  overflow: hidden;\u000a  position: relative;\u000a}\u000a\u000a.value-card-circle{\u000a  position: absolute;\u000a\u0009background: linear-gradient(227.52deg, #F7EBD9 12.01%, #FBE0B9 85.9%);\u000a  box-shadow: 0px -2px 12px rgba(193, 137, 51, 0.2);\u000a  border-radius: 999px;\u000a\u0009opacity: 50%;\u000a}\u000a\u000a/* large watermark positions */\u000a\u000a.value-card-circle-lg{\u000a  width: 142px;\u000a  height: 142px;\u000a\u000a}\u000a\u000a.value-card-circle-lg-br{\u000a  bottom: -80px;\u000a  right: -85px;\u000a}\u000a\u000a.value-card-circle-lg-bl{\u000a  bottom: -80px;\u000a  left: -85px;\u000a}\u000a\u000a.value-card-circle-lg-tr{\u000a  top: -80px;\u000a  right: -60px;\u000a}\u000a\u000a.value-card-circle-lg-tl{\u000a  top: -80px;\u000a  left: -100px;\u000a}\u000a\u000a/* small watermark positions */\u000a\u000a.value-card-circle-sm{\u000a  width: 95px;\u000a  height: 95px;\u000a}\u000a\u000a.value-card-circle-sm-br{\u000a  bottom: -20px;\u000a  right: -60px;\u000a}\u000a\u000a.value-card-circle-sm-bl{\u000a  bottom: -20px;\u000a  left: -60px;\u000a}\u000a\u000a.value-card-circle-sm-tr{\u000a  bottom: -20px;\u000a  right: -60px;\u000a}\u000a\u000a.value-card-circle-sm-tl{\u000a  bottom: -20px;\u000a  left: -60px;\u000a}','<div class="values text-center">\u000a  <div class="value-card value-card-color">\u000a\u0009\u0009   <lfr-drop-zone></lfr-drop-zone>\u000a \u0009</div>\u000a\u0009\