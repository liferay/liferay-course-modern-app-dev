INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,3227,16796623585306,2613,51841,NULL,'en_US','','<p>The Latest Eyewear Trends: Fashionable Frames and Stylish Shades</p>')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,3228,16796623585306,2614,51841,NULL,'en_US','<p>Eyewear trends are constantly evolving, and this season is all about embracing bold, stylish frames and statement-making shades. From oversized retro-inspired glasses to sleek and modern aviators, there''s a wide range of eyewear styles to choose from. Whether you''re looking for a fashion-forward statement piece or a classic frame with a modern twist, the latest trends have something for everyone. With new color palettes and innovative designs, eyewear is becoming a key accessory in defining personal style.</p>',NULL)
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,3229,16796623585306,2615,51851,'availableLanguageIds',NULL,'','en_US')
INSERT INTO DDMFIELDATTRIBUTE VALUES(0,0,3230,16796623585306,2615,51851,'defaultLanguageId',NULL,'','en_US')
