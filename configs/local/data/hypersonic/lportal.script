INSERT INTO FRAGMENTENTRYVERSION VALUES(0,0,7,1,'4ac67958-3ada-3c21-5f4b-a31d7cd5b4d3',14,32106,16796623585306,20122,'Clarity Admin','2024-05-20 18:52:13.741000','2024-05-20 18:52:13.741000',32638,'login','Login','.fragment_312 {\u000a}','[#assign\u000a\u0009theme_display = themeDisplay\u000a\u0009is_signed_in = theme_display.isSignedIn()\u000a/]\u000a\u000a[#if !is_signed_in] \u000a<div class="login-container">\u000a\u0009<form action="?p_p_id=com_liferay_login_web_portlet_LoginPortlet&p_p_lifecycle=1&p_p_state=exclusive&p_p_mode=view&_com_liferay_login_web_portlet_LoginPortlet_javax.portlet.action=%2Flogin%2Flogin&_com_liferay_login_web_portlet_LoginPortlet_mvcRenderCommandName=%2Flogin%2Flogin" class="form sign-in-form " data-fm-namespace="_com_liferay_login_web_portlet_LoginPortlet_" id="_com_liferay_login_web_portlet_LoginPortlet_loginForm" method="post" name="_com_liferay_login_web_portlet_LoginPortlet_loginForm" autocomplete="on">\u000a\u0009\u0009<div aria-label="Sign In" class="input-container" role="group"><input class="field form-control" id="_com_liferay_login_web_portlet_LoginPortlet_formDate" name="_com_liferay_login_web_portlet_LoginPortlet_formDate" type="hidden" value="1714917724004"> <input class="field form-control" id="_com_liferay_login_web_portlet_LoginPortlet_saveLastPath" name="_com_liferay_login_web_portlet_LoginPortlet_saveLastPath" type="hidden" value="false"> <input class="field form-control" id="_com_liferay_login_web_portlet_LoginPortlet_redirect" name="_com_liferay_login_web_portlet_LoginPortlet_redirect" type="hidden" value=""> <input class="field form-control" id="_com_liferay_login_web_portlet_LoginPortlet_doActionAfterLogin" name="_com_liferay_login_web_portlet_LoginPortlet_doActionAfterLogin" type="hidden" value="false">\u000a\u0009\u0009\u0009<div class="inline-alert-container lfr-alert-container"></div>\u000a\u0009\u0009\u0009<div class="alert alert-danger" id="_com_liferay_login_web_portlet_LoginPortlet_cookieDisabled" style="display: none;">\u000a\u0009\u0009\u0009\u0009Authentication failed. Please enable browser cookies and try again.\u000a\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009<fieldset class=""><legend class="sr-only"> Sign In </legend>\u000a\u0009\u0009\u0009\u0009<div class="show  " id="Content" role="presentation">\u000a\u0009\u0009\u0009\u0009\u0009<div>\u000a\u0009\u0009\u0009\u0009\u0009\u0009<div class="form-group input-text-wrapper">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<label class=" control-label" for="_com_liferay_login_web_portlet_LoginPortlet_login"> Email Address </label> \u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<input class="field clearable form-control" id="_com_liferay_login_web_portlet_LoginPortlet_login" name="_com_liferay_login_web_portlet_LoginPortlet_login" type="text" value="" placeholder="email">\u000a\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009\u0009\u0009\u0009<div class="form-group input-text-wrapper"><label class=" control-label" for="_com_liferay_login_web_portlet_LoginPortlet_password"> Password </label> <input class="field form-control" id="_com_liferay_login_web_portlet_LoginPortlet_password" name="_com_liferay_login_web_portlet_LoginPortlet_password" type="password" value="">\u000a\u0009\u0009\u0009\u0009\u0009\u0009</div> <span id="_com_liferay_login_web_portlet_LoginPortlet_passwordCapsLockSpan" style="display: none;">Caps Lock is on.</span>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009</fieldset>\u000a\u0009\u0009\u0009<div class="button-holder ">\u000a\u0009\u0009\u0009\u0009<button class="btn  btn-primary btn-block" id="_com_liferay_login_web_portlet_LoginPortlet_kbbc" type="submit"> \u000a\u0009\u0009\u0009\u0009\u0009<span class="lfr-btn-label">Login</span> \u000a\u0009\u0009\u0009\u0009</button>\u000a\u0009\u0009\u0009</div> \u000a\u0009\u0009</div>\u000a\u0009</form>\u000a</div>\u000a[#else]\u000a<div>\u000a\u0009<div class="pb-5">\u000a\u0009\u0009Looks like you''re already signed in! \u0009\u000a\u0009</div>\u000a\u0009<div class="button-holder ">\u000a\u0009\u0009<a href="/web/clarity/home" class="btn btn-primary">Back to Home</a>\u000a\u0009</div>\u000a</div>\u000a[/#if]','','0','{\u000a\u0009"fieldSets": [\u000a\u0009]\u000a}','code',0,'0',1,'',NULL,0,20122,'Clarity Admin','2024-05-20 18:52:13.741000','4ac67958-3ada-3c21-5f4b-a31d7cd5b4d3')
INSERT INTO FRAGMENTENTRYVERSION VALUES(0,0,8,1,'1adb5191-ea83-06ee-e7db-21998279f21f',16,32106,16796623585306,20122,'Clarity Admin','2024-05-20 18:52:13.745000','2024-05-20 18:52:13.745000',32638,'card','Clarity Card','.card {\u000a\u0009background-color: #f8f8f8;\u000a}\u000a\u000a.action-link {\u000a\u0009font-weight: 600;\u000a}\u000a\u000a.action-link:after {\u000a\u0009padding-left: 5px;\u000a\u0009content: ''\2192'';\u000a}\u000a\u000a.card-image {\u000a\u0009height: 200px;\u000a\u0009object-fit: cover;\u0009\u000a}\u000a\u000a.rounded-corners {\u000a\u0009border-radius: 10px;\u000a}','<div class="card card-container p-3 rounded-corners">\u000a\u0009<img src="..." class="card-image card-img-top rounded-corners" data-lfr-editable-id="card-image" data-lfr-editable-type="image">\u000a\u0009<div class="card-body">\u000a\u0009\u0009<div data-lfr-editable-id="category" data-lfr-editable-type="text" class="text-primary mb-3 text-uppercase text-link-sm">\u000a\u0009\u0009\u0009category\u000a\u0009\u0009</div>\u000a\u0009\u0009<h3 class="card-title pb-4 font-weight-bold text-truncate" data-lfr-editable-id="card-title" data-lfr-editable-type="text" class="font-weight-bold">Card title</h3>\u000a\u0009\u0009<p class="text-truncate" data-lfr-editable-id="summary" data-lfr-editable-type="text">\u000a\u0009\u0009\u0009Lorem ipsum dolor sit amet, consectetur adipiscing elit.\u000a\u0009\u0009</p>\u000a\u0009\u0009<a href="#" class="action-link" data-lfr-editable-id="card-link" data-lfr-editable-type="link">Read more</a>\u000a\u0009</div>\u000a</div>','','0','{\u000a\u0009"fieldSets": [\u000a\u0009]\u000a}','code',0,'0',1,'',NULL,0,20122,'Clarity Admin','2024-05-20 18:52:13.745000','1adb5191-ea83-06ee-e7db-21998279f21f')
INSERT INTO FRAGMENTENTRYVERSION VALUES(0,0,10,1,'e259ab6a-97dd-2d64-1cb1-e6e89aabec24',20,32106,16796623585306,20122,'Clarity Admin','2024-05-20 18:52:13.780000','2024-05-20 18:52:13.780000',32638,'values-(copy)','Values Card','.values{\u000a  display: flex;  \u000a}\u000a\u000a.value-card{\u000a  display: flex;\u000a  flex-direction: column;\u000a  justify-content: center;\u000a  align-items: center;\u000a\u0009padding: 32px;\u000a  width: 100%;\u000a  height: 148px;\u000a\u0009gap: 16px;\u000a  background: #F7EBD9;\u000a  border-radius: 12px;\u000a\u0009isolation: isolate;\u000a  overflow: hidden;\u000a  position: relative;\u000a}\u000a\u000a.value-card-circle{\u000a  position: absolute;\u000a\u0009background: linear-gradient(227.52deg, #F7EBD9 12.01%, #FBE0B9 85.9%);\u000a  box-shadow: 0px -2px 12px rgba(193, 137, 51, 0.2);\u000a  border-radius: 999px;\u000a\u0009opacity: 50%;\u000a}\u000a\u000a/* large watermark positions */\u000a\u000a.value-card-circle-lg{\u000a  width: 142px;\u000a  height: 142px;\u000a\u000a}\u000a\u000a.value-card-circle-lg-br{\u000a  bottom: -80px;\u000a  right: -85px;\u000a}\u000a\u000a.value-card-circle-lg-bl{\u000a  bottom: -80px;\u000a  left: -85px;\u000a}\u000a\u000a.value-card-circle-lg-tr{\u000a  top: -80px;\u000a  right: -60px;\u000a}\u000a\u000a.value-card-circle-lg-tl{\u000a  top: -80px;\u000a  left: -100px;\u000a}\u000a\u000a/* small watermark positions */\u000a\u000a.value-card-circle-sm{\u000a  width: 95px;\u000a  height: 95px;\u000a}\u000a\u000a.value-card-circle-sm-br{\u000a  bottom: -20px;\u000a  right: -60px;\u000a}\u000a\u000a.value-card-circle-sm-bl{\u000a  bottom: -20px;\u000a  left: -60px;\u000a}\u000a\u000a.value-card-circle-sm-tr{\u000a  bottom: -20px;\u000a  right: -60px;\u000a}\u000a\u000a.value-card-circle-sm-tl{\u000a  bottom: -20px;\u000a  left: -60px;\u000a}','<div class="values text-center">\u000a  <div class="value-card value-card-color">\u000a\u0009\u0009   <lfr-drop-zone></lfr-drop-zone>\u000a \u0009</div>\u000a\u0009\u0009[#if configuration.topRight]\u000a\u0009   <div \u000a\u0009\u0009\u0009\u0009\u0009class="value-card-circle \u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009 value-card-circle-${configuration.circleSize} \u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009 value-card-circle-lg-tr"\u000a\u0009\u0009\u0009>\u000a\u0009    </div> \u000a\u0009[/#if]\u000a\u0009\u000a\u0009[#if configuration.bottomRight]\u000a\u0009\u0009   <div \u000a\u0009\u0009\u0009\u0009\u0009class="value-card-circle \u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009 value-card-circle-${configuration.circleSize} \u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009 value-card-circle-lg-br"\u000a\u0009\u0009\u0009>\u000a\u0009\u0009  </div>\u000a\u0009[/#if]\u000a\u0009\u000a\u0009[#if configuration.bottomLeft]\u000a\u0009   <div \u000a\u0009\u0009\u0009\u0009\u0009class="value-card-circle \u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009 value-card-circle-${configuration.circleSize} \u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009 value-card-circle-lg-bl"\u000a\u0009\u0009\u0009>\u000a\u0009    </div>\u000a\u0009[/#if]\u000a\u0009\u000a\u0009[#if configuration.topLeft]\u000a\u0009   <div \u000a\u0009\u0009\u0009\u0009\u0009class="value-card-circle \u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009 value-card-circle-${configuration.circleSize} \u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009 value-card-circle-lg-tl"\u000a\u0009\u0009\u0009>\u000a\u0009    </div>\u0009\u0009\u0009 \u000a\u0009[/#if]\u0009\u000a</div>','','0','{\u000a    "fieldSets": [\u000a\u0009\u0009\u0009{\u000a\u0009\u0009\u0009\u0009 "fields": [\u000a                {\u000a                    "dataType": "string",\u000a                    "defaultValue": false,\u000a                    "description": "Size of watermark circle",\u000a                    "label": "Size",\u000a                    "typeOptions": {\u000a                        "validValues": [\u000a                            {\u000a                                "label": "Small",\u000a                                "value": "sm"\u000a                            },\u000a                            {\u000a                                "label": "Large",\u000a                                "value": "lg"\u000a                            }\u000a                        ]\u000a                    },\u000a                    "name": "circleSize",\u000a                    "type": "select"\u000a                },\u000a  {\u000a                    "dataType": "string",\u000a                    "defaultValue": true,\u000a                    "description": "Show circle watermark top right on card",\u000a                    "label": "Top Right",\u000a                    "name": "topRight",\u000a                    "type": "checkbox"\u000a                },\u000a                {\u000a                    "dataType": "string",\u000a                    "defaultValue": true,\u000a                    "description": "Show circle watermark bottom right on card",\u000a                    "label": "Bottom Right",\u000a                    "name": "bottomRight",\u000a                    "type": "checkbox"\u000a                },\u000a                {\u000a                    "dataType": "string",\u000a                    "defaultValue": true,\u000a                    "description": "Show circle watermark bottom left on card",\u000a                    "label": "Bottom Left",\u000a                    "name": "bottomLeft",\u000a                    "type": "checkbox"\u000a                },\u000a                {\u000a                    "dataType": "string",\u000a                    "defaultValue": true,\u000a                    "description": "Show circle watermark top left on card",\u000a                    "label": "Top Left",\u000a                    "name": "topLeft",\u000a                    "type": "checkbox"\u000a                }\u000a            ],\u000a            "label": "Watermark"\u000a\u0009\u0009\u0009}\u000a    ]\u000a}','code',0,'0',1,'',NULL,0,20122,'Clarity Admin','2024-05-20 18:52:13.780000','e259ab6a-97dd-2d64-1cb1-e6e89aabec24')
INSERT INTO FRAGMENTENTRYVERSION VALUES(0,0,11,1,'2834d5db-abb0-c067-989c-17c4edbbd485',22,32106,16796623585306,20122,'Clarity Admin','2024-05-20 18:52:13.787000','2024-05-20 18:52:13.787000',32638,'banner-(copy)','Clarity Gradient Container','.clarity-gradient-container {\u000a\u0009background: linear-gradient(180deg, #22c1c3 0.88%, #187474 40%);\u000a  background-blend-mode: soft-light, normal;\u000a/*\u0009max-height: 452px;*/\u000a/*\u0009border-radius: 24px;*/\u000a}','<div class="clarity-gradient-container">\u000a\u0009\u0009<lfr-drop-zone></lfr-drop-zone>\u000a</div>','','0','{\u000a\u0009"fieldSets": [\u000a\u0009]\u000a}','code',0,'0',1,'',NULL,0,20122,'Clarity Admin','2024-05-20 18:52:13.787000','2834d5db-abb0-c067-989c-17c4edbbd485')
