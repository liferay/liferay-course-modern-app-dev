                            "label": "Small",\u000a                                "value": "sm"\u000a                            },\u000a                            {\u000a                                "label": "Large",\u000a                                "value": "lg"\u000a                            }\u000a                        ]\u000a                    },\u000a                    "name": "circleSize",\u000a                    "type": "select"\u000a                },\u000a  {\u000a                    "dataType": "string",\u000a                    "defaultValue": true,\u000a                    "description": "Show circle watermark top right on card",\u000a                    "label": "Top Right",\u000a                    "name": "topRight",\u000a                    "type": "checkbox"\u000a                },\u000a                {\u000a                    "dataType": "string",\u000a                    "defaultValue": true,\u000a                    "description": "Show circle watermark bottom right on card",\u000a                    "label": "Bottom Right",\u000a                    "name": "bottomRight",\u000a                    "type": "checkbox"\u000a                },\u000a                {\u000a                    "dataType": "string",\u000a                    "defaultValue": true,\u000a                    "description": "Show circle watermark bottom left on card",\u000a                    "label": "Bottom Left",\u000a                    "name": "bottomLeft",\u000a                    "type": "checkbox"\u000a                },\u000a                {\u000a                    "dataType": "string",\u000a                    "defaultValue": true,\u000a                    "description": "Show circle watermark top left on card",\u000a                    "label": "Top Left",\u000a                    "name": "topLeft",\u000a                    "type": "checkbox"\u000a                }\u000a            ],\u000a            "label": "Watermark"\u000a\u0009\u0009\u0009}\u000a    ]\u000a}','0','{"com.liferay.fragment.entry.processor.editable.EditableFragmentEntryProcessor":{"valueCardTitle":{"config":{"mapperType":"link"}}},"com.liferay.fragment.entry.processor.freemarker.FreeMarkerFragmentEntryProcessor":{"bottomLeft":true,"bottomRight":true,"topLeft":true,"circleSize":"false","topRight":true}}','unyd',0,'values-(copy)',1,'2024-08-28 19:41:07.880000',NULL,'7bcb85b0-bd35-5ac9-ff19-d668b16f8bc9')
