INSERT INTO ACCOUNTENTRY VALUES(10,'22efefb0-96f4-1a7d-0bb9-ef603f1d93a5','ACCT_IRIS',54639,16796623585306,20122,'Clarity Admin','2024-12-02 22:55:10.132000','2025-03-09 01:58:08.256000',54642,NULL,54642,0,'A luxury boutique dedicated to offering an exclusive selection of premium eyewear brands from around the world. They pride themselves on curating unique collections that combine cutting-edge design, unparalleled craftsmanship, and the highest quality materials.',NULL,NULL,0,'Iris Optical','1',NULL,'ACCT_IRIS','business',0,20122,'Clarity Admin','2025-03-09 01:58:08.255000')
INSERT INTO ACCOUNTENTRY VALUES(12,'2555f503-73a3-9a64-894a-8fd0f69812b3','ACCT_RETRO',54645,16796623585306,20122,'Clarity Admin','2024-12-02 22:57:49.221000','2025-03-09 01:57:56.461000',54648,NULL,54648,0,'Company that celebrates timeless style by bringing the charm of vintage and retro eyewear to modern fashion enthusiasts. They specialize in curating and crafting classic frames inspired by iconic designs from decades past, blending nostalgic aesthetics with modern craftsmanship.',NULL,NULL,0,'Retro Eyewear','1',NULL,'75-4919320','business',0,20122,'Clarity Admin','2025-03-09 01:57:56.459000')
INSERT INTO ACCOUNTENTRY VALUES(9,'76e970b0-3447-7cdb-206e-ecefa919c9ce','ACCT_FOCUS',54651,16796623585306,20122,'Clarity Admin','2024-12-02 22:59:45.102000','2025-03-09 01:58:26.998000',54654,NULL,54654,0,'Company dedicated to enhancing vision and productivity through innovative optical solutions. We design and craft high-quality glasses that cater to modern lifestyles, offering advanced lens technologies for seamless transitions between work, leisure, and life.',NULL,NULL,0,'True Focus Optical','1',NULL,'75-8922398','business',0,20122,'Clarity Admin','2025-03-09 01:58:26.994000')
