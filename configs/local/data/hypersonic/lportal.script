INSERT INTO FRAGMENTENTRYLINK VALUES(61,0,'06792e2b-d0a3-8ebe-8445-9e330bec275c',51676,32106,16796623585306,32252,'Walter Douglas','2024-08-29 16:36:59.616000','2025-11-06 19:44:25.652000',0,0,51653,20031,101,101,'.component-html img {\u000a\u0009max-width: 100%;\u000a}','<div class="component-html" data-lfr-editable-id="element-html" data-lfr-editable-type="html">\u000a\u0009<h1>HTML Example</h1>\u000a\u000a\u0009<p class="mb-0">\u000a\u0009\u0009A paragraph is a <strong>self-contained</strong> unit of a discourse in\u000a\u0009\u0009writing dealing with a particular point or <em>idea</em>. Paragraphs are\u000a\u0009\u0009usually an expected part of formal writing, used to organize longer\u000a\u0009\u0009prose.\u000a\u0009</p>\u000a</div>','','','0','{"com.liferay.fragment.entry.processor.editable.EditableFragmentEntryProcessor":{"element-html":{"config":{},"defaultValue":"\n\t<h1>HTML Example</h1>\n\n\t<p class=\"mb-0\">\n\t\tA paragraph is a <strong>self-contained</strong> unit of a discourse in\n\t\twriting dealing with a particular point or <em>idea</em>. Paragraphs are\n\t\tusually an expected part of formal writing, used to organize longer\n\t\tprose.\n\t</p>\n","mappedField":"CPDefinition_description"}}}','bshn',2,'BASIC_COMPONENT-html',1,'2025-11-06 19:44:25.651000',NULL,'06792e2b-d0a3-8ebe-8445-9e330bec275c')
